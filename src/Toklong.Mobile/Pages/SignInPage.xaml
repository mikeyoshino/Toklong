<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Toklong.Mobile.Pages.SignInPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Toklong.Mobile.Controls"
    BackgroundColor="{StaticResource CleanLedgerRootBackground}"
    SafeAreaEdges="Container"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False">
    <ScrollView SafeAreaEdges="SoftInput">
        <VerticalStackLayout
            MaximumWidthRequest="520"
            Padding="{StaticResource AuthScreenPadding}"
            Spacing="24">
            <Grid ColumnDefinitions="44,*,44">
                <Button
                    Style="{StaticResource AuthBackButton}"
                    Clicked="OnBackClicked"
                    SemanticProperties.Description="กลับไปหน้าเริ่มต้น"
                    Text="‹" />
                <controls:CenteredAuthBrandView
                    Grid.Column="1"
                    HorizontalOptions="Center"
                    MarkSize="58"
                    WordmarkSize="18" />
            </Grid>

            <VerticalStackLayout Spacing="8">
                <Label
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource AuthTitle}"
                    Text="เข้าสู่ระบบด้วยเบอร์มือถือ" />
                <Label
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource RefinedBodyText}"
                    Text="เราจะส่งรหัสยืนยันทาง SMS ให้คุณ"
                    TextColor="{StaticResource InkSoft}" />
            </VerticalStackLayout>

            <Border Style="{StaticResource AuthFormCard}">
                <VerticalStackLayout Spacing="18">
                    <controls:ThaiMobilePhoneField
                        PhoneNumber="{Binding PhoneNumber, Mode=TwoWay}" />

                    <Button
                        Style="{StaticResource LedgerPrimaryButton}"
                        Command="{Binding ContinueCommand}"
                        Text="ส่งรหัสทาง SMS">
                        <Button.Triggers>
                            <DataTrigger
                                TargetType="Button"
                                Binding="{Binding IsBusy}"
                                Value="True">
                                <Setter Property="IsEnabled" Value="False" />
                                <Setter Property="Text" Value="กำลังส่งรหัส..." />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator
                HorizontalOptions="Center"
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                Color="{StaticResource BrandBlue}" />

            <Border
                IsVisible="{Binding HasMessage}"
                Style="{StaticResource RefinedValidationBorder}">
                <Label
                    Style="{StaticResource RefinedValidationText}"
                    Text="{Binding Message}" />
            </Border>

            <Label
                HorizontalTextAlignment="Center"
                Style="{StaticResource RefinedHelperText}"
                Text="ปลอดภัยและสะดวก ไม่ต้องใช้รหัสผ่าน" />

            <HorizontalStackLayout
                HorizontalOptions="Center"
                Spacing="4">
                <Label
                    VerticalOptions="Center"
                    Text="ยังไม่มีบัญชี?"
                    TextColor="{StaticResource Muted}" />
                <Button
                    Style="{StaticResource RefinedInlineButton}"
                    Command="{Binding OpenSignUpCommand}"
                    Text="สมัครสมาชิก" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
