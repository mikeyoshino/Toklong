<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Toklong.Mobile.Pages.SignInPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Toklong.Mobile.Controls"
    SafeAreaEdges="Container"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False">
    <ContentPage.Background>
        <RadialGradientBrush Center="0.84,0.03" Radius="0.98">
            <GradientStop Color="#DCEFFF" Offset="0" />
            <GradientStop Color="#F6FAFF" Offset="0.38" />
            <GradientStop Color="#FFFFFF" Offset="0.9" />
        </RadialGradientBrush>
    </ContentPage.Background>
    <ScrollView SafeAreaEdges="SoftInput">
        <VerticalStackLayout
            MaximumWidthRequest="520"
            Padding="{StaticResource AuthScreenPadding}"
            Spacing="24">
            <Grid ColumnDefinitions="44,*" ColumnSpacing="14">
                <Button
                    Style="{StaticResource AuthBackButton}"
                    Clicked="OnBackClicked"
                    SemanticProperties.Description="กลับไปหน้าเริ่มต้น"
                    Text="‹" />
                <controls:BrandLockupView
                    Grid.Column="1"
                    VerticalOptions="Center" />
            </Grid>

            <VerticalStackLayout Spacing="8">
                <Label
                    Style="{StaticResource AuthTitle}"
                    Text="ยินดีต้อนรับกลับ" />
                <Label
                    Style="{StaticResource RefinedBodyText}"
                    Text="ใช้เบอร์โทรศัพท์ที่สมัครไว้เพื่อดูรายการของคุณ"
                    TextColor="{StaticResource InkSoft}" />
            </VerticalStackLayout>

            <Border Style="{StaticResource AuthFormCard}">
                <VerticalStackLayout Spacing="18">
                    <VerticalStackLayout Style="{StaticResource RefinedFormSection}">
                        <controls:FormLabelView IsRequired="True" Text="เบอร์โทรศัพท์" />
                        <Border Style="{StaticResource RefinedInputBorder}">
                            <controls:ThaiMobilePhoneEntry
                                Style="{StaticResource RefinedEntry}"
                                Placeholder="เช่น 081-234-5678"
                                SemanticProperties.Description="เบอร์โทรศัพท์สำหรับเข้าสู่ระบบ"
                                PhoneNumber="{Binding PhoneNumber}" />
                        </Border>
                        <Label
                            Style="{StaticResource RefinedHelperText}"
                            Text="เราจะส่งรหัสยืนยัน 6 หลักไปยังเบอร์นี้" />
                    </VerticalStackLayout>

                    <Button
                        Style="{StaticResource RefinedPrimaryButton}"
                        Command="{Binding ContinueCommand}"
                        Text="รับรหัสยืนยัน">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsBusy}" Value="True">
                                <Setter Property="IsEnabled" Value="False" />
                                <Setter Property="Text" Value="กำลังส่งรหัส..." />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator
                HorizontalOptions="Center"
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                Color="{StaticResource BrandBlue}" />

            <Border
                IsVisible="{Binding HasMessage}"
                Style="{StaticResource RefinedValidationBorder}">
                <Label
                    Style="{StaticResource RefinedValidationText}"
                    Text="{Binding Message}" />
            </Border>

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                <Label
                    VerticalOptions="Center"
                    Text="ยังไม่มีบัญชี?"
                    TextColor="{StaticResource Muted}" />
                <Button
                    Style="{StaticResource RefinedInlineButton}"
                    Command="{Binding OpenSignUpCommand}"
                    Text="สมัครสมาชิก" />
            </HorizontalStackLayout>

            <Border
                Padding="13"
                BackgroundColor="#F7FAFD"
                Stroke="{StaticResource Line}"
                StrokeShape="RoundRectangle 14">
                <Grid ColumnDefinitions="28,*" ColumnSpacing="9">
                    <Image
                        WidthRequest="24"
                        HeightRequest="24"
                        Source="ui_shield.png" />
                    <Label
                        Grid.Column="1"
                        VerticalOptions="Center"
                        Style="{StaticResource RefinedHelperText}"
                        Text="TOKLONG จะไม่ขอรหัสผ่านธนาคาร รหัสกู้คืน หรือข้อมูลบัตรในขั้นตอนนี้" />
                </Grid>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
