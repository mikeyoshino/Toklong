<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Toklong.Mobile.Pages.VerifyCodePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Toklong.Mobile.Controls"
    BackgroundColor="{StaticResource CleanLedgerRootBackground}"
    SafeAreaEdges="Container"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False">
    <ScrollView SafeAreaEdges="SoftInput">
        <VerticalStackLayout
            MaximumWidthRequest="520"
            Padding="{StaticResource AuthScreenPadding}"
            Spacing="24">
            <Grid ColumnDefinitions="44,*,44">
                <Button
                    Style="{StaticResource AuthBackButton}"
                    Command="{Binding EditPhoneCommand}"
                    SemanticProperties.Description="ย้อนกลับไปแก้เบอร์มือถือ"
                    Text="‹" />
                <controls:CenteredAuthBrandView
                    Grid.Column="1"
                    HorizontalOptions="Center"
                    MarkSize="58"
                    WordmarkSize="18" />
            </Grid>

            <VerticalStackLayout Spacing="8">
                <Label
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource AuthTitle}"
                    Text="กรอกรหัส 6 หลัก" />
                <Label
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource RefinedBodyText}"
                    Text="{Binding MaskedPhoneNumber, StringFormat='ส่งรหัสทาง SMS ไปที่ {0}'}"
                    TextColor="{StaticResource InkSoft}" />
                <Button
                    HorizontalOptions="Center"
                    Style="{StaticResource RefinedInlineButton}"
                    Command="{Binding EditPhoneCommand}"
                    Text="แก้ไขเบอร์" />
            </VerticalStackLayout>

            <controls:OtpVerificationFormView
                x:Name="OtpForm"
                Code="{Binding Code, Mode=TwoWay}"
                ConfirmCommand="{Binding ConfirmCommand}"
                ConfirmText="{Binding ConfirmButtonText}"
                BusyText="กำลังยืนยัน..."
                ConfirmSemanticDescription="ยืนยันรหัสเข้าสู่ระบบ 6 หลัก"
                DevelopmentHint="{Binding DevelopmentHint}"
                HasDevelopmentHint="{Binding HasDevelopmentHint}"
                IsBusy="{Binding IsBusy}" />

            <HorizontalStackLayout
                HorizontalOptions="Center"
                Spacing="4">
                <Label
                    VerticalOptions="Center"
                    Text="ยังไม่ได้รับรหัส?"
                    TextColor="{StaticResource Muted}" />
                <Button
                    Style="{StaticResource RefinedInlineButton}"
                    Command="{Binding ResendCommand}"
                    IsEnabled="{Binding CanResend}"
                    Text="{Binding ResendButtonText}" />
            </HorizontalStackLayout>

            <ActivityIndicator
                HorizontalOptions="Center"
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                Color="{StaticResource BrandBlue}" />

            <Border
                IsVisible="{Binding HasMessage}"
                Style="{StaticResource RefinedValidationBorder}">
                <Label
                    Style="{StaticResource RefinedValidationText}"
                    Text="{Binding Message}" />
            </Border>

            <Label
                HorizontalTextAlignment="Center"
                Style="{StaticResource RefinedHelperText}"
                Text="รหัสใช้ได้ครั้งเดียว อย่าบอกรหัสนี้กับผู้อื่น"
                TextColor="{StaticResource Muted}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
