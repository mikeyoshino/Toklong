<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Toklong.Mobile.Pages.SignUpPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Toklong.Mobile.Controls"
    BackgroundColor="{StaticResource CleanLedgerRootBackground}"
    SafeAreaEdges="Container"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False">
    <ScrollView SafeAreaEdges="SoftInput">
        <VerticalStackLayout
            MaximumWidthRequest="520"
            Padding="{StaticResource AuthScreenPadding}"
            Spacing="24">
            <Grid ColumnDefinitions="44,*,44">
                <Button
                    Style="{StaticResource AuthBackButton}"
                    Clicked="OnBackClicked"
                    SemanticProperties.Description="ย้อนกลับ"
                    Text="‹" />
                <controls:CenteredAuthBrandView
                    Grid.Column="1"
                    HorizontalOptions="Center"
                    MarkSize="58"
                    WordmarkSize="18" />
            </Grid>

            <VerticalStackLayout Spacing="8">
                <Label
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource AuthTitle}"
                    Text="สมัครด้วยเบอร์มือถือ" />
                <Label
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource RefinedBodyText}"
                    Text="ยืนยันเบอร์ก่อน แล้วค่อยตั้งค่าบัญชีในขั้นถัดไป"
                    TextColor="{StaticResource InkSoft}" />
            </VerticalStackLayout>

            <Border Style="{StaticResource AuthFormCard}">
                <VerticalStackLayout Spacing="18">
                    <controls:ThaiMobilePhoneField
                        PhoneNumber="{Binding PhoneNumber, Mode=TwoWay}" />
                    <Button
                        Style="{StaticResource LedgerPrimaryButton}"
                        Command="{Binding ContinueCommand}"
                        Text="ส่งรหัสทาง SMS">
                        <Button.Triggers>
                            <DataTrigger
                                TargetType="Button"
                                Binding="{Binding IsBusy}"
                                Value="True">
                                <Setter Property="IsEnabled" Value="False" />
                                <Setter Property="Text" Value="กำลังส่งรหัส..." />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator
                HorizontalOptions="Center"
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                Color="{StaticResource BrandBlue}" />

            <Border
                IsVisible="{Binding HasMessage}"
                Style="{StaticResource RefinedValidationBorder}">
                <Label
                    Style="{StaticResource RefinedValidationText}"
                    Text="{Binding Message}" />
            </Border>

            <HorizontalStackLayout
                HorizontalOptions="Center"
                Spacing="4">
                <Label
                    VerticalOptions="Center"
                    Text="มีบัญชีอยู่แล้ว?"
                    TextColor="{StaticResource Muted}" />
                <Button
                    Style="{StaticResource RefinedInlineButton}"
                    Clicked="OnOpenSignInClicked"
                    Text="เข้าสู่ระบบ" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
