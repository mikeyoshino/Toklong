<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Toklong.Mobile.Pages.TransactionDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Toklong.Mobile.Controls"
    xmlns:theme="clr-namespace:Toklong.Mobile.Theming"
    Title="{Binding DetailHeadline}"
    SafeAreaEdges="Container"
    Shell.NavBarIsVisible="True"
    Shell.TabBarIsVisible="False">
    <ContentPage.Background>
        <RadialGradientBrush Center="0.9,0.02" Radius="0.98">
            <GradientStop
                Color="{Binding Transaction.RolePageTint, FallbackValue=#DCEFFF, TargetNullValue=#DCEFFF}"
                Offset="0" />
            <GradientStop
                Color="{Binding Transaction.RolePageMiddle, FallbackValue=#F6FAFF, TargetNullValue=#F6FAFF}"
                Offset="0.34" />
            <GradientStop Color="#FFFFFF" Offset="0.84" />
        </RadialGradientBrush>
    </ContentPage.Background>

    <ScrollView SafeAreaEdges="SoftInput">
        <VerticalStackLayout
            MaximumWidthRequest="720"
            HorizontalOptions="Fill"
            Padding="{StaticResource RefinedScreenPadding}"
            Spacing="{StaticResource SpacingLg}">
            <Border
                Padding="18"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 24">
                <Border.Shadow>
                    <Shadow
                        Brush="{Binding Transaction.RoleColor}"
                        Offset="0,10"
                        Opacity="0.18"
                        Radius="24" />
                </Border.Shadow>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop
                            Color="{Binding Transaction.RoleHeaderStart, FallbackValue=#3C8AF1, TargetNullValue=#3C8AF1}"
                            Offset="0" />
                        <GradientStop
                            Color="{Binding Transaction.RoleHeaderMiddle, FallbackValue=#236DCE, TargetNullValue=#236DCE}"
                            Offset="0.64" />
                        <GradientStop
                            Color="{Binding Transaction.RoleHeaderEnd, FallbackValue=#185CB9, TargetNullValue=#185CB9}"
                            Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <HorizontalStackLayout Spacing="8">
                            <BoxView
                                WidthRequest="7"
                                HeightRequest="7"
                                VerticalOptions="Center"
                                Color="{Binding Transaction.RoleDot}"
                                CornerRadius="4" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="12"
                                Text="{Binding Transaction.RoleLabel}"
                                TextColor="#DFFFFFFF" />
                        </HorizontalStackLayout>
                        <Border
                            Grid.Column="1"
                            Padding="9,5"
                            BackgroundColor="#24FFFFFF"
                            Stroke="#30FFFFFF"
                            StrokeShape="RoundRectangle 99">
                            <Label
                                FontAttributes="Bold"
                                FontSize="12"
                                Text="{Binding Transaction.StatusLabel}"
                                TextColor="White" />
                        </Border>
                    </Grid>

                    <Grid ColumnDefinitions="56,*" ColumnSpacing="12">
                        <Border
                            WidthRequest="56"
                            HeightRequest="56"
                            BackgroundColor="#E8FFFFFF"
                            Stroke="#30FFFFFF"
                            StrokeShape="RoundRectangle 17">
                            <Image
                                Margin="8"
                                Source="{Binding Transaction.ProductVisual}" />
                        </Border>
                        <Label
                            Grid.Column="1"
                            VerticalOptions="Center"
                            FontAttributes="Bold"
                            FontSize="21"
                            LineBreakMode="TailTruncation"
                            MaxLines="2"
                            Text="{Binding Transaction.ProductName}"
                            TextColor="White" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="2">
                            <Label
                                FontSize="12"
                                Text="{Binding Transaction.RoleAmountLabel}"
                                TextColor="{Binding Transaction.RoleHeaderSecondary}" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="27"
                                CharacterSpacing="-0.5"
                                Text="{Binding Transaction.RoleAmountText}"
                                TextColor="White" />
                        </VerticalStackLayout>
                        <VerticalStackLayout
                            Grid.Column="1"
                            VerticalOptions="End"
                            HorizontalOptions="End"
                            Spacing="2">
                            <Label
                                HorizontalTextAlignment="End"
                                FontSize="12"
                                Text="{Binding Transaction.CounterpartyLabel}"
                                TextColor="{Binding Transaction.RoleHeaderSecondary}" />
                            <Label
                                HorizontalTextAlignment="End"
                                FontSize="12"
                                Text="{Binding Transaction.DeadlineText}"
                                TextColor="{Binding Transaction.RoleHeaderSecondary}" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border
                IsVisible="{Binding Transaction.ShowShippingProgress}"
                Style="{StaticResource SurfaceCard}"
                Padding="17">
                <VerticalStackLayout Spacing="14">
                    <Label
                        Style="{StaticResource SectionTitle}"
                        FontSize="15"
                        Text="สถานะการจัดส่ง" />
                    <controls:ShippingProgressView
                        AutomationId="ShippingProgress"
                        Transaction="{Binding Transaction}" />
                </VerticalStackLayout>
            </Border>

            <Border
                Style="{StaticResource SurfaceCard}"
                Padding="18">
                <VerticalStackLayout Spacing="11">
                    <Grid
                        AutomationId="SellerAgreementDetailsDisclosure"
                        ColumnDefinitions="36,*,Auto"
                        ColumnSpacing="10">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding ToggleAgreementDetailsCommand}" />
                        </Grid.GestureRecognizers>
                        <Border
                            WidthRequest="36"
                            HeightRequest="36"
                            BackgroundColor="#F1ECFF"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 11">
                            <Image Margin="8" Source="ui_note.png" />
                        </Border>
                        <Label
                            Grid.Column="1"
                            VerticalOptions="Center"
                            Style="{StaticResource SectionTitle}"
                            FontSize="17"
                            Text="รายละเอียดสินค้า" />
                        <Label
                            Grid.Column="2"
                            IsVisible="{Binding IsSellerDetail}"
                            MinimumWidthRequest="28"
                            VerticalOptions="Center"
                            HorizontalTextAlignment="Center"
                            FontAttributes="Bold"
                            FontSize="17"
                            Text="{Binding AgreementDetailsChevron}"
                            TextColor="{StaticResource BrandBlueDeep}" />
                    </Grid>
                    <VerticalStackLayout
                        IsVisible="{Binding ShowAgreementDetailsContent}"
                        Spacing="11">
                        <VerticalStackLayout
                            IsVisible="{Binding Transaction.HasAdditionalAgreementDetails}"
                            Spacing="3">
                            <Label
                                FontSize="12"
                                Text="รายละเอียด"
                                TextColor="{StaticResource Muted}" />
                            <Label
                                FontSize="14"
                                LineHeight="1.4"
                                Text="{Binding Transaction.DisplayAgreementDetails}"
                                TextColor="{StaticResource InkSoft}" />
                        </VerticalStackLayout>
                        <Grid ColumnDefinitions="*,*">
                            <Label
                                FontSize="13"
                                Text="สภาพสินค้า"
                                TextColor="{StaticResource Muted}" />
                            <Label
                                Grid.Column="1"
                                FontAttributes="Bold"
                                FontSize="13"
                                HorizontalOptions="Fill"
                                HorizontalTextAlignment="End"
                                Text="{Binding Transaction.ConditionLabel}"
                                TextColor="{StaticResource Ink}" />
                        </Grid>
                        <VerticalStackLayout
                            IsVisible="{Binding Transaction.HasKnownDefects}"
                            Spacing="3">
                            <Label
                                FontSize="12"
                                Text="ตำหนิที่แจ้งไว้"
                                TextColor="{StaticResource Muted}" />
                            <Label
                                FontSize="13"
                                LineHeight="1.35"
                                Text="{Binding Transaction.KnownDefects}"
                                TextColor="{StaticResource InkSoft}" />
                        </VerticalStackLayout>
                        <Grid ColumnDefinitions="*,*">
                            <Label
                                FontSize="13"
                                Text="วิธีส่งมอบ"
                                TextColor="{StaticResource Muted}" />
                            <Label
                                Grid.Column="1"
                                FontAttributes="Bold"
                                FontSize="13"
                                HorizontalOptions="Fill"
                                HorizontalTextAlignment="End"
                                Text="{Binding Transaction.FulfillmentConsumerLabel}"
                                TextColor="{StaticResource Ink}" />
                        </Grid>
                        <VerticalStackLayout
                            IsVisible="{Binding Transaction.HasDeliveryAddress}"
                            Spacing="3">
                            <Label
                                FontSize="13"
                                Text="ที่อยู่จัดส่ง"
                                TextColor="{StaticResource Muted}" />
                            <Label
                                FontAttributes="Bold"
                                FontSize="13"
                                LineBreakMode="WordWrap"
                                Text="{Binding Transaction.DeliveryAddressText}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout
                            AutomationId="SellerPayoutDisclosure"
                            IsVisible="{Binding Transaction.IsSellerRole}"
                            Spacing="7">
                            <BoxView HeightRequest="1" Color="{StaticResource Line}" />
                            <Grid ColumnDefinitions="*,*">
                                <Label
                                    FontSize="13"
                                    Text="ราคาสินค้า"
                                    TextColor="{StaticResource Muted}" />
                                <Label
                                    Grid.Column="1"
                                    FontSize="13"
                                    HorizontalOptions="Fill"
                                    HorizontalTextAlignment="End"
                                    Text="{Binding Transaction.ItemPriceText}"
                                    TextColor="{StaticResource Ink}" />
                            </Grid>
                            <Grid
                                IsVisible="{Binding Transaction.HasShippingFee}"
                                ColumnDefinitions="*,*">
                                <Label
                                    FontSize="13"
                                    Text="ขนส่ง"
                                    TextColor="{StaticResource Muted}" />
                                <Label
                                    Grid.Column="1"
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    HorizontalOptions="Fill"
                                    HorizontalTextAlignment="End"
                                    Text="{Binding Transaction.ShippingServiceText}"
                                    TextColor="{StaticResource Ink}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,*">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="14"
                                    Text="ยอดที่คุณจะได้รับ"
                                    TextColor="{StaticResource Ink}" />
                                <Label
                                    Grid.Column="1"
                                    FontAttributes="Bold"
                                    FontSize="14"
                                    HorizontalOptions="Fill"
                                    HorizontalTextAlignment="End"
                                    Text="{Binding Transaction.SellerNetText}"
                                    TextColor="{StaticResource Success}" />
                            </Grid>
                        </VerticalStackLayout>
                        <VerticalStackLayout
                            AutomationId="BuyerCostDisclosure"
                            IsVisible="{Binding Transaction.IsBuyerRole}"
                            Spacing="7">
                            <BoxView HeightRequest="1" Color="{StaticResource Line}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Label
                                    FontSize="13"
                                    Text="ราคาสินค้า"
                                    TextColor="{StaticResource Muted}" />
                                <Label
                                    Grid.Column="1"
                                    FontSize="13"
                                    Text="{Binding Transaction.ItemPriceText}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label
                                    FontSize="13"
                                    Text="ค่าคุ้มครองผู้ซื้อ"
                                    TextColor="{StaticResource Muted}" />
                                <Label
                                    Grid.Column="1"
                                    FontSize="13"
                                    Text="{Binding Transaction.FeeText}" />
                            </Grid>
                            <Grid
                                IsVisible="{Binding Transaction.HasShippingFee}"
                                ColumnDefinitions="*,Auto">
                                <Label
                                    FontSize="13"
                                    Text="ค่าจัดส่ง"
                                    TextColor="{StaticResource Muted}" />
                                <Label
                                    Grid.Column="1"
                                    FontSize="13"
                                    Text="{Binding Transaction.ShippingFeeText}" />
                            </Grid>
                            <Grid
                                IsVisible="{Binding Transaction.HasParcelInsurance}"
                                ColumnDefinitions="*,Auto">
                                <Label
                                    FontSize="13"
                                    Text="ประกันพัสดุ"
                                    TextColor="{StaticResource Muted}" />
                                <Label
                                    Grid.Column="1"
                                    FontSize="13"
                                    Text="{Binding Transaction.ParcelInsuranceFeeText}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="14"
                                    Text="ยอดชำระทั้งหมด" />
                                <Label
                                    Grid.Column="1"
                                    FontAttributes="Bold"
                                    FontSize="14"
                                    Text="{Binding Transaction.FormattedAmount}"
                                    TextColor="{StaticResource BrandBlueDeep}" />
                            </Grid>
                            <Grid
                                IsVisible="{Binding Transaction.HasShippingFee}"
                                ColumnDefinitions="*,Auto">
                                <Label
                                    FontSize="13"
                                    Text="ขนส่ง"
                                    TextColor="{StaticResource Muted}" />
                                <Label
                                    Grid.Column="1"
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    Text="{Binding Transaction.ShippingServiceText}" />
                            </Grid>
                            <BoxView HeightRequest="1" Color="{StaticResource Line}" />
                            <VerticalStackLayout
                                AutomationId="BuyerPaymentControls"
                                IsVisible="{Binding IsPaymentAction}"
                                Spacing="{StaticResource SpacingSm}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                    <CheckBox
                                        VerticalOptions="Start"
                                        MinimumWidthRequest="{StaticResource CompactControlMinimumHeight}"
                                        MinimumHeightRequest="{StaticResource CompactControlMinimumHeight}"
                                        Color="{StaticResource BrandBlue}"
                                        IsChecked="{Binding AcceptedTerms}"
                                        SemanticProperties.Description="ยืนยันว่าได้ตรวจรายละเอียดและเงื่อนไขแล้ว" />
                                    <Label
                                        Grid.Column="1"
                                        VerticalOptions="Center"
                                        FontSize="13"
                                        LineBreakMode="WordWrap"
                                        Text="ฉันตรวจสินค้า ราคา กำหนดส่ง และเวลาแจ้งปัญหาแล้ว" />
                                </Grid>
                                <Button
                                    Style="{StaticResource RefinedPrimaryButton}"
                                    BackgroundColor="{Binding Transaction.RoleColor}"
                                    Command="{Binding PrimaryActionCommand}"
                                    SemanticProperties.Description="{Binding Transaction.FormattedAmount, StringFormat='เปิดหน้าจ่ายเงินยอด {0}'}"
                                    Text="{Binding Transaction.FormattedAmount, StringFormat='ชำระ {0}'}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border
                AutomationId="SellerInvitationCard"
                IsVisible="{Binding ShowSellerInvitation}"
                Style="{StaticResource SurfaceCard}"
                Padding="18">
                <VerticalStackLayout Spacing="12">
                    <Grid
                        ColumnDefinitions="40,*"
                        ColumnSpacing="11">
                        <Border
                            WidthRequest="40"
                            HeightRequest="40"
                            BackgroundColor="#EAF4FF"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 13">
                            <Image Margin="9" Source="ui_offer.png" />
                        </Border>
                        <Label
                            Grid.Column="1"
                            VerticalOptions="Center"
                            Style="{StaticResource SectionTitle}"
                            FontSize="18"
                            Text="แชร์ข้อเสนอ" />
                    </Grid>

                    <Label
                        Style="{StaticResource RefinedHelperText}"
                        Text="ระบบแจ้งผู้ขายจากเบอร์แล้ว คุณส่งลิงก์นี้ซ้ำได้" />

                    <Border
                        Padding="12,10"
                        BackgroundColor="{StaticResource SurfaceBlue}"
                        Stroke="#CFE5FF"
                        StrokeShape="RoundRectangle 12">
                        <Label
                            FontSize="12"
                            LineBreakMode="TailTruncation"
                            MaxLines="2"
                            Text="{Binding SellerInvitationUrl}"
                            TextColor="{StaticResource BrandBlueDeep}" />
                    </Border>

                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="9">
                        <Button
                            AutomationId="CopySellerInvitationLinkButton"
                            Style="{StaticResource RefinedSecondaryActionButton}"
                            Command="{Binding CopyInvitationLinkCommand}"
                            SemanticProperties.Description="คัดลอกลิงก์ข้อเสนอ"
                            Text="คัดลอกลิงก์" />
                        <Button
                            AutomationId="ShareSellerInvitationLinkButton"
                            Grid.Column="1"
                            Style="{StaticResource RefinedPrimaryButton}"
                            BackgroundColor="{Binding Transaction.RoleColor}"
                            Command="{Binding ShareInvitationLinkCommand}"
                            SemanticProperties.Description="แชร์ข้อเสนอให้ผู้ขาย"
                            Text="แชร์ให้ผู้ขาย" />
                    </Grid>

                    <Label
                        IsVisible="{Binding HasInvitationFeedback}"
                        Style="{StaticResource RefinedHelperText}"
                        Text="{Binding InvitationFeedback}"
                        TextColor="{StaticResource Success}" />
                </VerticalStackLayout>
            </Border>

            <Border
                IsVisible="{Binding IsFulfillmentAction}"
                Padding="14"
                BackgroundColor="{StaticResource SuccessSoft}"
                Stroke="#C5EFE5"
                StrokeShape="RoundRectangle 16">
                <Grid ColumnDefinitions="38,*" ColumnSpacing="10">
                    <Border
                        WidthRequest="38"
                        HeightRequest="38"
                        VerticalOptions="Start"
                        BackgroundColor="White"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12">
                        <Image Margin="8" Source="{Binding Transaction.FulfillmentIcon}" />
                    </Border>
                    <Label
                        Grid.Column="1"
                        VerticalOptions="Center"
                        FontSize="13"
                        LineHeight="1.35"
                        Text="ผู้ซื้อจ่ายแล้ว เพิ่มข้อมูลการส่งของได้เลย"
                        TextColor="{StaticResource Success}" />
                </Grid>
            </Border>

            <Border
                IsVisible="{Binding IsStatusOnly}"
                Padding="14"
                BackgroundColor="{Binding Transaction.StatusGuidanceBackground}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="38,*" ColumnSpacing="10">
                        <Border
                            WidthRequest="38"
                            HeightRequest="38"
                            VerticalOptions="Start"
                            BackgroundColor="White"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12">
                            <Image Margin="8" Source="{Binding Transaction.StatusGuidanceIcon}" />
                        </Border>
                        <Label
                            Grid.Column="1"
                            VerticalOptions="Center"
                            FontSize="13"
                            LineHeight="1.35"
                            Text="{Binding Transaction.StatusGuidance}"
                            TextColor="{Binding Transaction.StatusGuidanceColor}" />
                    </Grid>
                    <VerticalStackLayout
                        IsVisible="{Binding CanDownloadShippingLabel}"
                        Spacing="12">
                        <BoxView
                            HeightRequest="1"
                            Color="#26000000" />
                        <Grid
                            ColumnDefinitions="*,*"
                            ColumnSpacing="12">
                            <VerticalStackLayout Spacing="2">
                                <Label
                                    FontSize="12"
                                    Text="ขนส่ง"
                                    TextColor="{StaticResource Muted}" />
                                <Label
                                    FontSize="15"
                                    Text="{Binding Transaction.ShippingServiceText}"
                                    TextColor="{StaticResource Ink}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout
                                Grid.Column="1"
                                Spacing="2">
                                <Label
                                    FontSize="12"
                                    Text="เลขพัสดุ"
                                    TextColor="{StaticResource Muted}" />
                                <Label
                                    FontSize="15"
                                    LineBreakMode="TailTruncation"
                                    Text="{Binding Transaction.TrackingNumberText}"
                                    TextColor="{StaticResource Ink}" />
                            </VerticalStackLayout>
                        </Grid>
                        <Border
                            AutomationId="ManagedShippingLabelCard"
                            Padding="14"
                            BackgroundColor="{x:Static theme:SellerColorPaletteColors.Surface}"
                            Stroke="{x:Static theme:SellerColorPaletteColors.BorderBrush}"
                            StrokeShape="RoundRectangle 14">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding OpenShippingLabelCommand}" />
                            </Border.GestureRecognizers>
                            <Grid
                                ColumnDefinitions="42,*,Auto"
                                ColumnSpacing="11">
                                <Border
                                    WidthRequest="42"
                                    HeightRequest="42"
                                    BackgroundColor="{x:Static theme:SellerColorPaletteColors.Secondary}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12">
                                    <Image
                                        Margin="8"
                                        Source="ui_shipping_label.png" />
                                </Border>
                                <VerticalStackLayout
                                    Grid.Column="1"
                                    VerticalOptions="Center"
                                    Spacing="2">
                                    <Label
                                        FontSize="16"
                                        Text="ใบปะหน้า 4 × 6 นิ้ว" />
                                    <Label
                                        Style="{StaticResource RefinedHelperText}"
                                        Text="ตรวจชื่อและที่อยู่ก่อนพิมพ์" />
                                </VerticalStackLayout>
                                <Label
                                    Grid.Column="2"
                                    VerticalOptions="Center"
                                    FontSize="22"
                                    Text="›"
                                    TextColor="{x:Static theme:SellerColorPaletteColors.Role}" />
                            </Grid>
                        </Border>
                        <Button
                            AutomationId="OpenFullShippingLabelButton"
                            Style="{StaticResource RefinedInlineButton}"
                            Command="{Binding OpenShippingLabelCommand}"
                            Text="แตะเพื่อดูใบปะหน้าเต็มจอ"
                            TextColor="{x:Static theme:SellerColorPaletteColors.Role}" />
                    </VerticalStackLayout>
                    <Label
                        IsVisible="{Binding Transaction.HasTrackingNumber}"
                        FontSize="14"
                        Text="{Binding Transaction.TrackingNumberText, StringFormat='เลขพัสดุ {0}'}"
                        TextColor="{Binding Transaction.StatusGuidanceColor}">
                        <Label.Triggers>
                            <DataTrigger
                                Binding="{Binding CanDownloadShippingLabel}"
                                TargetType="Label"
                                Value="True">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </VerticalStackLayout>
            </Border>

            <Border
                IsVisible="{Binding CanDownloadReturnShippingLabel}"
                Style="{StaticResource SurfaceCard}"
                Padding="18">
                <VerticalStackLayout Spacing="12">
                    <Label
                        Style="{StaticResource SectionTitle}"
                        FontSize="18"
                        Text="ส่งสินค้าคืน" />
                    <Label
                        Style="{StaticResource MutedText}"
                        Text="ดาวน์โหลดใบปะหน้า ตรวจชื่อและที่อยู่ แล้วนำพัสดุไปส่งตามบริการที่ระบุ" />
                    <Button
                        AutomationId="OpenReturnShippingLabelButton"
                        Style="{StaticResource RefinedPrimaryButton}"
                        Command="{Binding OpenReturnShippingLabelCommand}"
                        Text="ดูใบปะหน้าส่งคืน" />
                </VerticalStackLayout>
            </Border>

            <Border
                IsVisible="{Binding IsPhysicalFulfillmentAction}"
                Style="{StaticResource SurfaceCard}"
                Padding="18">
                <VerticalStackLayout Spacing="12">
                    <Label
                        Style="{StaticResource SectionTitle}"
                        FontSize="18"
                        Text="เพิ่มเลขพัสดุ" />
                    <Label
                        Style="{StaticResource MutedText}"
                        Text="กรอกหลังส่งสินค้าแล้ว เราจะตรวจรูปแบบก่อนรอข้อมูลจริงจากบริษัทขนส่ง" />
                    <VerticalStackLayout Style="{StaticResource RefinedFormSection}">
                        <controls:FormLabelView
                            IsRequired="True"
                            Text="บริษัทขนส่ง" />
                        <Border Style="{StaticResource RefinedInputBorder}">
                            <Picker
                                Style="{StaticResource RefinedPicker}"
                                ItemsSource="{Binding Carriers}"
                                SelectedItem="{Binding SelectedCarrier}"
                                ItemDisplayBinding="{Binding DisplayName}"
                                SemanticProperties.Description="เลือกบริษัทขนส่ง"
                                Title="เลือกบริษัทขนส่ง" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Style="{StaticResource RefinedFormSection}">
                        <controls:FormLabelView
                            IsRequired="True"
                            Text="หมายเลขพัสดุ" />
                        <Border Style="{StaticResource RefinedInputBorder}">
                            <Entry
                                Style="{StaticResource RefinedEntry}"
                                Text="{Binding TrackingNumber}"
                                IsTextPredictionEnabled="False"
                                IsSpellCheckEnabled="False"
                                SemanticProperties.Description="หมายเลขติดตามพัสดุ"
                                Placeholder="{Binding TrackingPlaceholder}" />
                        </Border>
                        <Label
                            IsVisible="{Binding HasTrackingHint}"
                            Style="{StaticResource RefinedHelperText}"
                            Text="{Binding TrackingHint}" />
                        <Label
                            IsVisible="{Binding HasTrackingValidationMessage}"
                            Style="{StaticResource RefinedValidationText}"
                            Text="{Binding TrackingValidationMessage}" />
                    </VerticalStackLayout>
                    <Button
                        Style="{StaticResource RefinedPrimaryButton}"
                        BackgroundColor="{Binding Transaction.RoleColor}"
                        Command="{Binding PrimaryActionCommand}"
                        IsEnabled="{Binding CanSubmitTracking}"
                        Text="บันทึกเลขพัสดุ" />
                </VerticalStackLayout>
            </Border>

            <Border
                IsVisible="{Binding IsDigitalFulfillmentAction}"
                Style="{StaticResource SurfaceCard}"
                Padding="18">
                <VerticalStackLayout Spacing="12">
                    <Label
                        Style="{StaticResource SectionTitle}"
                        FontSize="18"
                        Text="แจ้งว่าส่งของดิจิทัลแล้ว" />
                    <Label
                        Style="{StaticResource MutedText}"
                        Text="บอกเฉพาะช่องทางและเวลาที่ส่ง ห้ามใส่รหัสผ่าน รหัสกู้คืน private key หรือข้อมูลลับ" />
                    <Border Style="{StaticResource RefinedEditorBorder}">
                        <Editor
                            Style="{StaticResource RefinedEditor}"
                            AutoSize="TextChanges"
                            SemanticProperties.Description="รายละเอียดช่องทางและเวลาที่ส่งสินค้าดิจิทัล ห้ามใส่ข้อมูลลับ"
                            Text="{Binding DigitalHandoffStatement}"
                            Placeholder="เช่น ส่งไฟล์ให้ทางแชตที่ตกลงกันแล้ว เวลา 14:20 น." />
                    </Border>
                    <Button
                        Style="{StaticResource RefinedPrimaryButton}"
                        BackgroundColor="{Binding Transaction.RoleColor}"
                        Command="{Binding PrimaryActionCommand}"
                        Text="บันทึกการส่งมอบ" />
                </VerticalStackLayout>
            </Border>

            <Border
                AutomationId="BuyerReceiptConfirmationCard"
                IsVisible="{Binding IsBuyerConfirmationAction}"
                Style="{StaticResource SurfaceCard}"
                Padding="20">
                <VerticalStackLayout Spacing="14">
                    <Border
                        WidthRequest="44"
                        HeightRequest="44"
                        HorizontalOptions="Start"
                        BackgroundColor="{StaticResource SurfaceBlue}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 14">
                        <Image
                            WidthRequest="28"
                            HeightRequest="28"
                            Source="ui_receipt_check.png"
                            SemanticProperties.Description="ตรวจรายการที่ได้รับ" />
                    </Border>
                    <Label
                        Style="{StaticResource SectionTitle}"
                        FontSize="20"
                        Text="{Binding BuyerConfirmation.Heading}" />
                    <Label
                        Style="{StaticResource MutedText}"
                        FontSize="14"
                        LineHeight="1.35"
                        Text="{Binding BuyerConfirmation.SupportingText}" />
                    <Border
                        AutomationId="BuyerReceiptDeadline"
                        IsVisible="{Binding BuyerConfirmation.HasDeadline}"
                        Padding="12,10"
                        BackgroundColor="{StaticResource SurfaceBlue}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 13"
                        SemanticProperties.Description="{Binding BuyerConfirmation.DeadlineText}">
                        <Grid ColumnDefinitions="20,*" ColumnSpacing="9">
                            <Image
                                WidthRequest="18"
                                HeightRequest="18"
                                VerticalOptions="Start"
                                Source="ui_clock.png"
                                AutomationProperties.IsInAccessibleTree="False" />
                            <Label
                                Grid.Column="1"
                                FontSize="13"
                                LineHeight="1.3"
                                Text="{Binding BuyerConfirmation.DeadlineText}"
                                TextColor="#365778" />
                        </Grid>
                    </Border>
                    <Button
                        MinimumHeightRequest="48"
                        Style="{StaticResource RefinedPrimaryButton}"
                        BackgroundColor="{Binding Transaction.RoleColor}"
                        Command="{Binding ConfirmReceiptCommand}"
                        SemanticProperties.Description="{Binding BuyerConfirmation.PrimaryActionText}"
                        Text="{Binding BuyerConfirmation.PrimaryActionText}" />
                    <Button
                        AutomationId="ToggleProblemFormButton"
                        MinimumHeightRequest="44"
                        HorizontalOptions="Fill"
                        Style="{StaticResource RefinedInlineButton}"
                        Command="{Binding ToggleProblemFormCommand}"
                        SemanticProperties.Description="{Binding ProblemFormToggleText}"
                        Text="{Binding ProblemFormToggleText}"
                        TextColor="{StaticResource Muted}" />
                    <VerticalStackLayout
                        AutomationId="ProblemReportForm"
                        IsVisible="{Binding IsProblemFormExpanded}"
                        Spacing="12">
                        <BoxView
                            HeightRequest="1"
                            Color="{StaticResource Line}" />
                        <Label
                            Style="{StaticResource RefinedFormLabel}"
                            Text="แจ้งปัญหา" />
                        <Label
                            Style="{StaticResource RefinedHelperText}"
                            Text="เลือกประเภทและอธิบายสิ่งที่พบ ทีมงานจะหยุดขั้นตอนจ่ายเงินไว้ระหว่างตรวจสอบ" />
                        <Border Style="{StaticResource RefinedInputBorder}">
                            <Picker
                                Style="{StaticResource RefinedPicker}"
                                ItemDisplayBinding="{Binding Label}"
                                ItemsSource="{Binding DisputeReasons}"
                                SemanticProperties.Description="เลือกประเภทปัญหาที่พบ"
                                SelectedItem="{Binding SelectedDisputeReason}"
                                Title="เลือกปัญหาที่พบ" />
                        </Border>
                        <Border Style="{StaticResource RefinedEditorBorder}">
                            <Editor
                                Style="{StaticResource RefinedEditor}"
                                AutoSize="TextChanges"
                                SemanticProperties.Description="อธิบายปัญหาที่พบโดยไม่ใส่ข้อมูลลับ"
                                Text="{Binding DisputeStatement}"
                                Placeholder="อธิบายว่าเกิดอะไรขึ้น โดยไม่ใส่รหัสผ่านหรือข้อมูลลับ" />
                        </Border>
                        <Button
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding ReportProblemCommand}"
                            Text="ส่งเรื่องให้ทีมตรวจสอบ"
                            TextColor="{StaticResource Danger}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border
                IsVisible="{Binding CanManageDisputeEvidence}"
                Style="{StaticResource SurfaceCard}"
                Padding="18">
                <VerticalStackLayout Spacing="12">
                    <Label
                        Style="{StaticResource SectionTitle}"
                        FontSize="18"
                        Text="เพิ่มรูปหลักฐาน" />
                    <Label
                        Style="{StaticResource MutedText}"
                        Text="ส่งได้ฝ่ายละไม่เกิน 10 รูป รูปจะถูกลบ metadata แปลงเป็น JPEG และเข้ารหัสก่อนจัดเก็บ" />
                    <Label
                        Style="{StaticResource MutedText}"
                        Text="ปิดข้อมูลส่วนตัวที่ไม่จำเป็น และห้ามส่งรหัสผ่าน รหัสกู้คืน private key หรือ seed phrase" />
                    <Border Style="{StaticResource RefinedInputBorder}">
                        <Picker
                            Style="{StaticResource RefinedPicker}"
                            ItemDisplayBinding="{Binding Label}"
                            ItemsSource="{Binding EvidenceTypes}"
                            SelectedItem="{Binding SelectedEvidenceType}"
                            SemanticProperties.Description="เลือกประเภทของรูปหลักฐาน"
                            Title="ประเภทหลักฐาน" />
                    </Border>
                    <Border Style="{StaticResource RefinedEditorBorder}">
                        <Editor
                            Style="{StaticResource RefinedEditor}"
                            AutoSize="TextChanges"
                            MaxLength="1000"
                            SemanticProperties.Description="อธิบายว่ารูปหลักฐานแสดงอะไร โดยไม่ใส่ข้อมูลลับ"
                            Text="{Binding EvidenceDescription}"
                            Placeholder="เช่น ภาพรอยแตกด้านซ้ายและกล่องด้านที่บุบ" />
                    </Border>
                    <Button
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding AddDisputeEvidenceCommand}"
                        Text="เลือกรูปและส่งหลักฐาน" />
                    <VerticalStackLayout
                        BindableLayout.ItemsSource="{Binding DisputeEvidence}"
                        IsVisible="{Binding HasDisputeEvidence}"
                        Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Padding="12"
                                    BackgroundColor="{StaticResource SurfaceBlue}"
                                    Stroke="#CFE5FF"
                                    StrokeShape="RoundRectangle 12">
                                    <VerticalStackLayout Spacing="3">
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="13"
                                            Text="{Binding EvidenceTypeLabel}" />
                                        <Label
                                            FontSize="13"
                                            Text="{Binding Description}" />
                                        <Label
                                            Style="{StaticResource MutedText}"
                                            FontSize="11"
                                            Text="{Binding SubmittedAt, StringFormat='ส่งเมื่อ {0:dd/MM/yyyy HH:mm}'}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border
                IsVisible="{Binding HasMessage}"
                Padding="14"
                BackgroundColor="{StaticResource SurfaceBlue}"
                Stroke="#CFE5FF"
                StrokeShape="RoundRectangle 14">
                <Label FontSize="13" Text="{Binding Message}" TextColor="{StaticResource BrandBlueDeep}" />
            </Border>

            <Border
                Style="{StaticResource SurfaceCard}"
                Padding="17">
                <VerticalStackLayout Spacing="14">
                    <Label Style="{StaticResource SectionTitle}" FontSize="15" Text="สถานะการซื้อขาย" />
                    <controls:TransactionProgressView
                        AutomationId="TransactionProgress"
                        Transaction="{Binding Transaction}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
