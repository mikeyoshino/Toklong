<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Toklong.Mobile.Pages.AuthenticatedHomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Toklong.Mobile.Controls"
    xmlns:core="clr-namespace:Toklong.Mobile.Core"
    SafeAreaEdges="Container"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False">
    <ContentPage.Background>
        <RadialGradientBrush Center="0.5,0.03" Radius="0.95">
            <GradientStop Color="#DCEFFF" Offset="0" />
            <GradientStop Color="#F7FBFF" Offset="0.42" />
            <GradientStop Color="#FFFFFF" Offset="1" />
        </RadialGradientBrush>
    </ContentPage.Background>

    <ScrollView>
        <VerticalStackLayout
            MaximumWidthRequest="520"
            Padding="24,52,24,32"
            Spacing="24">
            <controls:CenteredAuthBrandView
                HorizontalOptions="Center" />

            <VerticalStackLayout Spacing="6">
                <Label
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource AuthTitle}"
                    Text="เริ่มดีลอย่างมั่นใจ" />
                <Label
                    HorizontalTextAlignment="Center"
                    LineHeight="1.4"
                    Style="{StaticResource RefinedBodyText}"
                    Text="สร้างข้อเสนอซื้อ หรือจัดการรายการขาย"
                    TextColor="{StaticResource InkSoft}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="14">
                <Border
                    AutomationId="BuyerHomeCard"
                    BackgroundColor="{StaticResource BrandBlue}"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 20">
                    <Grid MinimumHeightRequest="112">
                        <VerticalStackLayout
                            Padding="20"
                            Spacing="6"
                            InputTransparent="True"
                            AutomationProperties.IsInAccessibleTree="False">
                            <Label
                                FontAttributes="Bold"
                                FontSize="25"
                                Text="ซื้อ"
                                TextColor="White" />
                            <Label
                                LineHeight="1.35"
                                Style="{StaticResource RefinedBodyText}"
                                Text="สร้างข้อเสนอ ตรวจรายละเอียด และติดตามรายการ"
                                TextColor="White" />
                        </VerticalStackLayout>
                        <Button
                            AutomationId="OpenBuyingHomeButton"
                            BackgroundColor="Transparent"
                            Clicked="OnBuyingClicked"
                            CornerRadius="20"
                            SemanticProperties.Description="ซื้อ สร้างข้อเสนอ ตรวจรายละเอียด และติดตามรายการ"
                            Text="">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup Name="CommonStates">
                                    <VisualState Name="Normal" />
                                    <VisualState Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter
                                                Property="BackgroundColor"
                                                Value="#22FFFFFF" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Button>
                    </Grid>
                </Border>

                <Border
                    AutomationId="SellerHomeCard"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 20">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop
                                Color="{x:Static core:SellerColorPalette.HeaderStart}"
                                Offset="0" />
                            <GradientStop
                                Color="{x:Static core:SellerColorPalette.HeaderMiddle}"
                                Offset="0.58" />
                            <GradientStop
                                Color="{x:Static core:SellerColorPalette.HeaderEnd}"
                                Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid MinimumHeightRequest="112">
                        <Grid
                            ColumnDefinitions="*,Auto"
                            Padding="20"
                            RowDefinitions="Auto,Auto,Auto"
                            RowSpacing="6"
                            AutomationProperties.IsInAccessibleTree="False"
                            InputTransparent="True">
                            <Label
                                FontAttributes="Bold"
                                FontSize="25"
                                Text="ขาย"
                                TextColor="White" />
                            <Border
                                Grid.Column="1"
                                AutomationId="SellerNewOfferBadge"
                                BackgroundColor="{x:Static core:SellerColorPalette.BadgeSurface}"
                                IsVisible="{Binding HasNewOffers}"
                                Margin="12,0,0,0"
                                Padding="10,4"
                                Stroke="Transparent"
                                StrokeShape="RoundRectangle 12">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    Text="{Binding NewOfferBadgeText}"
                                    TextColor="{x:Static core:SellerColorPalette.Role}" />
                            </Border>
                            <Label
                                Grid.Row="1"
                                Grid.ColumnSpan="2"
                                LineHeight="1.35"
                                Style="{StaticResource RefinedBodyText}"
                                Text="ตรวจข้อเสนอ ส่งสินค้า และติดตามยอดรับ"
                                TextColor="White" />
                            <Grid
                                Grid.Row="2"
                                Grid.ColumnSpan="2"
                                AutomationId="SellerActionableLine"
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="8"
                                IsVisible="{Binding HasActionableSellerWork}"
                                VerticalOptions="Center">
                                <BoxView
                                    BackgroundColor="{x:Static core:SellerColorPalette.Accent}"
                                    CornerRadius="4"
                                    HeightRequest="8"
                                    VerticalOptions="Center"
                                    WidthRequest="8" />
                                <Label
                                    Grid.Column="1"
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    HorizontalOptions="Fill"
                                    LineBreakMode="WordWrap"
                                    Text="{Binding ActionableSellerWorkText}"
                                    TextColor="White"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Grid>
                        <Button
                            AutomationId="OpenSellingHomeButton"
                            BackgroundColor="Transparent"
                            Clicked="OnSellingClicked"
                            CornerRadius="20"
                            SemanticProperties.Description="{Binding SellerCardSemanticText}"
                            Text="">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup Name="CommonStates">
                                    <VisualState Name="Normal" />
                                    <VisualState Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter
                                                Property="BackgroundColor"
                                                Value="#22FFFFFF" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Button>
                    </Grid>
                </Border>

                <Grid
                    AutomationId="SellerSummaryLoadErrorRow"
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="8"
                    IsVisible="{Binding HasLoadError}">
                    <Label
                        AutomationId="SellerSummaryLoadError"
                        LineBreakMode="WordWrap"
                        Style="{StaticResource RefinedValidationText}"
                        Text="{Binding LoadErrorText}"
                        VerticalOptions="Center" />
                    <Button
                        Grid.Column="1"
                        AutomationId="RetrySellerSummaryButton"
                        Command="{Binding RetryCommand}"
                        SemanticProperties.Description="ลองโหลดจำนวนรายการขายอีกครั้ง"
                        Style="{StaticResource RefinedInlineButton}"
                        Text="ลองอีกครั้ง" />
                </Grid>
            </VerticalStackLayout>

            <Button
                AutomationId="OpenAllTransactionsButton"
                Clicked="OnTransactionsClicked"
                Style="{StaticResource RefinedInlineButton}"
                Text="รายการของฉัน" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
