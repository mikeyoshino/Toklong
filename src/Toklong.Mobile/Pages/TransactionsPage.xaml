<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Toklong.Mobile.Pages.TransactionsPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:core="clr-namespace:Toklong.Mobile.Core"
    SafeAreaEdges="Container"
    Shell.NavBarIsVisible="False">
    <ContentPage.Background>
        <RadialGradientBrush Center="0.86,0.02" Radius="0.94">
            <GradientStop Color="#DCEFFF" Offset="0.0" />
            <GradientStop Color="#F6FAFF" Offset="0.34" />
            <GradientStop Color="#FFFFFF" Offset="0.82" />
        </RadialGradientBrush>
    </ContentPage.Background>

    <Grid>
        <RefreshView
            MaximumWidthRequest="720"
            HorizontalOptions="Fill"
            Command="{Binding RefreshCommand}"
            IsRefreshing="{Binding IsRefreshing, Mode=TwoWay}">
            <CollectionView
                ItemsUpdatingScrollMode="KeepScrollOffset"
                ItemsSource="{Binding Transactions}"
                SelectionMode="None">
                <CollectionView.Header>
                    <VerticalStackLayout Padding="20,18,20,12" Spacing="15">
                        <VerticalStackLayout Spacing="8">
                            <Label
                                AutomationId="TransactionsPageTitle"
                                FontAttributes="Bold"
                                FontSize="29"
                                LineHeight="1.02"
                                Text="รายการของคุณ" />
                            <Label
                                FontSize="13"
                                LineHeight="1.45"
                                Text="แยกรายการซื้อและขายให้ดูง่ายในที่เดียว"
                                TextColor="{StaticResource InkSoft}" />
                        </VerticalStackLayout>

                        <Border
                            AutomationId="TransactionRoleModeSwitch"
                            Padding="4"
                            BackgroundColor="#EAF0F6"
                            Stroke="#080F172A"
                            StrokeShape="RoundRectangle 16">
                            <Grid
                                ColumnDefinitions="*,*"
                                ColumnSpacing="4">
                                <Button
                                    MinimumHeightRequest="{StaticResource CompactControlMinimumHeight}"
                                    BackgroundColor="Transparent"
                                    Command="{Binding SelectBuyingCommand}"
                                    CornerRadius="12"
                                    FontAttributes="Bold"
                                    FontSize="14"
                                    SemanticProperties.Description="แสดงรายการที่คุณเป็นผู้ซื้อ"
                                    Text="ซื้อ"
                                    TextColor="{StaticResource Muted}">
                                    <Button.Triggers>
                                        <DataTrigger
                                            TargetType="Button"
                                            Binding="{Binding IsBuying}"
                                            Value="True">
                                            <Setter Property="BackgroundColor" Value="White" />
                                            <Setter Property="TextColor" Value="#145FC7" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                                <Button
                                    Grid.Column="1"
                                    MinimumHeightRequest="{StaticResource CompactControlMinimumHeight}"
                                    BackgroundColor="Transparent"
                                    Command="{Binding SelectSellingCommand}"
                                    CornerRadius="12"
                                    FontAttributes="Bold"
                                    FontSize="14"
                                    SemanticProperties.Description="แสดงรายการที่คุณเป็นผู้ขาย"
                                    Text="ขาย"
                                    TextColor="{StaticResource Muted}">
                                    <Button.Triggers>
                                        <DataTrigger
                                            TargetType="Button"
                                            Binding="{Binding IsSelling}"
                                            Value="True">
                                            <Setter Property="BackgroundColor" Value="White" />
                                            <Setter Property="TextColor" Value="#6548C7" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                            </Grid>
                        </Border>

                        <Grid
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="12">
                            <VerticalStackLayout Spacing="3">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="24"
                                    Text="{Binding ModeTitle}" />
                                <Label
                                    FontSize="13"
                                    Text="{Binding ModeSubtitle}"
                                    TextColor="{StaticResource Muted}" />
                            </VerticalStackLayout>
                            <Button
                                Grid.Column="1"
                                IsVisible="{Binding IsBuying}"
                                MinimumHeightRequest="{StaticResource CompactControlMinimumHeight}"
                                Padding="14,0"
                                VerticalOptions="Center"
                                BackgroundColor="{StaticResource BrandBlue}"
                                Command="{Binding CreateOfferCommand}"
                                CornerRadius="14"
                                FontAttributes="Bold"
                                FontSize="12"
                                SemanticProperties.Description="สร้างข้อตกลงซื้อขาย"
                                Text="+ สร้างดีลซื้อ"
                                TextColor="White" />
                        </Grid>

                        <Border
                            IsVisible="{Binding HasError}"
                            Padding="14"
                            BackgroundColor="#FFF4DC"
                            Stroke="#F2C66D"
                            StrokeShape="RoundRectangle 16">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <Label
                                    VerticalOptions="Center"
                                    FontSize="13"
                                    Text="{Binding ErrorText}"
                                    TextColor="#7A4A00" />
                                <Button
                                    Grid.Column="1"
                                    HeightRequest="44"
                                    Padding="16,0"
                                    BackgroundColor="#8A5100"
                                    Command="{Binding RefreshCommand}"
                                    CornerRadius="12"
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    Text="ลองอีกครั้ง"
                                    TextColor="White" />
                            </Grid>
                        </Border>

                        <Grid
                            AutomationId="SellerWorkSummary"
                            IsVisible="{Binding IsSelling}"
                            RowDefinitions="Auto,Auto"
                            RowSpacing="10">
                            <Grid
                                ColumnDefinitions="*,Auto"
                                IsVisible="{Binding HasSellerSummary}">
                                <Label
                                    VerticalOptions="Center"
                                    FontAttributes="Bold"
                                    FontSize="14"
                                    Text="{Binding SellerTotalText}" />
                                <Button
                                    Grid.Column="1"
                                    MinimumHeightRequest="{StaticResource CompactControlMinimumHeight}"
                                    Padding="12,0"
                                    BackgroundColor="Transparent"
                                    Command="{Binding SelectAllSellerWorkCommand}"
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    SemanticProperties.Description="แสดงงานขายทั้งหมด"
                                    Text="ดูทั้งหมด"
                                    TextColor="#6548C7" />
                            </Grid>

                            <Grid
                                Grid.Row="1"
                                ColumnDefinitions="*,*,*"
                                ColumnSpacing="8"
                                IsVisible="{Binding HasSellerSummary}">
                                <Grid>
                                    <Border
                                        AutomationId="SellerNewOffersTile"
                                        BackgroundColor="#FFF4DC"
                                        Stroke="#F2C66D"
                                        StrokeShape="RoundRectangle 16">
                                        <Border.Triggers>
                                            <DataTrigger
                                                TargetType="Border"
                                                Binding="{Binding IsSellerNewOffersSelected}"
                                                Value="True">
                                                <Setter Property="BackgroundColor" Value="#6548C7" />
                                                <Setter Property="Stroke" Value="#6548C7" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <VerticalStackLayout
                                            Padding="10,11"
                                            Spacing="2"
                                            InputTransparent="True"
                                            AutomationProperties.IsInAccessibleTree="False">
                                            <Label
                                                HorizontalTextAlignment="Center"
                                                FontAttributes="Bold"
                                                FontSize="22"
                                                Text="{Binding NewOfferCountText}"
                                                TextColor="#7A4A00">
                                                <Label.Triggers>
                                                    <DataTrigger
                                                        TargetType="Label"
                                                        Binding="{Binding IsSellerNewOffersSelected}"
                                                        Value="True">
                                                        <Setter Property="TextColor" Value="White" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                            <Label
                                                HorizontalTextAlignment="Center"
                                                FontAttributes="Bold"
                                                FontSize="12"
                                                Text="รอตอบ"
                                                TextColor="#7A4A00">
                                                <Label.Triggers>
                                                    <DataTrigger
                                                        TargetType="Label"
                                                        Binding="{Binding IsSellerNewOffersSelected}"
                                                        Value="True">
                                                        <Setter Property="TextColor" Value="White" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </VerticalStackLayout>
                                    </Border>
                                    <Button
                                        MinimumHeightRequest="{StaticResource CompactControlMinimumHeight}"
                                        BackgroundColor="Transparent"
                                        Command="{Binding SelectSellerNewOffersCommand}"
                                        SemanticProperties.Description="{Binding NewOfferSemanticText}"
                                        Text=""
                                        TextColor="Transparent" />
                                </Grid>

                                <Grid Grid.Column="1">
                                    <Border
                                        AutomationId="SellerFulfillmentTile"
                                        BackgroundColor="#F1ECFF"
                                        Stroke="#D7CBFF"
                                        StrokeShape="RoundRectangle 16">
                                        <Border.Triggers>
                                            <DataTrigger
                                                TargetType="Border"
                                                Binding="{Binding IsSellerFulfillmentSelected}"
                                                Value="True">
                                                <Setter Property="BackgroundColor" Value="#6548C7" />
                                                <Setter Property="Stroke" Value="#6548C7" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <VerticalStackLayout
                                            Padding="10,11"
                                            Spacing="2"
                                            InputTransparent="True"
                                            AutomationProperties.IsInAccessibleTree="False">
                                            <Label
                                                HorizontalTextAlignment="Center"
                                                FontAttributes="Bold"
                                                FontSize="22"
                                                Text="{Binding FulfillmentCountText}"
                                                TextColor="#6548C7">
                                                <Label.Triggers>
                                                    <DataTrigger
                                                        TargetType="Label"
                                                        Binding="{Binding IsSellerFulfillmentSelected}"
                                                        Value="True">
                                                        <Setter Property="TextColor" Value="White" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                            <Label
                                                HorizontalTextAlignment="Center"
                                                FontAttributes="Bold"
                                                FontSize="12"
                                                Text="ต้องส่ง"
                                                TextColor="#6548C7">
                                                <Label.Triggers>
                                                    <DataTrigger
                                                        TargetType="Label"
                                                        Binding="{Binding IsSellerFulfillmentSelected}"
                                                        Value="True">
                                                        <Setter Property="TextColor" Value="White" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </VerticalStackLayout>
                                    </Border>
                                    <Button
                                        MinimumHeightRequest="{StaticResource CompactControlMinimumHeight}"
                                        BackgroundColor="Transparent"
                                        Command="{Binding SelectSellerFulfillmentCommand}"
                                        SemanticProperties.Description="{Binding FulfillmentSemanticText}"
                                        Text=""
                                        TextColor="Transparent" />
                                </Grid>

                                <Grid Grid.Column="2">
                                    <Border
                                        AutomationId="SellerInProgressTile"
                                        BackgroundColor="#EAF4FF"
                                        Stroke="#B9D8FF"
                                        StrokeShape="RoundRectangle 16">
                                        <Border.Triggers>
                                            <DataTrigger
                                                TargetType="Border"
                                                Binding="{Binding IsSellerInProgressSelected}"
                                                Value="True">
                                                <Setter Property="BackgroundColor" Value="#6548C7" />
                                                <Setter Property="Stroke" Value="#6548C7" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <VerticalStackLayout
                                            Padding="10,11"
                                            Spacing="2"
                                            InputTransparent="True"
                                            AutomationProperties.IsInAccessibleTree="False">
                                            <Label
                                                HorizontalTextAlignment="Center"
                                                FontAttributes="Bold"
                                                FontSize="22"
                                                Text="{Binding InProgressCountText}"
                                                TextColor="#145FC7">
                                                <Label.Triggers>
                                                    <DataTrigger
                                                        TargetType="Label"
                                                        Binding="{Binding IsSellerInProgressSelected}"
                                                        Value="True">
                                                        <Setter Property="TextColor" Value="White" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                            <Label
                                                HorizontalTextAlignment="Center"
                                                FontAttributes="Bold"
                                                FontSize="12"
                                                Text="กำลังไปต่อ"
                                                TextColor="#145FC7">
                                                <Label.Triggers>
                                                    <DataTrigger
                                                        TargetType="Label"
                                                        Binding="{Binding IsSellerInProgressSelected}"
                                                        Value="True">
                                                        <Setter Property="TextColor" Value="White" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </VerticalStackLayout>
                                    </Border>
                                    <Button
                                        MinimumHeightRequest="{StaticResource CompactControlMinimumHeight}"
                                        BackgroundColor="Transparent"
                                        Command="{Binding SelectSellerInProgressCommand}"
                                        SemanticProperties.Description="{Binding InProgressSemanticText}"
                                        Text=""
                                        TextColor="Transparent" />
                                </Grid>
                            </Grid>
                        </Grid>

                        <Border
                            AutomationId="SellerProblemBanner"
                            IsVisible="{Binding HasSellerProblems}"
                            Padding="14,10"
                            BackgroundColor="#FFF0F1"
                            Stroke="#F2A7AE"
                            StrokeShape="RoundRectangle 16">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <VerticalStackLayout
                                    VerticalOptions="Center"
                                    Spacing="2">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="12"
                                        Text="แจ้งปัญหา"
                                        TextColor="#A02B38" />
                                    <Label
                                        FontSize="12"
                                        LineBreakMode="WordWrap"
                                        Text="{Binding SellerProblemText}"
                                        TextColor="#7A202A" />
                                </VerticalStackLayout>
                                <Button
                                    Grid.Column="1"
                                    MinimumHeightRequest="{StaticResource CompactControlMinimumHeight}"
                                    Padding="12,0"
                                    VerticalOptions="Center"
                                    BackgroundColor="White"
                                    Command="{Binding SelectSellerProblemsCommand}"
                                    CornerRadius="12"
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    SemanticProperties.Description="เปิดรายการขายที่แจ้งปัญหา"
                                    Text="ดูรายการ"
                                    TextColor="#A02B38" />
                            </Grid>
                        </Border>

                        <Border
                            AutomationId="ActionSpotlightCard"
                            IsVisible="{Binding HasSpotlight}"
                            MinimumHeightRequest="236"
                            Padding="18"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 24">
                            <Border.Shadow>
                                <Shadow
                                    Brush="#2B7FFF"
                                    Offset="0,10"
                                    Opacity="0.18"
                                    Radius="24" />
                            </Border.Shadow>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="{Binding SpotlightGradient.Start}" Offset="0" />
                                    <GradientStop Color="{Binding SpotlightGradient.Middle}" Offset="0.64" />
                                    <GradientStop Color="{Binding SpotlightGradient.End}" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="11">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label
                                        VerticalOptions="Center"
                                        FontSize="12">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span
                                                    FontAttributes="Bold"
                                                    Text="●"
                                                    TextColor="#9CEBD9" />
                                                <Span
                                                    FontAttributes="Bold"
                                                    Text="  ต้องทำตอนนี้"
                                                    TextColor="#DFFFFFFF" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Border
                                        Grid.Column="1"
                                        Padding="9,5"
                                        BackgroundColor="#24FFFFFF"
                                        Stroke="#30FFFFFF"
                                        StrokeShape="RoundRectangle 99">
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="12"
                                            Text="{Binding SpotlightTransaction.RoleLabel}"
                                            TextColor="White" />
                                    </Border>
                                </Grid>

                                <Grid
                                    Grid.Row="1"
                                    ColumnDefinitions="54,*"
                                    ColumnSpacing="12">
                                    <Border
                                        WidthRequest="54"
                                        HeightRequest="54"
                                        BackgroundColor="#E8FFFFFF"
                                        Stroke="#30FFFFFF"
                                        StrokeShape="RoundRectangle 16">
                                        <Image
                                            Margin="8"
                                            Source="{Binding SpotlightTransaction.ProductVisual}" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="17"
                                            LineBreakMode="TailTruncation"
                                            MaxLines="2"
                                            Text="{Binding SpotlightTransaction.ProductName}"
                                            TextColor="White" />
                                        <Label
                                            FontSize="12"
                                            Text="{Binding SpotlightTransaction.CounterpartyLabel}"
                                            TextColor="#CFE1FF" />
                                    </VerticalStackLayout>
                                </Grid>

                                <VerticalStackLayout
                                    Grid.Row="2"
                                    Spacing="2">
                                    <Label
                                        FontSize="12"
                                        Text="{Binding SpotlightTransaction.StatusLabel}"
                                        TextColor="#CFE1FF" />
                                    <Label
                                        IsVisible="{Binding IsSelling}"
                                        FontSize="12"
                                        Text="{Binding SellerPriorityExplanation}"
                                        TextColor="#E3DDFF" />
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="25"
                                        CharacterSpacing="-0.5"
                                        Text="{Binding SpotlightAmountText}"
                                        TextColor="White" />
                                    <Label
                                        FontSize="12"
                                        LineBreakMode="WordWrap"
                                        Text="{Binding SpotlightTransaction.DeadlineText}"
                                        TextColor="#D8E7FF" />
                                </VerticalStackLayout>

                                <Button
                                    Grid.Row="3"
                                    MinimumHeightRequest="{StaticResource SecondaryButtonMinimumHeight}"
                                    BackgroundColor="White"
                                    CornerRadius="14"
                                    Command="{Binding OpenTransactionCommand}"
                                    CommandParameter="{Binding SpotlightTransaction}"
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    Text="{Binding SpotlightTransaction.PrimaryActionLabel, StringFormat='{0}  →'}"
                                    TextColor="{Binding SpotlightTransaction.RoleHeaderStart}" />
                            </Grid>
                        </Border>

                        <Grid
                            AutomationId="ActionSpotlightEmptyState"
                            IsVisible="{Binding ShowBuyerSpotlightEmptyState}"
                            MinimumHeightRequest="236"
                            Padding="20,22">
                            <Label
                                VerticalOptions="Center"
                                HorizontalTextAlignment="Center"
                                FontAttributes="Bold"
                                FontSize="17"
                                Text="ยังไม่มีรายการ" />
                        </Grid>

                        <VerticalStackLayout Spacing="10">
                            <ScrollView
                                AutomationId="BuyerStatusFilters"
                                IsVisible="{Binding IsBuying}"
                                Orientation="Horizontal"
                                HorizontalScrollBarVisibility="Never">
                                <HorizontalStackLayout Spacing="8">
                                    <Button
                                        Style="{StaticResource HomeStatusFilter}"
                                        Command="{Binding SelectAllBucketsCommand}"
                                        Text="ทุกสถานะ">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button" Binding="{Binding IsAllBuckets}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{StaticResource BrandBlue}" />
                                                <Setter Property="BorderColor" Value="{StaticResource BrandBlue}" />
                                                <Setter Property="TextColor" Value="White" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>
                                    <Button
                                        Style="{StaticResource HomeStatusFilter}"
                                        Command="{Binding SelectActionCommand}"
                                        Text="ต้องทำ">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button" Binding="{Binding IsActionRequired}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{StaticResource BrandBlue}" />
                                                <Setter Property="BorderColor" Value="{StaticResource BrandBlue}" />
                                                <Setter Property="TextColor" Value="White" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>
                                    <Button
                                        Style="{StaticResource HomeStatusFilter}"
                                        Command="{Binding SelectProgressCommand}"
                                        Text="กำลังดำเนินการ">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button" Binding="{Binding IsInProgress}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{StaticResource BrandBlue}" />
                                                <Setter Property="BorderColor" Value="{StaticResource BrandBlue}" />
                                                <Setter Property="TextColor" Value="White" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>
                                    <Button
                                        Style="{StaticResource HomeStatusFilter}"
                                        Command="{Binding SelectCompletedCommand}"
                                        Text="เสร็จแล้ว">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button" Binding="{Binding IsCompleted}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{StaticResource BrandBlue}" />
                                                <Setter Property="BorderColor" Value="{StaticResource BrandBlue}" />
                                                <Setter Property="TextColor" Value="White" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>
                                </HorizontalStackLayout>
                            </ScrollView>

                        </VerticalStackLayout>

                        <Grid Margin="0,4,0,0" ColumnDefinitions="*,Auto">
                            <Label
                                Style="{StaticResource SectionTitle}"
                                FontSize="18"
                                Text="{Binding ModeSectionTitle}" />
                            <Label
                                Grid.Column="1"
                                VerticalOptions="Center"
                                FontSize="12"
                                IsVisible="{Binding IsBuying}"
                                Text="ใหม่สุดก่อน"
                                TextColor="{StaticResource Muted}" />
                            <Label
                                Grid.Column="1"
                                VerticalOptions="Center"
                                FontSize="12"
                                IsVisible="{Binding IsSelling}"
                                Text="{Binding SellerPriorityExplanation}"
                                TextColor="{StaticResource Muted}" />
                        </Grid>
                    </VerticalStackLayout>
                </CollectionView.Header>

                <CollectionView.EmptyView>
                    <VerticalStackLayout
                        AutomationId="TransactionCollectionEmptyState"
                        IsVisible="{Binding Source={x:Reference RootPage}, Path=BindingContext.ShowTransactionCollectionEmptyState}"
                        Padding="30,26,30,48"
                        Spacing="7">
                        <Label
                            HorizontalTextAlignment="Center"
                            FontAttributes="Bold"
                            FontSize="14"
                            Text="{Binding EmptyText}" />
                        <Label
                            HorizontalTextAlignment="Center"
                            FontSize="12"
                            Text="ลองเลือกสถานะอื่น"
                            TextColor="{StaticResource Muted}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="core:AppTransaction">
                        <Grid>
                            <Border
                                AutomationId="CompactBuyerTransactionCard"
                                IsVisible="{Binding IsBuyerRole}"
                                Margin="20,0,20,12"
                                Padding="15"
                                BackgroundColor="#F7FFFFFF"
                                Stroke="#110F172A"
                                StrokeShape="RoundRectangle 20">
                                <Border.Shadow>
                                    <Shadow
                                        Brush="#1F476F9D"
                                        Offset="0,7"
                                        Opacity="0.12"
                                        Radius="18" />
                                </Border.Shadow>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.OpenTransactionCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid
                                    ColumnDefinitions="64,*,Auto"
                                    RowDefinitions="Auto,Auto"
                                    ColumnSpacing="13"
                                    RowSpacing="11">
                                    <Border
                                        Grid.RowSpan="2"
                                        WidthRequest="64"
                                        HeightRequest="64"
                                        VerticalOptions="Start"
                                        BackgroundColor="#EEF6FF"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 17">
                                        <Image Margin="7" Source="{Binding ProductVisual}" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                                        <HorizontalStackLayout Spacing="6">
                                            <BoxView
                                                WidthRequest="6"
                                                HeightRequest="6"
                                                VerticalOptions="Center"
                                                Color="{Binding RoleColor}"
                                                CornerRadius="3" />
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="12"
                                                Text="{Binding RoleLabel}"
                                                TextColor="{Binding RoleColor}" />
                                        </HorizontalStackLayout>
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="14"
                                            LineBreakMode="TailTruncation"
                                            MaxLines="2"
                                            Text="{Binding ProductName}" />
                                        <Label
                                            FontSize="12"
                                            Text="{Binding CounterpartyLabel}"
                                            TextColor="{StaticResource Muted}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2" HorizontalOptions="End" Spacing="2">
                                        <Label
                                            HorizontalTextAlignment="End"
                                            FontAttributes="Bold"
                                            FontSize="15"
                                            Text="{Binding FormattedAmount}" />
                                        <Label
                                            HorizontalTextAlignment="End"
                                            FontSize="16"
                                            Text="›"
                                            TextColor="#8BA0B8" />
                                    </VerticalStackLayout>
                                    <Grid
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        ColumnDefinitions="*,Auto"
                                        ColumnSpacing="10"
                                        RowDefinitions="Auto,Auto"
                                        RowSpacing="2">
                                        <HorizontalStackLayout Spacing="6">
                                            <BoxView
                                                WidthRequest="6"
                                                HeightRequest="6"
                                                VerticalOptions="Center"
                                                Color="{Binding StatusColor}"
                                                CornerRadius="3" />
                                            <Label
                                                VerticalOptions="Center"
                                                FontAttributes="Bold"
                                                FontSize="12"
                                                Text="{Binding StatusLabel}"
                                                TextColor="{Binding StatusColor}" />
                                        </HorizontalStackLayout>
                                        <Label
                                            Grid.Column="1"
                                            VerticalOptions="Center"
                                            FontAttributes="Bold"
                                            FontSize="12"
                                            Text="{Binding PrimaryActionLabel}"
                                            TextColor="{StaticResource BrandBlue}" />
                                        <Label
                                            Grid.Row="1"
                                            Grid.ColumnSpan="2"
                                            FontSize="12"
                                            LineBreakMode="WordWrap"
                                            Text="{Binding DeadlineText}"
                                            TextColor="{StaticResource Muted}" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border
                                AutomationId="CompactSellerTransactionCard"
                                IsVisible="{Binding IsSellerRole}"
                                Margin="20,0,20,12"
                                Padding="15"
                                BackgroundColor="#F7FFFFFF"
                                Stroke="#110F172A"
                                StrokeShape="RoundRectangle 20">
                                <Border.Shadow>
                                    <Shadow
                                        Brush="#2A6548C7"
                                        Offset="0,7"
                                        Opacity="0.12"
                                        Radius="18" />
                                </Border.Shadow>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.OpenTransactionCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid
                                    ColumnDefinitions="64,*,Auto"
                                    RowDefinitions="Auto,Auto"
                                    ColumnSpacing="13"
                                    RowSpacing="11">
                                    <Border
                                        Grid.RowSpan="2"
                                        WidthRequest="64"
                                        HeightRequest="64"
                                        VerticalOptions="Start"
                                        BackgroundColor="#F1ECFF"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 17">
                                        <Image Margin="7" Source="{Binding ProductVisual}" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                                        <HorizontalStackLayout Spacing="6">
                                            <BoxView
                                                WidthRequest="6"
                                                HeightRequest="6"
                                                VerticalOptions="Center"
                                                Color="{Binding RoleColor}"
                                                CornerRadius="3" />
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="12"
                                                Text="{Binding RoleLabel}"
                                                TextColor="{Binding RoleColor}" />
                                        </HorizontalStackLayout>
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="14"
                                            LineBreakMode="TailTruncation"
                                            MaxLines="2"
                                            Text="{Binding ProductName}" />
                                        <Label
                                            FontSize="12"
                                            Text="{Binding CounterpartyLabel}"
                                            TextColor="{StaticResource Muted}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2" HorizontalOptions="End" Spacing="2">
                                        <Label
                                            HorizontalTextAlignment="End"
                                            FontAttributes="Bold"
                                            FontSize="15"
                                            Text="{Binding ItemPriceText}" />
                                        <Label
                                            HorizontalTextAlignment="End"
                                            FontSize="16"
                                            Text="›"
                                            TextColor="#8BA0B8" />
                                    </VerticalStackLayout>
                                    <Grid
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        ColumnDefinitions="*,Auto"
                                        ColumnSpacing="10"
                                        RowDefinitions="Auto,Auto"
                                        RowSpacing="2">
                                        <HorizontalStackLayout Spacing="6">
                                            <BoxView
                                                WidthRequest="6"
                                                HeightRequest="6"
                                                VerticalOptions="Center"
                                                Color="{Binding StatusColor}"
                                                CornerRadius="3" />
                                            <Label
                                                VerticalOptions="Center"
                                                FontAttributes="Bold"
                                                FontSize="12"
                                                Text="{Binding StatusLabel}"
                                                TextColor="{Binding StatusColor}" />
                                        </HorizontalStackLayout>
                                        <Label
                                            Grid.Column="1"
                                            VerticalOptions="Center"
                                            FontAttributes="Bold"
                                            FontSize="12"
                                            Text="{Binding PrimaryActionLabel}"
                                            TextColor="#6548C7" />
                                        <Label
                                            Grid.Row="1"
                                            Grid.ColumnSpan="2"
                                            FontSize="12"
                                            LineBreakMode="WordWrap"
                                            Text="{Binding DeadlineText}"
                                            TextColor="{StaticResource Muted}" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.Footer>
                    <BoxView HeightRequest="28" Color="Transparent" />
                </CollectionView.Footer>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
