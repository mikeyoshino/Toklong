<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Toklong.Mobile.Pages.CompleteRegistrationPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Toklong.Mobile.Controls"
    BackgroundColor="{StaticResource CleanLedgerRootBackground}"
    SafeAreaEdges="Container"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False">
    <ScrollView SafeAreaEdges="SoftInput">
        <VerticalStackLayout
            MaximumWidthRequest="520"
            Padding="{StaticResource AuthScreenPadding}"
            Spacing="22">
            <controls:CenteredAuthBrandView
                HorizontalOptions="Center"
                MarkSize="58"
                WordmarkSize="18" />

            <VerticalStackLayout Spacing="8">
                <Label
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource AuthTitle}"
                    Text="ตั้งค่าบัญชีให้เสร็จ" />
                <Label
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource RefinedBodyText}"
                    Text="ยืนยันเบอร์เรียบร้อยแล้ว เหลือข้อมูลสำหรับบัญชีและการชำระเงิน"
                    TextColor="{StaticResource InkSoft}" />
            </VerticalStackLayout>

            <Border
                Padding="14,11"
                BackgroundColor="#EEF7FF"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 14">
                <Grid ColumnDefinitions="24,*" ColumnSpacing="9">
                    <Image
                        WidthRequest="20"
                        HeightRequest="20"
                        AutomationProperties.IsInAccessibleTree="False"
                        Source="ui_smartphone.png" />
                    <Label
                        Grid.Column="1"
                        VerticalOptions="Center"
                        FontAttributes="Bold"
                        Text="{Binding MaskedPhoneNumber}"
                        TextColor="{StaticResource BrandBlueDeep}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource AuthFormCard}">
                <VerticalStackLayout Spacing="18">
                    <VerticalStackLayout
                        Style="{StaticResource RefinedFormSection}">
                        <controls:FormLabelView
                            IsRequired="True"
                            Text="ชื่อ" />
                        <Border Style="{StaticResource RefinedInputBorder}">
                            <Entry
                                Style="{StaticResource RefinedEntry}"
                                MaxLength="60"
                                Placeholder="ชื่อ"
                                SemanticProperties.Description="ชื่อ"
                                Text="{Binding FirstName}" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout
                        Style="{StaticResource RefinedFormSection}">
                        <controls:FormLabelView
                            IsRequired="True"
                            Text="นามสกุล" />
                        <Border Style="{StaticResource RefinedInputBorder}">
                            <Entry
                                Style="{StaticResource RefinedEntry}"
                                MaxLength="60"
                                Placeholder="นามสกุล"
                                SemanticProperties.Description="นามสกุล"
                                Text="{Binding LastName}" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout
                        Style="{StaticResource RefinedFormSection}">
                        <controls:FormLabelView
                            IsRequired="True"
                            Text="อีเมลสำหรับใบเสร็จและการคืนเงิน" />
                        <Border Style="{StaticResource RefinedInputBorder}">
                            <Entry
                                Style="{StaticResource RefinedEntry}"
                                Keyboard="Email"
                                MaxLength="254"
                                Placeholder="name@example.com"
                                SemanticProperties.Description="อีเมลสำหรับใบเสร็จและการคืนเงิน"
                                Text="{Binding Email}" />
                        </Border>
                        <Label
                            Style="{StaticResource RefinedHelperText}"
                            Text="อีเมลนี้ไม่ใช้สำหรับเข้าสู่ระบบ" />
                    </VerticalStackLayout>

                    <Label
                        Style="{StaticResource RefinedHelperText}"
                        LineHeight="1.4">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="เมื่อกด “สร้างบัญชีและเริ่มใช้งาน” คุณยอมรับ " />
                                <Span
                                    Text="ข้อตกลงการใช้บริการ"
                                    TextColor="{StaticResource BrandBlueDeep}"
                                    TextDecorations="Underline">
                                    <Span.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding OpenTermsCommand}" />
                                    </Span.GestureRecognizers>
                                </Span>
                                <Span Text=" และ " />
                                <Span
                                    Text="นโยบายความเป็นส่วนตัว"
                                    TextColor="{StaticResource BrandBlueDeep}"
                                    TextDecorations="Underline">
                                    <Span.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding OpenPrivacyCommand}" />
                                    </Span.GestureRecognizers>
                                </Span>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Button
                        Style="{StaticResource LedgerPrimaryButton}"
                        Command="{Binding CompleteCommand}"
                        Text="สร้างบัญชีและเริ่มใช้งาน">
                        <Button.Triggers>
                            <DataTrigger
                                TargetType="Button"
                                Binding="{Binding IsBusy}"
                                Value="True">
                                <Setter Property="IsEnabled" Value="False" />
                                <Setter Property="Text" Value="กำลังสร้างบัญชี..." />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator
                HorizontalOptions="Center"
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                Color="{StaticResource BrandBlue}" />

            <Border
                IsVisible="{Binding HasMessage}"
                Style="{StaticResource RefinedValidationBorder}">
                <Label
                    Style="{StaticResource RefinedValidationText}"
                    Text="{Binding Message}" />
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
