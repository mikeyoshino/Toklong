<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Toklong.Mobile.Pages.WelcomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Toklong.Mobile.Controls"
    SafeAreaEdges="Container"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False">
    <ContentPage.Background>
        <RadialGradientBrush Center="0.5,0.06" Radius="0.95">
            <GradientStop Color="#E2F1FF" Offset="0" />
            <GradientStop Color="#F7FAFF" Offset="0.45" />
            <GradientStop Color="#FFFFFF" Offset="1" />
        </RadialGradientBrush>
    </ContentPage.Background>
    <ScrollView>
        <VerticalStackLayout
            MaximumWidthRequest="520"
            Padding="24,64,24,32"
            Spacing="30">
            <controls:CenteredAuthBrandView
                HorizontalOptions="Center" />

            <VerticalStackLayout Spacing="10">
                <Label
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource AuthTitle}"
                    Text="ซื้อขายออนไลน์ ง่ายขึ้น" />
                <Label
                    HorizontalTextAlignment="Center"
                    Style="{StaticResource RefinedBodyText}"
                    LineHeight="1.5"
                    Text="ตกลง จ่าย และติดตามรายการในที่เดียว&#10;ชัดเจนทุกขั้นตอนสำหรับทั้งผู้ซื้อและผู้ขาย"
                    TextColor="{StaticResource InkSoft}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                <Button
                    Style="{StaticResource RefinedPrimaryButton}"
                    Clicked="OnSignInClicked"
                    Text="เข้าสู่ระบบ" />
                <Button
                    Style="{StaticResource RefinedInlineButton}"
                    Clicked="OnSignUpClicked"
                    FontAttributes="Bold"
                    Text="สมัครสมาชิก" />
            </VerticalStackLayout>

            <Label
                HorizontalTextAlignment="Center"
                Style="{StaticResource RefinedHelperText}"
                Text="ยืนยันด้วย SMS ไม่ต้องตั้งหรือจำรหัสผ่าน"
                TextColor="{StaticResource Muted}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
