<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Toklong.Mobile.Pages.CreateOfferPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Toklong.Mobile.Controls"
    Title="สร้างข้อเสนอ"
    SafeAreaEdges="Container"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False"
    BackgroundColor="#FBFDFF">

    <Grid RowDefinitions="Auto,*">
        <Border
            Grid.Row="0"
            AutomationId="CreateOfferHeader"
            Padding="20,12,20,18"
            BackgroundColor="White"
            StrokeThickness="0">
            <VerticalStackLayout Spacing="14">
                <Grid
                    ColumnDefinitions="48,*"
                    ColumnSpacing="16">
                    <Button
                        AutomationId="CreateOfferBackButton"
                        WidthRequest="48"
                        HeightRequest="48"
                        Padding="0"
                        BackgroundColor="{StaticResource SurfaceBlue}"
                        Clicked="OnBackClicked"
                        CornerRadius="14"
                        FontAttributes="Bold"
                        FontSize="28"
                        SemanticProperties.Description="ย้อนกลับ"
                        Text="‹"
                        TextColor="{StaticResource BrandBlueDeep}" />
                    <VerticalStackLayout
                        Grid.Column="1"
                        VerticalOptions="Center"
                        Spacing="1">
                        <Label
                            FontAttributes="Bold"
                            FontSize="26"
                            Text="สร้างข้อเสนอ"
                            TextColor="{StaticResource Ink}" />
                        <Label
                            Style="{StaticResource RefinedHelperText}"
                            Text="{Binding ProgressText}"
                            SemanticProperties.Description="{Binding ProgressText}" />
                    </VerticalStackLayout>
                </Grid>
                <Grid
                    AutomationId="CreateOfferProgress"
                    ColumnDefinitions="*,*,*"
                    ColumnSpacing="8">
                    <BoxView
                        HeightRequest="4"
                        CornerRadius="2"
                        Color="{StaticResource BrandBlue}" />
                    <BoxView
                        Grid.Column="1"
                        HeightRequest="4"
                        CornerRadius="2"
                        Color="#DCE8F5">
                        <BoxView.Triggers>
                            <DataTrigger
                                TargetType="BoxView"
                                Binding="{Binding IsDealStep}"
                                Value="False">
                                <Setter
                                    Property="Color"
                                    Value="{StaticResource BrandBlue}" />
                            </DataTrigger>
                        </BoxView.Triggers>
                    </BoxView>
                    <BoxView
                        Grid.Column="2"
                        HeightRequest="4"
                        CornerRadius="2"
                        Color="#DCE8F5">
                        <BoxView.Triggers>
                            <DataTrigger
                                TargetType="BoxView"
                                Binding="{Binding IsReviewStep}"
                                Value="True">
                                <Setter
                                    Property="Color"
                                    Value="{StaticResource BrandBlue}" />
                            </DataTrigger>
                        </BoxView.Triggers>
                    </BoxView>
                </Grid>
            </VerticalStackLayout>
        </Border>

        <ScrollView
            x:Name="DealStepScroll"
            Grid.Row="1"
            AutomationId="CreateOfferDealStep"
            IsVisible="{Binding IsDealStep}"
            SafeAreaEdges="SoftInput">
            <VerticalStackLayout
                MaximumWidthRequest="720"
                Padding="20,24,20,124"
                Spacing="24">
                <VerticalStackLayout Spacing="4">
                    <Label
                        FontAttributes="Bold"
                        FontSize="24"
                        Text="ข้อมูลดีล"
                        TextColor="{StaticResource Ink}" />
                    <Label
                        Style="{StaticResource RefinedHelperText}"
                        Text="ข้อเสนอส่วนตัวสำหรับผู้ขายที่คุณตกลงกันไว้แล้ว ไม่ใช่ประกาศขายสาธารณะ" />
                </VerticalStackLayout>

                <VerticalStackLayout
                    AutomationId="SellerPhoneSection"
                    Style="{StaticResource RefinedFormSection}">
                    <controls:FormLabelView
                        IsRequired="True"
                        Text="เบอร์โทรผู้ขาย" />
                    <Border Style="{StaticResource RefinedInputBorder}">
                        <controls:ThaiMobilePhoneEntry
                            x:Name="SellerPhoneEntry"
                            Style="{StaticResource RefinedEntry}"
                            PhoneNumber="{Binding SellerPhoneNumber}"
                            Placeholder="เช่น 081-234-5678"
                            SemanticProperties.Description="เบอร์โทรศัพท์ของผู้ขาย" />
                    </Border>
                    <Label
                        IsVisible="{Binding HasSellerPhoneError}"
                        Style="{StaticResource RefinedValidationText}"
                        Text="{Binding SellerPhoneError}" />
                    <Label
                        Style="{StaticResource RefinedHelperText}"
                        Text="ข้อเสนอนี้เปิดและตอบรับได้เฉพาะบัญชีที่ยืนยันด้วยเบอร์นี้" />
                </VerticalStackLayout>

                <VerticalStackLayout
                    AutomationId="ProductNameSection"
                    Style="{StaticResource RefinedFormSection}">
                    <controls:FormLabelView
                        IsRequired="True"
                        Text="ชื่อสินค้า" />
                    <Border Style="{StaticResource RefinedInputBorder}">
                        <Entry
                            x:Name="ProductNameEntry"
                            Style="{StaticResource RefinedEntry}"
                            MaxLength="180"
                            Placeholder="เช่น กล้อง Fujifilm X-T30 II"
                            SemanticProperties.Description="ชื่อสินค้า"
                            Text="{Binding ProductName}" />
                    </Border>
                    <Label
                        IsVisible="{Binding HasProductNameError}"
                        Style="{StaticResource RefinedValidationText}"
                        Text="{Binding ProductNameError}" />
                </VerticalStackLayout>

                <VerticalStackLayout
                    AutomationId="ItemPriceSection"
                    Style="{StaticResource RefinedFormSection}">
                    <controls:FormLabelView
                        IsRequired="True"
                        Text="ราคาสินค้า" />
                    <Border Style="{StaticResource RefinedAmountBorder}">
                        <Grid
                            ColumnDefinitions="Auto,*"
                            ColumnSpacing="{StaticResource SpacingSm}">
                            <Label
                                VerticalOptions="Center"
                                FontAttributes="Bold"
                                FontSize="20"
                                Text="฿"
                                TextColor="{StaticResource BrandBlueDeep}" />
                            <Entry
                                x:Name="AmountEntry"
                                Grid.Column="1"
                                Style="{StaticResource RefinedAmountEntry}"
                                Keyboard="Numeric"
                                Placeholder="0.00"
                                SemanticProperties.Description="ราคาสินค้าเป็นบาท"
                                Text="{Binding AmountBaht}" />
                        </Grid>
                    </Border>
                    <Label
                        IsVisible="{Binding HasAmountError}"
                        Style="{StaticResource RefinedValidationText}"
                        Text="{Binding AmountError}" />
                    <Label
                        Style="{StaticResource RefinedHelperText}"
                        Text="ราคาสินค้าตั้งแต่ 1,000 ถึง 30,000 บาท" />
                    <Label
                        Style="{StaticResource RefinedHelperText}"
                        Text="ใส่เฉพาะราคาสินค้า หากต้องจัดส่ง ผู้ขายจะเลือกค่าจัดส่งภายหลัง ไม่ต้องรวมในราคานี้"
                        TextColor="{StaticResource BrandBlueDeep}" />
                </VerticalStackLayout>

                <Button
                    AutomationId="OpenAiAgreementDraftButton"
                    Style="{StaticResource RefinedSecondaryActionButton}"
                    Command="{Binding OpenAiSheetCommand}"
                    ContentLayout="Left,10"
                    ImageSource="ui_ai_assist.png"
                    SemanticProperties.Description="ให้ AI ช่วยกรอกข้อมูลจากรูปหรือข้อความแชต"
                    Text="ให้ AI ช่วยกรอก" />

                <VerticalStackLayout
                    AutomationId="OptionalProductPhotoField"
                    Spacing="{StaticResource SpacingSm}">
                    <controls:FormLabelView
                        Text="รูปสินค้า (ไม่บังคับ)" />
                    <Label
                        Style="{StaticResource RefinedHelperText}"
                        Text="เมื่อเพิ่ม รูปนี้จะเป็นส่วนหนึ่งของรายละเอียดข้อเสนอ" />
                    <Button
                        x:Name="ProductPhotoButton"
                        Style="{StaticResource RefinedSecondaryActionButton}"
                        Command="{Binding PickPhotoCommand}"
                        SemanticProperties.Description="เลือกรูปสินค้า"
                        Text="+  ถ่ายหรือเลือกรูป" />
                    <Label
                        IsVisible="{Binding HasPhoto}"
                        Style="{StaticResource RefinedHelperText}"
                        Text="{Binding SelectedPhotoName, StringFormat='เลือกแล้ว · {0}'}"
                        TextColor="{StaticResource Success}" />
                    <Label
                        IsVisible="{Binding HasProductPhotoError}"
                        Style="{StaticResource RefinedValidationText}"
                        Text="{Binding ProductPhotoError}" />
                </VerticalStackLayout>

                <Border
                    AutomationId="OptionalDealDetailsDisclosure"
                    Padding="14"
                    BackgroundColor="White"
                    Stroke="{StaticResource Line}"
                    StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout Spacing="8">
                        <Grid
                            ColumnDefinitions="*,Auto"
                            MinimumHeightRequest="{StaticResource CompactControlMinimumHeight}">
                            <Label
                                AutomationProperties.IsInAccessibleTree="False"
                                InputTransparent="True"
                                VerticalOptions="Center"
                                FontFamily="NotoSansThaiMedium"
                                Text="{Binding OptionalDetailsLabel}"
                                TextColor="{StaticResource Ink}" />
                            <Label
                                Grid.Column="1"
                                AutomationProperties.IsInAccessibleTree="False"
                                InputTransparent="True"
                                VerticalOptions="Center"
                                Text="{Binding OptionalDetailsChevron}"
                                TextColor="{StaticResource Muted}" />
                            <Button
                                Grid.ColumnSpan="2"
                                MinimumHeightRequest="{StaticResource CompactControlMinimumHeight}"
                                Padding="0"
                                BackgroundColor="Transparent"
                                BorderWidth="0"
                                Command="{Binding ToggleOptionalDetailsCommand}"
                                SemanticProperties.Description="{Binding OptionalDetailsLabel}"
                                Text="" />
                        </Grid>
                        <Label
                            Style="{StaticResource RefinedHelperText}"
                            Text="{Binding OptionalDetailsSummary}" />
                        <VerticalStackLayout
                            IsVisible="{Binding ShowOptionalDetails}">
                            <Border Style="{StaticResource RefinedEditorBorder}">
                                <Editor
                                    Style="{StaticResource RefinedEditor}"
                                    AutoSize="TextChanges"
                                    MaxLength="2000"
                                    Placeholder="รุ่น สี อุปกรณ์ หรือสิ่งที่รวม"
                                    Text="{Binding AgreementDetails}" />
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border
                    IsVisible="{Binding HasMessage}"
                    Style="{StaticResource RefinedValidationBorder}">
                    <Label
                        Style="{StaticResource RefinedValidationText}"
                        Text="{Binding Message}" />
                </Border>

                <Button
                    AutomationId="ContinueFromDealButton"
                    Style="{StaticResource RefinedPrimaryButton}"
                    Command="{Binding ContinueFromDealCommand}"
                    Text="ถัดไป: การรับสินค้า  →" />
            </VerticalStackLayout>
        </ScrollView>

        <ScrollView
            x:Name="FulfillmentStepScroll"
            Grid.Row="1"
            AutomationId="CreateOfferFulfillmentStep"
            IsVisible="{Binding IsFulfillmentStep}"
            SafeAreaEdges="SoftInput">
            <VerticalStackLayout
                MaximumWidthRequest="720"
                Padding="20,24,20,124"
                Spacing="24">
                <VerticalStackLayout Spacing="4">
                    <Label
                        FontAttributes="Bold"
                        FontSize="24"
                        Text="การรับสินค้า"
                        TextColor="{StaticResource Ink}" />
                    <Label
                        Style="{StaticResource RefinedHelperText}"
                        Text="เลือกวิธีส่งมอบที่ใช้กับสินค้านี้" />
                </VerticalStackLayout>

                <VerticalStackLayout
                    AutomationId="FulfillmentTypeSection"
                    Spacing="{StaticResource SpacingSm}">
                    <controls:FormLabelView
                        IsRequired="True"
                        Text="ประเภทสินค้า" />
                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="{StaticResource SpacingSm}">
                        <Button
                            Style="{StaticResource RefinedSegmentButton}"
                            Command="{Binding SelectPhysicalCommand}"
                            Text="สินค้าที่จัดส่ง">
                            <Button.Triggers>
                                <DataTrigger
                                    TargetType="Button"
                                    Binding="{Binding IsPhysical}"
                                    Value="True">
                                    <Setter Property="BackgroundColor" Value="#EAF4FF" />
                                    <Setter Property="TextColor" Value="#145FC7" />
                                    <Setter Property="BorderColor" Value="#9CC9FF" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button
                            Grid.Column="1"
                            Style="{StaticResource RefinedSegmentButton}"
                            Command="{Binding SelectDigitalCommand}"
                            Text="ดิจิทัล">
                            <Button.Triggers>
                                <DataTrigger
                                    TargetType="Button"
                                    Binding="{Binding IsDigital}"
                                    Value="True">
                                    <Setter Property="BackgroundColor" Value="#EDEBFF" />
                                    <Setter Property="TextColor" Value="#5144BF" />
                                    <Setter Property="BorderColor" Value="#BDB6FF" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </Grid>
                    <Label
                        Style="{StaticResource RefinedHelperText}"
                        Text="สินค้าดิจิทัลต้องเป็นรายการที่โอนได้และอยู่ในประเภทที่รองรับ" />
                </VerticalStackLayout>

                <VerticalStackLayout
                    x:Name="DeliveryAddressAnchor"
                    AutomationId="DeliveryAddressSection"
                    IsVisible="{Binding IsPhysical}"
                    Style="{StaticResource RefinedFormSection}">
                    <controls:FormLabelView
                        IsRequired="True"
                        Text="ที่อยู่จัดส่ง" />
                    <Border
                        IsVisible="{Binding ShowSavedAddressSummary}"
                        Padding="16"
                        BackgroundColor="White"
                        Stroke="{StaticResource Line}"
                        StrokeShape="RoundRectangle 18">
                        <VerticalStackLayout Spacing="8">
                            <Label
                                FontFamily="NotoSansThaiMedium"
                                Text="{Binding SavedAddress}"
                                TextColor="{StaticResource Ink}" />
                            <Button
                                Style="{StaticResource RefinedInlineButton}"
                                Command="{Binding EditAddressCommand}"
                                SemanticProperties.Description="เปลี่ยนที่อยู่จัดส่ง"
                                Text="เปลี่ยน" />
                        </VerticalStackLayout>
                    </Border>
                    <VerticalStackLayout
                        IsVisible="{Binding ShowAddressEditor}"
                        Spacing="{StaticResource SpacingMd}">
                        <Button
                            IsVisible="{Binding HasSavedAddress}"
                            Style="{StaticResource RefinedSecondaryActionButton}"
                            Command="{Binding UseSavedAddressCommand}"
                            Text="ใช้ที่อยู่เดิม" />
                        <Border Style="{StaticResource RefinedInputBorder}">
                            <Entry
                                x:Name="AddressLineEntry"
                                Style="{StaticResource RefinedEntry}"
                                MaxLength="500"
                                Placeholder="บ้านเลขที่ ถนน อาคาร หรือหมู่บ้าน"
                                Text="{Binding AddressLine}" />
                        </Border>
                        <Border Style="{StaticResource RefinedInputBorder}">
                            <Picker
                                x:Name="ProvincePicker"
                                Style="{StaticResource RefinedPicker}"
                                ItemDisplayBinding="{Binding Name}"
                                ItemsSource="{Binding Provinces}"
                                SelectedItem="{Binding SelectedProvince}"
                                Title="เลือกจังหวัดปลายทาง" />
                        </Border>
                        <Border Style="{StaticResource RefinedInputBorder}">
                            <Picker
                                Style="{StaticResource RefinedPicker}"
                                ItemDisplayBinding="{Binding Name}"
                                ItemsSource="{Binding Districts}"
                                SelectedItem="{Binding SelectedDistrict}"
                                Title="เลือกอำเภอหรือเขต" />
                        </Border>
                        <Border Style="{StaticResource RefinedInputBorder}">
                            <Picker
                                Style="{StaticResource RefinedPicker}"
                                ItemDisplayBinding="{Binding Name}"
                                ItemsSource="{Binding Subdistricts}"
                                SelectedItem="{Binding SelectedSubdistrict}"
                                Title="เลือกตำบลหรือแขวง" />
                        </Border>
                        <HorizontalStackLayout Spacing="6">
                            <CheckBox
                                MinimumWidthRequest="{StaticResource CompactControlMinimumHeight}"
                                MinimumHeightRequest="{StaticResource CompactControlMinimumHeight}"
                                Color="{StaticResource BrandBlue}"
                                IsChecked="{Binding RememberAddress}" />
                            <Label
                                VerticalOptions="Center"
                                Style="{StaticResource RefinedHelperText}"
                                Text="จำที่อยู่นี้ไว้สำหรับดีลถัดไป" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                    <Label
                        IsVisible="{Binding HasDeliveryAddressError}"
                        Style="{StaticResource RefinedValidationText}"
                        Text="{Binding DeliveryAddressError}" />
                    <Label
                        Style="{StaticResource RefinedHelperText}"
                        Text="{Binding DeliveryRegionText}"
                        TextColor="{StaticResource BrandBlueDeep}" />
                    <Label
                        Style="{StaticResource RefinedHelperText}"
                        Text="ผู้ขายจะเห็นเฉพาะจังหวัดและรหัสไปรษณีย์ก่อนระบบยืนยันยอดชำระ" />
                    <Label
                        Style="{StaticResource RefinedHelperText}"
                        Text="ผู้ขายจะเลือกบริการจัดส่งที่รองรับภายหลัง คุณไม่ต้องรวมค่าจัดส่งในราคาสินค้า" />
                </VerticalStackLayout>

                <Border
                    IsVisible="{Binding IsDigital}"
                    Padding="16"
                    BackgroundColor="#F3F1FF"
                    Stroke="#D5D0FF"
                    StrokeShape="RoundRectangle 16">
                    <Label
                        Style="{StaticResource RefinedBodyText}"
                        Text="ผู้ขายจะส่งมอบสิทธิ์ดิจิทัลหลังระบบยืนยันยอดชำระ และคุณต้องยืนยันว่าได้รับแล้ว"
                        TextColor="{StaticResource Ink}" />
                </Border>

                <Border
                    IsVisible="{Binding HasAddressLoadError}"
                    Style="{StaticResource RefinedValidationBorder}">
                    <VerticalStackLayout Spacing="8">
                        <Label
                            Style="{StaticResource RefinedValidationText}"
                            Text="{Binding AddressLoadError}" />
                        <Button
                            Style="{StaticResource RefinedSecondaryActionButton}"
                            Command="{Binding RetryAddressCommand}"
                            Text="ลองอีกครั้ง" />
                    </VerticalStackLayout>
                </Border>

                <Border
                    IsVisible="{Binding HasMessage}"
                    Style="{StaticResource RefinedValidationBorder}">
                    <Label
                        Style="{StaticResource RefinedValidationText}"
                        Text="{Binding Message}" />
                </Border>

                <Button
                    AutomationId="ContinueFromFulfillmentButton"
                    Style="{StaticResource RefinedPrimaryButton}"
                    Command="{Binding ContinueFromFulfillmentCommand}"
                    Text="ถัดไป: ตรวจข้อมูล  →">
                    <Button.Triggers>
                        <DataTrigger
                            TargetType="Button"
                            Binding="{Binding IsReviewPricing}"
                            Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                            <Setter Property="Text" Value="กำลังคำนวณค่าใช้จ่าย..." />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button
                    Style="{StaticResource RefinedInlineButton}"
                    Command="{Binding PreviousStepCommand}"
                    Text="ย้อนกลับ: ข้อมูลดีล" />
            </VerticalStackLayout>
        </ScrollView>

        <ScrollView
            x:Name="ReviewStepScroll"
            Grid.Row="1"
            AutomationId="CreateOfferReviewStep"
            IsVisible="{Binding IsReviewStep}"
            SafeAreaEdges="SoftInput">
            <VerticalStackLayout
                MaximumWidthRequest="720"
                Padding="20,24,20,124"
                Spacing="24">
                <VerticalStackLayout Spacing="4">
                    <Label
                        FontAttributes="Bold"
                        FontSize="24"
                        Text="ตรวจและส่ง"
                        TextColor="{StaticResource Ink}" />
                    <Label
                        Style="{StaticResource RefinedHelperText}"
                        Text="ตรวจรายละเอียดก่อนส่งให้ผู้ขายตอบรับ" />
                </VerticalStackLayout>

                <Border
                    Padding="16"
                    BackgroundColor="White"
                    Stroke="{StaticResource Line}"
                    StrokeShape="RoundRectangle 18">
                    <Label
                        FontSize="14"
                        LineHeight="1.5"
                        Text="{Binding ReviewSummary}"
                        TextColor="{StaticResource Ink}" />
                </Border>

                <Border
                    x:Name="ReviewCostSummary"
                    AutomationId="ReviewCostSummary"
                    Padding="16"
                    BackgroundColor="#F3F8FF"
                    Stroke="#CFE2F8"
                    StrokeShape="RoundRectangle 18">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="ราคาสินค้า" />
                            <Label
                                Grid.Column="1"
                                Text="{Binding CostItemPriceText}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="ค่าคุ้มครองผู้ซื้อ" />
                            <Label
                                Grid.Column="1"
                                Text="{Binding CostProtectionFeeText}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="ค่าจัดส่ง" />
                            <Label
                                Grid.Column="1"
                                Text="{Binding CostShippingText}" />
                        </Grid>
                        <BoxView
                            HeightRequest="1"
                            Color="{StaticResource Line}" />
                        <Grid ColumnDefinitions="*,Auto">
                            <Label
                                FontAttributes="Bold"
                                Text="{Binding CostSummaryLabel}" />
                            <Label
                                Grid.Column="1"
                                FontAttributes="Bold"
                                Text="{Binding CostTotalText}" />
                        </Grid>
                        <Label
                            Style="{StaticResource RefinedHelperText}"
                            Text="ยังไม่ตัดเงินในขั้นตอนนี้" />
                        <Label
                            Style="{StaticResource RefinedHelperText}"
                            Text="ผู้ขายต้องตอบรับก่อน คุณจึงตรวจยอดสุดท้ายและชำระเงิน" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="{StaticResource SpacingSm}">
                    <controls:FormLabelView
                        IsRequired="True"
                        Text="สภาพสินค้า" />
                    <Grid
                        x:Name="ConditionPickerAnchor"
                        ColumnDefinitions="*,*"
                        RowDefinitions="Auto,Auto"
                        ColumnSpacing="{StaticResource SpacingSm}"
                        RowSpacing="{StaticResource SpacingSm}">
                        <Button
                            x:Name="NewConditionButton"
                            Style="{StaticResource RefinedSegmentButton}"
                            Command="{Binding SelectNewConditionCommand}"
                            FontSize="12"
                            Text="ใหม่">
                            <Button.Triggers>
                                <DataTrigger
                                    TargetType="Button"
                                    Binding="{Binding IsNewCondition}"
                                    Value="True">
                                    <Setter Property="BackgroundColor" Value="#EAF4FF" />
                                    <Setter Property="TextColor" Value="#145FC7" />
                                    <Setter Property="BorderColor" Value="#9CC9FF" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button
                            Grid.Column="1"
                            Style="{StaticResource RefinedSegmentButton}"
                            Command="{Binding SelectUsedGoodConditionCommand}"
                            FontSize="12"
                            Text="มือสอง สภาพดี">
                            <Button.Triggers>
                                <DataTrigger
                                    TargetType="Button"
                                    Binding="{Binding IsUsedGoodCondition}"
                                    Value="True">
                                    <Setter Property="BackgroundColor" Value="#EAF4FF" />
                                    <Setter Property="TextColor" Value="#145FC7" />
                                    <Setter Property="BorderColor" Value="#9CC9FF" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Style="{StaticResource RefinedSegmentButton}"
                            Command="{Binding SelectUsedDefectConditionCommand}"
                            FontSize="12"
                            Text="มีตำหนิ">
                            <Button.Triggers>
                                <DataTrigger
                                    TargetType="Button"
                                    Binding="{Binding IsUsedDefectCondition}"
                                    Value="True">
                                    <Setter Property="BackgroundColor" Value="#FFF1E8" />
                                    <Setter Property="TextColor" Value="#A94E16" />
                                    <Setter Property="BorderColor" Value="#F3C6A8" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </Grid>
                    <Label
                        IsVisible="{Binding HasConditionError}"
                        Style="{StaticResource RefinedValidationText}"
                        Text="{Binding ConditionError}" />
                    <VerticalStackLayout
                        IsVisible="{Binding HasDefectCondition}"
                        Spacing="{StaticResource SpacingSm}">
                        <controls:FormLabelView
                            IsRequired="True"
                            Text="ระบุตำหนิที่ผู้ขายควรรู้" />
                        <Border Style="{StaticResource RefinedEditorBorder}">
                            <Editor
                                x:Name="KnownDefectsEditor"
                                Style="{StaticResource RefinedEditor}"
                                AutoSize="TextChanges"
                                MaxLength="1000"
                                Placeholder="เช่น มีรอยมุมขวาตามรูป แต่ใช้งานปกติ"
                                Text="{Binding KnownDefects}" />
                        </Border>
                        <Label
                            IsVisible="{Binding HasKnownDefectsError}"
                            Style="{StaticResource RefinedValidationText}"
                            Text="{Binding KnownDefectsError}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <Border
                    IsVisible="{Binding HasMessage}"
                    Style="{StaticResource RefinedValidationBorder}">
                    <Label
                        Style="{StaticResource RefinedValidationText}"
                        Text="{Binding Message}" />
                </Border>

                <Button
                    x:Name="SubmitReviewedOfferButton"
                    AutomationId="SubmitReviewedOfferButton"
                    Style="{StaticResource RefinedPrimaryButton}"
                    Command="{Binding SubmitCommand}"
                    SemanticProperties.Description="ส่งข้อเสนอที่ตรวจแล้วให้ผู้ขาย"
                    Text="ส่งข้อเสนอให้ผู้ขาย">
                    <Button.Triggers>
                        <DataTrigger
                            TargetType="Button"
                            Binding="{Binding IsBusy}"
                            Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                            <Setter Property="Text" Value="กำลังสร้างข้อเสนอ..." />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button
                    Style="{StaticResource RefinedInlineButton}"
                    Command="{Binding PreviousStepCommand}"
                    Text="ย้อนกลับ: การรับสินค้า" />
            </VerticalStackLayout>
        </ScrollView>

        <Grid
            Grid.RowSpan="2"
            AutomationId="AiAgreementDraftSheet"
            IsVisible="{Binding IsAiSheetOpen}"
            BackgroundColor="#730F172A">
            <Border
                Margin="12,72,12,12"
                Padding="20"
                VerticalOptions="End"
                MaximumHeightRequest="720"
                BackgroundColor="White"
                Stroke="#D8E4F2"
                StrokeShape="RoundRectangle 24">
                <ScrollView>
                    <VerticalStackLayout Spacing="{StaticResource SpacingLg}">
                        <Grid
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="12">
                            <VerticalStackLayout Spacing="3">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="20"
                                    Text="ให้ AI ช่วยกรอก" />
                                <Label
                                    Style="{StaticResource RefinedHelperText}"
                                    Text="ใช้รูปหรือข้อความแชตเพื่อเตรียมข้อมูลร่าง" />
                            </VerticalStackLayout>
                            <Button
                                Grid.Column="1"
                                WidthRequest="44"
                                HeightRequest="44"
                                Padding="0"
                                BackgroundColor="#EEF3F8"
                                Command="{Binding CloseAiSheetCommand}"
                                CornerRadius="22"
                                SemanticProperties.Description="ปิดตัวช่วย AI"
                                Text="×"
                                TextColor="{StaticResource Ink}" />
                        </Grid>

                        <VerticalStackLayout
                            IsVisible="{Binding ShowAiSourceInput}"
                            Spacing="{StaticResource SpacingMd}">
                            <Button
                                AutomationId="PickAiSourcePhotoButton"
                                Style="{StaticResource RefinedSecondaryActionButton}"
                                Command="{Binding PickAiSourcePhotoCommand}"
                                Text="+  เลือกรูปหรือภาพแชต" />
                            <Label
                                IsVisible="{Binding HasAiSourcePhoto}"
                                Style="{StaticResource RefinedHelperText}"
                                Text="{Binding AiSourcePhotoName, StringFormat='เลือกแล้ว · {0}'}"
                                TextColor="{StaticResource Success}" />
                            <Border Style="{StaticResource RefinedEditorBorder}">
                                <Editor
                                    Style="{StaticResource RefinedEditor}"
                                    AutoSize="TextChanges"
                                    MaxLength="4000"
                                    Placeholder="วางข้อความที่ตกลงกัน เช่น สินค้า ราคา สภาพ และสิ่งที่รวม"
                                    Text="{Binding AiChatText}" />
                            </Border>
                            <Label
                                Style="{StaticResource RefinedHelperText}"
                                Text="AI ช่วยเตรียมข้อมูลเท่านั้น กรุณาอย่าใส่ OTP รหัสผ่าน หรือข้อมูลบัตร" />
                            <Button
                                AutomationId="AnalyzeAiAgreementDraftButton"
                                Style="{StaticResource RefinedPrimaryButton}"
                                Command="{Binding AnalyzeAiSourceCommand}"
                                Text="วิเคราะห์ข้อมูล">
                                <Button.Triggers>
                                    <DataTrigger
                                        TargetType="Button"
                                        Binding="{Binding IsAiAnalyzing}"
                                        Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                        <Setter Property="Text" Value="กำลังวิเคราะห์..." />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </VerticalStackLayout>

                        <VerticalStackLayout
                            IsVisible="{Binding HasAiDraft}"
                            Spacing="{StaticResource SpacingMd}">
                            <Label
                                FontFamily="NotoSansThaiMedium"
                                Text="ตรวจข้อมูลที่ AI พบ" />
                            <Border
                                Padding="14"
                                BackgroundColor="#F4F8FC"
                                Stroke="#D8E4F2"
                                StrokeShape="RoundRectangle 14">
                                <Label
                                    FontSize="13"
                                    LineHeight="1.45"
                                    Text="{Binding AiDraftSummary}" />
                            </Border>
                            <Label
                                Style="{StaticResource RefinedHelperText}"
                                Text="ระบบจะเติมเฉพาะช่องที่ยังว่าง และคุณแก้ไขได้ก่อนส่งให้ผู้ขาย" />
                            <Button
                                AutomationId="ApplyAiAgreementDraftButton"
                                Style="{StaticResource RefinedPrimaryButton}"
                                Command="{Binding ApplyAiDraftCommand}"
                                Text="เติมลงในแบบฟอร์ม" />
                        </VerticalStackLayout>

                        <Border
                            IsVisible="{Binding HasMessage}"
                            Style="{StaticResource RefinedValidationBorder}">
                            <Label
                                Style="{StaticResource RefinedValidationText}"
                                Text="{Binding Message}" />
                        </Border>
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
