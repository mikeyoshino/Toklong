<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Toklong.Mobile.Pages.CreateOfferPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Toklong.Mobile.Controls"
    Title="สร้างข้อเสนอ"
    SafeAreaEdges="Container"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False"
    BackgroundColor="#FBFDFF">

    <Grid RowDefinitions="Auto,*">
        <Border
            Grid.Row="0"
            AutomationId="CreateOfferHeader"
            Padding="20,12,20,20"
            BackgroundColor="White"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 28">
            <VerticalStackLayout Spacing="18">
                <Grid
                    ColumnDefinitions="48,*"
                    ColumnSpacing="16">
                    <Button
                        AutomationId="CreateOfferBackButton"
                        WidthRequest="48"
                        HeightRequest="48"
                        Padding="0"
                        BackgroundColor="{StaticResource SurfaceBlue}"
                        Clicked="OnBackClicked"
                        CornerRadius="14"
                        FontAttributes="Bold"
                        FontSize="28"
                        SemanticProperties.Description="ย้อนกลับ"
                        Text="‹"
                        TextColor="{StaticResource BrandBlueDeep}" />
                    <VerticalStackLayout
                        Grid.Column="1"
                        VerticalOptions="Center"
                        Spacing="1">
                        <Label
                            FontAttributes="Bold"
                            FontSize="26"
                            LineHeight="1.08"
                            Text="สร้างข้อเสนอ"
                            TextColor="{StaticResource Ink}" />
                        <Label
                            FontAttributes="None"
                            FontSize="14"
                            Text="ส่งให้ผู้ขายตรวจและตอบรับ"
                            TextColor="{StaticResource InkSoft}" />
                    </VerticalStackLayout>
                </Grid>
                <Grid
                    AutomationId="CreateOfferProgress"
                    ColumnDefinitions="*,*"
                    ColumnSpacing="10">
                    <BoxView
                        HeightRequest="4"
                        CornerRadius="2"
                        Color="{StaticResource BrandBlue}" />
                    <BoxView
                        Grid.Column="1"
                        HeightRequest="4"
                        CornerRadius="2"
                        Color="#DCE8F5" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <Grid Grid.Row="1">
            <ScrollView SafeAreaEdges="SoftInput">
                <VerticalStackLayout
                    AutomationId="QuickDealForm"
                    MaximumWidthRequest="720"
                    HorizontalOptions="Fill"
                    Padding="20,24,20,124"
                    Spacing="24">

                    <VerticalStackLayout
                        AutomationId="SellerPhoneSection"
                        Style="{StaticResource RefinedFormSection}">
                        <controls:FormLabelView
                            IsRequired="True"
                            Text="เบอร์โทรผู้ขาย" />
                        <Border Style="{StaticResource RefinedInputBorder}">
                            <controls:ThaiMobilePhoneEntry
                                Style="{StaticResource RefinedEntry}"
                                PhoneNumber="{Binding SellerPhoneNumber}"
                                Placeholder="เช่น 081-234-5678"
                                SemanticProperties.Description="เบอร์โทรศัพท์ของผู้ขาย" />
                        </Border>
                        <Label
                            Style="{StaticResource RefinedHelperText}"
                            Text="ข้อเสนอนี้เปิดและตอบรับได้เฉพาะบัญชีที่ยืนยันด้วยเบอร์นี้" />
                    </VerticalStackLayout>

                    <VerticalStackLayout
                        AutomationId="ProductNameSection"
                        Style="{StaticResource RefinedFormSection}">
                        <controls:FormLabelView
                            IsRequired="True"
                            Text="ชื่อสินค้า" />
                        <Border Style="{StaticResource RefinedInputBorder}">
                            <Entry
                                Style="{StaticResource RefinedEntry}"
                                MaxLength="180"
                                Placeholder="เช่น กล้อง Fujifilm X-T30 II"
                                SemanticProperties.Description="ชื่อสินค้า"
                                Text="{Binding ProductName}" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout
                        AutomationId="ItemPriceSection"
                        Style="{StaticResource RefinedFormSection}">
                        <Grid
                            ColumnDefinitions="24,*"
                            ColumnSpacing="{StaticResource SpacingSm}">
                            <Image
                                WidthRequest="20"
                                HeightRequest="20"
                                VerticalOptions="Center"
                                Source="ui_money.png" />
                            <controls:FormLabelView
                                Grid.Column="1"
                                IsRequired="True"
                                VerticalOptions="Center"
                                Text="ราคาสินค้า" />
                        </Grid>
                        <Border Style="{StaticResource RefinedAmountBorder}">
                            <Grid
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="{StaticResource SpacingSm}">
                                <Label
                                    VerticalOptions="Center"
                                    FontAttributes="Bold"
                                    FontSize="20"
                                    Text="฿"
                                    TextColor="{StaticResource BrandBlueDeep}" />
                                <Entry
                                    x:Name="AmountEntry"
                                    Grid.Column="1"
                                    Style="{StaticResource RefinedAmountEntry}"
                                    Keyboard="Numeric"
                                    Placeholder="0.00"
                                    SemanticProperties.Description="ราคาสินค้าเป็นบาท"
                                    Text="{Binding AmountBaht}" />
                            </Grid>
                        </Border>
                        <Label
                            Style="{StaticResource RefinedHelperText}"
                            Text="ระบบจะคำนวณค่าจัดส่งให้ผู้ซื้อดูก่อนชำระ" />
                    </VerticalStackLayout>

                    <VerticalStackLayout
                        AutomationId="DeliveryAddressSection"
                        IsVisible="{Binding IsPhysical}"
                        Style="{StaticResource RefinedFormSection}">
                        <controls:FormLabelView
                            IsRequired="True"
                            Text="ที่อยู่จัดส่ง" />

                        <Border
                            IsVisible="{Binding ShowSavedAddressSummary}"
                            Padding="16"
                            BackgroundColor="White"
                            Stroke="{StaticResource Line}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 18">
                            <VerticalStackLayout Spacing="6">
                                <Grid
                                    ColumnDefinitions="*,Auto"
                                    ColumnSpacing="12">
                                    <Label
                                        VerticalOptions="Center"
                                        FontFamily="NotoSansThaiMedium"
                                        FontAttributes="None"
                                        FontSize="16"
                                        Text="{Binding SavedAddress}"
                                        TextColor="{StaticResource Ink}" />
                                    <Button
                                        Grid.Column="1"
                                        Style="{StaticResource RefinedInlineButton}"
                                        Command="{Binding EditAddressCommand}"
                                        FontAttributes="None"
                                        SemanticProperties.Description="เปลี่ยนที่อยู่จัดส่ง"
                                        Text="เปลี่ยนที่อยู่" />
                                </Grid>
                                <Label
                                    Style="{StaticResource RefinedHelperText}"
                                    Text="ผู้ขายจะเห็นเฉพาะจังหวัดและรหัสไปรษณีย์จนกว่าระบบยืนยันยอดชำระ" />
                            </VerticalStackLayout>
                        </Border>

                        <VerticalStackLayout
                            IsVisible="{Binding ShowAddressEditor}"
                            Spacing="{StaticResource SpacingMd}">
                            <Label
                                Style="{StaticResource RefinedHelperText}"
                                Text="เลือกให้เสร็จก่อนส่งข้อเสนอ ผู้ขายจะเห็นเฉพาะจังหวัดและรหัสไปรษณีย์จนกว่าระบบยืนยันยอดชำระ" />
                            <Button
                                IsVisible="{Binding HasSavedAddress}"
                                Style="{StaticResource RefinedSecondaryActionButton}"
                                Command="{Binding UseSavedAddressCommand}"
                                Text="ใช้ที่อยู่เดิม" />
                            <Border Style="{StaticResource RefinedInputBorder}">
                                <Entry
                                    Style="{StaticResource RefinedEntry}"
                                    MaxLength="500"
                                    Placeholder="บ้านเลขที่ ถนน อาคาร หรือหมู่บ้าน"
                                    Text="{Binding AddressLine}" />
                            </Border>
                            <Border Style="{StaticResource RefinedInputBorder}">
                                <Picker
                                    Style="{StaticResource RefinedPicker}"
                                    ItemDisplayBinding="{Binding Name}"
                                    ItemsSource="{Binding Provinces}"
                                    SelectedItem="{Binding SelectedProvince}"
                                    Title="เลือกจังหวัดปลายทาง" />
                            </Border>
                            <Border Style="{StaticResource RefinedInputBorder}">
                                <Picker
                                    Style="{StaticResource RefinedPicker}"
                                    ItemDisplayBinding="{Binding Name}"
                                    ItemsSource="{Binding Districts}"
                                    SelectedItem="{Binding SelectedDistrict}"
                                    Title="เลือกอำเภอหรือเขต" />
                            </Border>
                            <Border Style="{StaticResource RefinedInputBorder}">
                                <Picker
                                    Style="{StaticResource RefinedPicker}"
                                    ItemDisplayBinding="{Binding Name}"
                                    ItemsSource="{Binding Subdistricts}"
                                    SelectedItem="{Binding SelectedSubdistrict}"
                                    Title="เลือกตำบลหรือแขวง" />
                            </Border>
                            <HorizontalStackLayout Spacing="5">
                                <CheckBox
                                    MinimumWidthRequest="{StaticResource CompactControlMinimumHeight}"
                                    MinimumHeightRequest="{StaticResource CompactControlMinimumHeight}"
                                    Color="{StaticResource BrandBlue}"
                                    IsChecked="{Binding RememberAddress}" />
                                <Label
                                    VerticalOptions="Center"
                                    FontAttributes="None"
                                    FontSize="12"
                                    Text="จำที่อยู่นี้ไว้สำหรับดีลถัดไป" />
                            </HorizontalStackLayout>
                            <Label
                                Style="{StaticResource RefinedHelperText}"
                                Text="{Binding DeliveryRegionText}"
                                TextColor="{StaticResource BrandBlueDeep}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <VerticalStackLayout
                        AutomationId="SecondaryOfferOptions"
                        Spacing="0">
                        <Button
                            AutomationId="OpenAiAgreementDraftButton"
                            Margin="0,0,0,8"
                            Style="{StaticResource RefinedSecondaryActionButton}"
                            Command="{Binding OpenAiSheetCommand}"
                            ContentLayout="Left,10"
                            ImageSource="ui_ai_assist.png"
                            SemanticProperties.Description="ให้ AI ช่วยกรอกข้อมูลจากรูปหรือข้อความแชต"
                            Text="ให้ AI ช่วยกรอก" />

                        <Border
                            Padding="4,14"
                            BackgroundColor="Transparent"
                            Stroke="{StaticResource Line}"
                            StrokeThickness="0"
                            SemanticProperties.Description="เปลี่ยนประเภทสินค้า">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding ToggleFulfillmentCommand}" />
                            </Border.GestureRecognizers>
                            <Grid
                                ColumnDefinitions="28,*,Auto"
                                ColumnSpacing="{StaticResource SpacingSm}">
                                <Image
                                    WidthRequest="20"
                                    HeightRequest="20"
                                    VerticalOptions="Center"
                                    Source="ui_offer.png" />
                                <Label
                                    Grid.Column="1"
                                    VerticalOptions="Center"
                                    FontFamily="NotoSansThaiMedium"
                                    FontAttributes="None"
                                    FontSize="15"
                                    Text="ประเภทสินค้า"
                                    TextColor="{StaticResource Ink}" />
                                <HorizontalStackLayout
                                    Grid.Column="2"
                                    VerticalOptions="Center"
                                    Spacing="6">
                                    <Label
                                        VerticalOptions="Center"
                                        FontAttributes="None"
                                        FontSize="14"
                                        Text="{Binding FulfillmentTypeLabel}"
                                        TextColor="{StaticResource Muted}" />
                                    <Label
                                        VerticalOptions="Center"
                                        FontSize="18"
                                        Text="›"
                                        TextColor="#98A2B3" />
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>

                        <VerticalStackLayout
                            AutomationId="OptionalProductPhotoField"
                            Padding="4,14"
                            Spacing="{StaticResource SpacingSm}">
                            <Grid
                                ColumnDefinitions="28,*"
                                ColumnSpacing="{StaticResource SpacingSm}">
                                <Image
                                    WidthRequest="20"
                                    HeightRequest="20"
                                    VerticalOptions="Center"
                                    Source="ui_camera.png" />
                                <controls:FormLabelView
                                    Grid.Column="1"
                                    VerticalOptions="Center"
                                    Text="รูปสินค้า (ไม่บังคับ)" />
                            </Grid>
                            <Label
                                Style="{StaticResource RefinedHelperText}"
                                Text="แนะนำสำหรับสินค้ามือสองหรือสินค้าที่ต้องตรวจสภาพ" />
                            <Button
                                Style="{StaticResource RefinedSecondaryActionButton}"
                                Command="{Binding PickPhotoCommand}"
                                SemanticProperties.Description="เลือกรูปสินค้าหรือรูปตำหนิ"
                                Text="+  ถ่ายหรือเลือกรูป">
                                <Button.Triggers>
                                    <DataTrigger
                                        TargetType="Button"
                                        Binding="{Binding IsBusy}"
                                        Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <Border
                                IsVisible="{Binding HasPhoto}"
                                Padding="12,8"
                                BackgroundColor="{StaticResource SuccessSoft}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12">
                                <Label
                                    FontAttributes="None"
                                    FontSize="13"
                                    Text="{Binding SelectedPhotoName, StringFormat='เพิ่มแล้ว · {0}'}"
                                    TextColor="{StaticResource Success}" />
                            </Border>
                        </VerticalStackLayout>

                        <Border
                            AutomationId="OptionalDealDetailsDisclosure"
                            Padding="4,14"
                            BackgroundColor="Transparent"
                            Stroke="{StaticResource Line}"
                            StrokeThickness="0"
                            SemanticProperties.Description="เพิ่มหรือซ่อนรายละเอียดสินค้าเพิ่มเติม"
                            SemanticProperties.Hint="แตะเพื่อเปิดหรือปิด">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding ToggleOptionalDetailsCommand}" />
                            </Border.GestureRecognizers>
                            <Grid
                                ColumnDefinitions="28,*,Auto"
                                ColumnSpacing="{StaticResource SpacingSm}">
                                <Image
                                    WidthRequest="20"
                                    HeightRequest="20"
                                    VerticalOptions="Center"
                                    Source="ui_note.png" />
                                <VerticalStackLayout
                                    Grid.Column="1"
                                    VerticalOptions="Center"
                                    Spacing="2">
                                    <Label
                                        FontFamily="NotoSansThaiMedium"
                                        FontAttributes="None"
                                        FontSize="15"
                                        Text="{Binding OptionalDetailsLabel}"
                                        TextColor="{StaticResource Ink}" />
                                    <Label
                                        Style="{StaticResource RefinedHelperText}"
                                        LineBreakMode="TailTruncation"
                                        MaxLines="1"
                                        Text="{Binding OptionalDetailsSummary}" />
                                </VerticalStackLayout>
                                <Label
                                    Grid.Column="2"
                                    MinimumWidthRequest="32"
                                    VerticalOptions="Center"
                                    HorizontalTextAlignment="Center"
                                    FontAttributes="None"
                                    FontSize="17"
                                    Text="{Binding OptionalDetailsChevron}"
                                    TextColor="{StaticResource BrandBlueDeep}" />
                            </Grid>
                        </Border>
                        <VerticalStackLayout
                            IsVisible="{Binding ShowOptionalDetails}"
                            Padding="4,8,4,0"
                            Spacing="{StaticResource SpacingSm}">
                            <Border Style="{StaticResource RefinedEditorBorder}">
                                <Editor
                                    Style="{StaticResource RefinedEditor}"
                                    AutoSize="TextChanges"
                                    Placeholder="เช่น อุปกรณ์ที่ให้มาด้วย รุ่น สี หรือรายละเอียดอื่น"
                                    SemanticProperties.Description="รายละเอียดหรือสิ่งที่รวมเพิ่มเติม"
                                    Text="{Binding AgreementDetails}" />
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <Border
                        IsVisible="{Binding HasMessage}"
                        Style="{StaticResource RefinedValidationBorder}">
                        <Label
                            Style="{StaticResource RefinedValidationText}"
                            Text="{Binding Message}" />
                    </Border>
                </VerticalStackLayout>
            </ScrollView>

            <Border
                AutomationId="CreateOfferPrimaryActionBar"
                Padding="20,12,20,28"
                VerticalOptions="End"
                BackgroundColor="White"
                Stroke="{StaticResource Line}"
                StrokeThickness="1">
                <Button
                    AutomationId="ReviewQuickDealButton"
                    Style="{StaticResource RefinedPrimaryButton}"
                    Command="{Binding ReviewCommand}"
                    SemanticProperties.Description="ตรวจข้อมูลข้อตกลงก่อนส่งให้ผู้ขาย"
                    Text="ตรวจข้อมูลก่อนส่ง  →">
                    <Button.Triggers>
                        <DataTrigger
                            TargetType="Button"
                            Binding="{Binding IsBusy}"
                            Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                        <DataTrigger
                            TargetType="Button"
                            Binding="{Binding IsReviewPricing}"
                            Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                            <Setter Property="Text" Value="กำลังคำนวณค่าใช้จ่าย..." />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </Border>
        </Grid>

        <Grid
            Grid.RowSpan="2"
            AutomationId="QuickDealReviewSheet"
            IsVisible="{Binding IsReviewSheetOpen}"
            BackgroundColor="#730F172A">
            <Border
                Margin="12,72,12,12"
                Padding="20"
                VerticalOptions="End"
                MaximumHeightRequest="720"
                BackgroundColor="White"
                Stroke="#D8E4F2"
                StrokeShape="RoundRectangle 24">
                <ScrollView>
                    <VerticalStackLayout Spacing="{StaticResource SpacingLg}">
                        <Grid
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="12">
                            <VerticalStackLayout Spacing="3">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="21"
                                    Text="ตรวจข้อมูลก่อนส่ง" />
                                <Label
                                    Style="{StaticResource RefinedHelperText}"
                                    Text="เลือกสภาพสินค้า แล้วตรวจสิ่งที่จะส่งให้ผู้ขาย" />
                            </VerticalStackLayout>
                            <Button
                                Grid.Column="1"
                                WidthRequest="44"
                                HeightRequest="44"
                                Padding="0"
                                BackgroundColor="#EEF3F8"
                                Command="{Binding CloseReviewCommand}"
                                CornerRadius="22"
                                FontSize="18"
                                SemanticProperties.Description="ปิดหน้าตรวจข้อมูล"
                                Text="×"
                                TextColor="{StaticResource Ink}" />
                        </Grid>

                        <Border
                            Padding="14"
                            BackgroundColor="#F4F8FC"
                            Stroke="#D8E4F2"
                            StrokeShape="RoundRectangle 14">
                            <Label
                                FontAttributes="None"
                                FontSize="13"
                                LineHeight="1.5"
                                Text="{Binding ReviewSummary}"
                                TextColor="{StaticResource Ink}" />
                        </Border>

                        <Border
                            AutomationId="ReviewCostSummary"
                            Padding="16"
                            BackgroundColor="#FBFDFF"
                            Stroke="{StaticResource Line}"
                            StrokeShape="RoundRectangle 16"
                            SemanticProperties.Description="สรุปค่าใช้จ่ายก่อนส่งข้อเสนอ">
                            <VerticalStackLayout Spacing="{StaticResource SpacingMd}">
                                <Label
                                    FontFamily="NotoSansThaiMedium"
                                    FontAttributes="None"
                                    FontSize="16"
                                    Text="สรุปค่าใช้จ่าย"
                                    TextColor="{StaticResource Ink}" />
                                <Grid
                                    ColumnDefinitions="*,Auto"
                                    ColumnSpacing="12">
                                    <Label
                                        FontAttributes="None"
                                        FontSize="13"
                                        Text="ราคาสินค้า"
                                        TextColor="{StaticResource InkSoft}" />
                                    <Label
                                        Grid.Column="1"
                                        FontAttributes="None"
                                        FontSize="14"
                                        Text="{Binding CostItemPriceText}"
                                        TextColor="{StaticResource Ink}" />
                                </Grid>
                                <Border
                                    Padding="12"
                                    BackgroundColor="#EAF4FF"
                                    Stroke="#B8D9FF"
                                    StrokeShape="RoundRectangle 14">
                                    <Grid
                                        ColumnDefinitions="*,Auto"
                                        ColumnSpacing="12">
                                        <VerticalStackLayout Spacing="2">
                                            <Label
                                                FontAttributes="None"
                                                FontSize="13"
                                                Text="ค่าคุ้มครองผู้ซื้อ"
                                                TextColor="{StaticResource BrandBlueDeep}" />
                                            <Label
                                                FontAttributes="None"
                                                FontSize="12"
                                                LineHeight="1.3"
                                                Text="ช่วยดูแลเมื่อไม่ได้รับของ ของเสียหาย หรือไม่ตรงตามที่ตกลง"
                                                TextColor="{StaticResource Muted}" />
                                        </VerticalStackLayout>
                                        <Label
                                            Grid.Column="1"
                                            VerticalOptions="Center"
                                            FontAttributes="None"
                                            FontSize="14"
                                            Text="{Binding CostProtectionFeeText}"
                                            TextColor="{StaticResource BrandBlueDeep}" />
                                    </Grid>
                                </Border>
                                <Grid
                                    ColumnDefinitions="*,Auto"
                                    ColumnSpacing="12">
                                    <Label
                                        FontAttributes="None"
                                        FontSize="13"
                                        Text="ค่าจัดส่ง"
                                        TextColor="{StaticResource InkSoft}" />
                                    <Label
                                        Grid.Column="1"
                                        FontAttributes="None"
                                        FontSize="13"
                                        Text="{Binding CostShippingText}"
                                        TextColor="{StaticResource Ink}" />
                                </Grid>
                                <BoxView
                                    HeightRequest="1"
                                    Color="{StaticResource Line}" />
                                <Grid
                                    ColumnDefinitions="*,Auto"
                                    ColumnSpacing="12">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="16"
                                        Text="{Binding CostSummaryLabel}"
                                        TextColor="{StaticResource Ink}" />
                                    <Label
                                        Grid.Column="1"
                                        FontAttributes="Bold"
                                        FontSize="18"
                                        Text="{Binding CostTotalText}"
                                        TextColor="{StaticResource Ink}" />
                                </Grid>
                                <Label
                                    FontAttributes="None"
                                    FontSize="12"
                                    Text="ยังไม่ตัดเงินในขั้นตอนนี้"
                                    TextColor="{StaticResource InkSoft}" />
                                <Label
                                    FontAttributes="None"
                                    FontSize="12"
                                    Text="คุณจะตรวจยอดสุดท้ายอีกครั้งก่อนชำระเงิน"
                                    TextColor="{StaticResource Muted}" />
                            </VerticalStackLayout>
                        </Border>

                        <VerticalStackLayout Spacing="{StaticResource SpacingSm}">
                            <controls:FormLabelView
                                IsRequired="True"
                                Text="สภาพสินค้า" />
                            <Grid
                                ColumnDefinitions="*,*,*"
                                ColumnSpacing="{StaticResource SpacingSm}">
                                <Button
                                    Style="{StaticResource RefinedSegmentButton}"
                                    Command="{Binding SelectNewConditionCommand}"
                                    FontSize="12"
                                    SemanticProperties.Description="เลือกสินค้าใหม่"
                                    Text="ใหม่">
                                    <Button.Triggers>
                                        <DataTrigger
                                            TargetType="Button"
                                            Binding="{Binding IsNewCondition}"
                                            Value="True">
                                            <Setter Property="BackgroundColor" Value="#EAF4FF" />
                                            <Setter Property="TextColor" Value="#145FC7" />
                                            <Setter Property="BorderColor" Value="#9CC9FF" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                                <Button
                                    Grid.Column="1"
                                    Style="{StaticResource RefinedSegmentButton}"
                                    Command="{Binding SelectUsedGoodConditionCommand}"
                                    FontSize="12"
                                    SemanticProperties.Description="เลือกสินค้ามือสองสภาพดี"
                                    Text="มือสอง สภาพดี">
                                    <Button.Triggers>
                                        <DataTrigger
                                            TargetType="Button"
                                            Binding="{Binding IsUsedGoodCondition}"
                                            Value="True">
                                            <Setter Property="BackgroundColor" Value="#EAF4FF" />
                                            <Setter Property="TextColor" Value="#145FC7" />
                                            <Setter Property="BorderColor" Value="#9CC9FF" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                                <Button
                                    Grid.Column="2"
                                    Style="{StaticResource RefinedSegmentButton}"
                                    Command="{Binding SelectUsedDefectConditionCommand}"
                                    FontSize="12"
                                    SemanticProperties.Description="เลือกสินค้ามือสองมีตำหนิ"
                                    Text="มีตำหนิ">
                                    <Button.Triggers>
                                        <DataTrigger
                                            TargetType="Button"
                                            Binding="{Binding IsUsedDefectCondition}"
                                            Value="True">
                                            <Setter Property="BackgroundColor" Value="#FFF1E8" />
                                            <Setter Property="TextColor" Value="#A94E16" />
                                            <Setter Property="BorderColor" Value="#F3C6A8" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                            </Grid>
                            <VerticalStackLayout
                                IsVisible="{Binding HasDefectCondition}"
                                Spacing="{StaticResource SpacingSm}">
                                <controls:FormLabelView
                                    IsRequired="True"
                                    Text="ระบุตำหนิที่ผู้ขายควรรู้" />
                                <Border Style="{StaticResource RefinedEditorBorder}">
                                    <Editor
                                        Style="{StaticResource RefinedEditor}"
                                        AutoSize="TextChanges"
                                        MaxLength="1000"
                                        Placeholder="เช่น มีรอยมุมขวาตามรูป แต่ใช้งานปกติ"
                                        SemanticProperties.Description="รายละเอียดตำหนิสินค้า"
                                        Text="{Binding KnownDefects}" />
                                </Border>
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                        <Border
                            IsVisible="{Binding HasMessage}"
                            Style="{StaticResource RefinedValidationBorder}">
                            <Label
                                Style="{StaticResource RefinedValidationText}"
                                Text="{Binding Message}" />
                        </Border>

                        <Button
                            AutomationId="SubmitReviewedOfferButton"
                            Style="{StaticResource RefinedPrimaryButton}"
                            Command="{Binding SubmitCommand}"
                            SemanticProperties.Description="ส่งข้อเสนอที่ตรวจแล้วให้ผู้ขาย"
                            Text="ส่งข้อเสนอให้ผู้ขาย">
                            <Button.Triggers>
                                <DataTrigger
                                    TargetType="Button"
                                    Binding="{Binding IsBusy}"
                                    Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                    <Setter Property="Text" Value="กำลังสร้างลิงก์..." />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button
                            Style="{StaticResource RefinedSecondaryActionButton}"
                            Command="{Binding CloseReviewCommand}"
                            Text="กลับไปแก้ไข" />
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>

        <Grid
            Grid.RowSpan="2"
            AutomationId="AiAgreementDraftSheet"
            IsVisible="{Binding IsAiSheetOpen}"
            BackgroundColor="#730F172A">
            <Border
                Margin="12,72,12,12"
                Padding="20"
                VerticalOptions="End"
                MaximumHeightRequest="720"
                BackgroundColor="White"
                Stroke="#D8E4F2"
                StrokeShape="RoundRectangle 24">
                <ScrollView>
                    <VerticalStackLayout Spacing="{StaticResource SpacingLg}">
                        <Grid
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="12">
                            <VerticalStackLayout Spacing="3">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="20"
                                    Text="ให้ AI ช่วยกรอก" />
                                <Label
                                    Style="{StaticResource RefinedHelperText}"
                                    Text="ใช้รูปหรือข้อความแชตเพื่อเตรียมข้อมูลร่าง" />
                            </VerticalStackLayout>
                            <Button
                                Grid.Column="1"
                                WidthRequest="44"
                                HeightRequest="44"
                                Padding="0"
                                BackgroundColor="#EEF3F8"
                                Command="{Binding CloseAiSheetCommand}"
                                CornerRadius="22"
                                FontSize="18"
                                SemanticProperties.Description="ปิดตัวช่วย AI"
                                Text="×"
                                TextColor="{StaticResource Ink}" />
                        </Grid>

                        <VerticalStackLayout
                            IsVisible="{Binding ShowAiSourceInput}"
                            Spacing="{StaticResource SpacingMd}">
                            <Button
                                AutomationId="PickAiSourcePhotoButton"
                                Style="{StaticResource RefinedSecondaryActionButton}"
                                Command="{Binding PickAiSourcePhotoCommand}"
                                Text="+  เลือกรูปหรือภาพแชต" />
                            <Label
                                IsVisible="{Binding HasAiSourcePhoto}"
                                FontAttributes="None"
                                FontSize="13"
                                Text="{Binding AiSourcePhotoName, StringFormat='เลือกแล้ว · {0}'}"
                                TextColor="{StaticResource Success}" />
                            <Grid
                                ColumnDefinitions="*,Auto,*"
                                ColumnSpacing="{StaticResource SpacingSm}">
                                <BoxView
                                    HeightRequest="1"
                                    VerticalOptions="Center"
                                    Color="{StaticResource Line}" />
                                <Label
                                    Grid.Column="1"
                                    FontAttributes="None"
                                    FontSize="12"
                                    Text="หรือ"
                                    TextColor="{StaticResource Muted}" />
                                <BoxView
                                    Grid.Column="2"
                                    HeightRequest="1"
                                    VerticalOptions="Center"
                                    Color="{StaticResource Line}" />
                            </Grid>
                            <Border Style="{StaticResource RefinedEditorBorder}">
                                <Editor
                                    Style="{StaticResource RefinedEditor}"
                                    AutoSize="TextChanges"
                                    MaxLength="4000"
                                    Placeholder="วางข้อความที่ตกลงกัน เช่น สินค้า ราคา สภาพ และสิ่งที่รวม"
                                    SemanticProperties.Description="ข้อความแชตสำหรับให้ AI ช่วยกรอก"
                                    Text="{Binding AiChatText}" />
                            </Border>
                            <Label
                                Style="{StaticResource RefinedHelperText}"
                                LineHeight="1.35"
                                Text="AI ช่วยเตรียมข้อมูลเท่านั้น กรุณาอย่าใส่ OTP รหัสผ่าน หรือข้อมูลบัตร" />
                            <Button
                                AutomationId="AnalyzeAiAgreementDraftButton"
                                Style="{StaticResource RefinedPrimaryButton}"
                                Command="{Binding AnalyzeAiSourceCommand}"
                                Text="วิเคราะห์ข้อมูล">
                                <Button.Triggers>
                                    <DataTrigger
                                        TargetType="Button"
                                        Binding="{Binding IsAiAnalyzing}"
                                        Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                        <Setter Property="Text" Value="กำลังวิเคราะห์..." />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <ActivityIndicator
                                IsRunning="{Binding IsAiAnalyzing}"
                                IsVisible="{Binding IsAiAnalyzing}"
                                Color="{StaticResource BrandBlue}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout
                            IsVisible="{Binding HasAiDraft}"
                            Spacing="{StaticResource SpacingMd}">
                            <Label
                                FontAttributes="None"
                                FontSize="16"
                                Text="ตรวจข้อมูลที่ AI พบ" />
                            <Border
                                Padding="14"
                                BackgroundColor="#F4F8FC"
                                Stroke="#D8E4F2"
                                StrokeShape="RoundRectangle 14">
                                <Label
                                    FontAttributes="None"
                                    FontSize="13"
                                    LineHeight="1.45"
                                    Text="{Binding AiDraftSummary}" />
                            </Border>
                            <Label
                                Style="{StaticResource RefinedHelperText}"
                                Text="ระบบจะเติมเฉพาะช่องที่ยังว่าง และคุณแก้ไขได้ก่อนส่งให้ผู้ขาย" />
                            <Button
                                AutomationId="ApplyAiAgreementDraftButton"
                                Style="{StaticResource RefinedPrimaryButton}"
                                Command="{Binding ApplyAiDraftCommand}"
                                Text="เติมลงในแบบฟอร์ม" />
                        </VerticalStackLayout>

                        <Border
                            IsVisible="{Binding HasMessage}"
                            Style="{StaticResource RefinedValidationBorder}">
                            <Label
                                Style="{StaticResource RefinedValidationText}"
                                Text="{Binding Message}" />
                        </Border>
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
