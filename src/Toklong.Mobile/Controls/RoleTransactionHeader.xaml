<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="Toklong.Mobile.Controls.RoleTransactionHeader"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Border
        Padding="18"
        StrokeThickness="0"
        StrokeShape="RoundRectangle 22">
        <Border.Shadow>
            <Shadow
                Brush="{Binding Transaction.RoleColor, Source={x:Reference Root}, FallbackValue=#12364F, TargetNullValue=#12364F}"
                Offset="0,8"
                Opacity="0.14"
                Radius="20" />
        </Border.Shadow>
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop
                    Color="{Binding Transaction.RoleHeaderStart, Source={x:Reference Root}, FallbackValue=#12364F, TargetNullValue=#12364F}"
                    Offset="0" />
                <GradientStop
                    Color="{Binding Transaction.RoleHeaderMiddle, Source={x:Reference Root}, FallbackValue=#14608A, TargetNullValue=#14608A}"
                    Offset="0.62" />
                <GradientStop
                    Color="{Binding Transaction.RoleHeaderEnd, Source={x:Reference Root}, FallbackValue=#1988D3, TargetNullValue=#1988D3}"
                    Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <VerticalStackLayout Spacing="12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <HorizontalStackLayout Spacing="8">
                    <BoxView
                        WidthRequest="7"
                        HeightRequest="7"
                        VerticalOptions="Center"
                        Color="{Binding Transaction.RoleDot, Source={x:Reference Root}}"
                        CornerRadius="4" />
                    <Label
                        FontAttributes="Bold"
                        FontSize="12"
                        Text="{Binding Transaction.RoleLabel, Source={x:Reference Root}, StringFormat='รายการ{0}'}"
                        TextColor="#DFFFFFFF" />
                </HorizontalStackLayout>
                <Border
                    Grid.Column="1"
                    Padding="9,5"
                    HorizontalOptions="End"
                    BackgroundColor="#24FFFFFF"
                    Stroke="#30FFFFFF"
                    StrokeShape="RoundRectangle 99">
                    <Label
                        FontAttributes="Bold"
                        FontSize="12"
                        Text="{Binding Transaction.StatusLabel, Source={x:Reference Root}}"
                        TextColor="White" />
                </Border>
            </Grid>

            <Label
                FontAttributes="Bold"
                FontSize="21"
                LineBreakMode="TailTruncation"
                MaxLines="2"
                Text="{Binding Transaction.ProductName, Source={x:Reference Root}}"
                TextColor="White" />

            <VerticalStackLayout Spacing="2">
                <Label
                    FontSize="12"
                    Text="{Binding Transaction.RoleAmountLabel, Source={x:Reference Root}}"
                    TextColor="{Binding Transaction.RoleHeaderSecondary, Source={x:Reference Root}}" />
                <Label
                    FontAttributes="Bold"
                    FontSize="27"
                    CharacterSpacing="-0.5"
                    Text="{Binding Transaction.RoleAmountText, Source={x:Reference Root}}"
                    TextColor="White" />
            </VerticalStackLayout>

            <BoxView HeightRequest="1" Color="#24FFFFFF" />
            <VerticalStackLayout Spacing="3">
                <Label
                    FontSize="12"
                    LineBreakMode="WordWrap"
                    Text="{Binding Transaction.CounterpartyLabel, Source={x:Reference Root}}"
                    TextColor="{Binding Transaction.RoleHeaderSecondary, Source={x:Reference Root}}" />
                <Label
                    FontAttributes="Bold"
                    FontSize="12"
                    LineBreakMode="WordWrap"
                    Text="{Binding Transaction.DeadlineText, Source={x:Reference Root}}"
                    TextColor="White" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </Border>
</ContentView>
