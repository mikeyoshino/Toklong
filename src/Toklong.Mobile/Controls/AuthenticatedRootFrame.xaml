<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="Toklong.Mobile.Controls.AuthenticatedRootFrame"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Grid RowDefinitions="*,Auto">
        <ContentView
            x:Name="BodyHost"
            BackgroundColor="{StaticResource CleanLedgerRootBackground}"
            SafeAreaEdges="Container"
            Content="{Binding Body, Source={x:Reference Root}}" />

        <Grid
            AutomationId="AuthenticatedNavigationDock"
            Grid.Row="1"
            MaximumWidthRequest="520"
            HorizontalOptions="Fill"
            BackgroundColor="{StaticResource Surface}"
            SafeAreaEdges="Container">
            <BoxView
                HeightRequest="22"
                VerticalOptions="Start"
                Color="{StaticResource CleanLedgerRootBackground}" />
            <Border
                Margin="0,22,0,0"
                Padding="20,6,20,8"
                MinimumHeightRequest="62"
                BackgroundColor="{StaticResource Surface}"
                Stroke="{StaticResource Line}"
                StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="26,26,0,0" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow
                        Brush="#1A12364F"
                        Offset="0,-3"
                        Opacity="0.12"
                        Radius="14" />
                </Border.Shadow>
            </Border>

            <Grid ColumnDefinitions="*,84,*" ColumnSpacing="4" Padding="20,0">
                <Button
                    x:Name="BuyButton"
                    MaximumWidthRequest="88"
                    MinimumHeightRequest="48"
                    HorizontalOptions="Center"
                    VerticalOptions="End"
                    Margin="0,0,0,8"
                    Padding="8,3"
                    BackgroundColor="Transparent"
                    Command="{Binding OpenBuyingCommand, Source={x:Reference Root}}"
                    ContentLayout="Top,2"
                    CornerRadius="14"
                    FontAttributes="Bold"
                    FontSize="11"
                    ImageSource="nav_buy.png"
                    SemanticProperties.Description="ซื้อ"
                    Text="ซื้อ"
                    TextColor="{StaticResource TrustNavy}" />

                <Grid
                    Grid.Column="1"
                    WidthRequest="80"
                    MinimumHeightRequest="83"
                    HorizontalOptions="Center"
                    RowDefinitions="65,Auto">
                    <Border
                        WidthRequest="74"
                        HeightRequest="74"
                        HorizontalOptions="Center"
                        VerticalOptions="Start"
                        BackgroundColor="{StaticResource Surface}"
                        Stroke="{StaticResource Line}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 37">
                        <Border.Shadow>
                            <Shadow
                                Brush="#2412364F"
                                Offset="0,-2"
                                Opacity="0.16"
                                Radius="10" />
                        </Border.Shadow>
                    </Border>
                    <Grid
                        WidthRequest="58"
                        HeightRequest="58"
                        HorizontalOptions="Center"
                        VerticalOptions="Start"
                        Margin="0,5,0,0">
                        <Border
                            x:Name="CreateActionVisual"
                            WidthRequest="58"
                            HeightRequest="58"
                            HorizontalOptions="Center"
                            VerticalOptions="Start"
                            BackgroundColor="{StaticResource TrustNavy}"
                            Stroke="{StaticResource VerifiedMint}"
                            StrokeThickness="2"
                            StrokeShape="RoundRectangle 29">
                            <Label
                                AutomationProperties.IsInAccessibleTree="False"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center"
                                FontAttributes="Bold"
                                FontSize="26"
                                Text="+"
                                TextColor="{StaticResource VerifiedMint}" />
                        </Border>
                    </Grid>
                    <Label
                        Grid.Row="1"
                        AutomationProperties.IsInAccessibleTree="False"
                        HorizontalTextAlignment="Center"
                        VerticalTextAlignment="Center"
                        InputTransparent="True"
                        FontAttributes="Bold"
                        FontSize="11"
                        Text="สร้างดีล"
                        TranslationY="10"
                        TextColor="{StaticResource TrustNavy}" />
                    <Button
                        x:Name="CreateButton"
                        Grid.RowSpan="2"
                        WidthRequest="80"
                        MinimumWidthRequest="64"
                        MinimumHeightRequest="64"
                        HorizontalOptions="Center"
                        Padding="0"
                        BackgroundColor="Transparent"
                        BorderWidth="0"
                        Command="{Binding CreateOfferCommand, Source={x:Reference Root}}"
                        Pressed="OnCreatePressed"
                        Released="OnCreateReleased"
                        SemanticProperties.Description="สร้างข้อเสนอซื้อ"
                        SemanticProperties.Hint="เริ่มสร้างข้อเสนอซื้อส่วนตัว" />
                </Grid>

                <Button
                    x:Name="SellButton"
                    Grid.Column="2"
                    MaximumWidthRequest="88"
                    MinimumHeightRequest="48"
                    HorizontalOptions="Center"
                    VerticalOptions="End"
                    Margin="0,0,0,8"
                    Padding="8,3"
                    BackgroundColor="Transparent"
                    Command="{Binding OpenSellingCommand, Source={x:Reference Root}}"
                    ContentLayout="Top,2"
                    CornerRadius="14"
                    FontAttributes="Bold"
                    FontSize="11"
                    ImageSource="nav_sell.png"
                    SemanticProperties.Description="ขาย"
                    Text="ขาย"
                    TextColor="{StaticResource Muted}" />
            </Grid>
        </Grid>
    </Grid>
</ContentView>
