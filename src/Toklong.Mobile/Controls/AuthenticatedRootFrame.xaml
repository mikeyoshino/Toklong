<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="Toklong.Mobile.Controls.AuthenticatedRootFrame"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Grid RowDefinitions="*,Auto">
        <ContentView
            x:Name="BodyHost"
            Content="{Binding Body, Source={x:Reference Root}}" />

        <Border
            Grid.Row="1"
            Padding="18,8,18,10"
            BackgroundColor="#F7FFFFFF"
            Stroke="{StaticResource Line}"
            StrokeShape="RoundRectangle 22,22,0,0">
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Button
                    x:Name="BuyButton"
                    MinimumHeightRequest="52"
                    BackgroundColor="Transparent"
                    Command="{Binding OpenBuyingCommand, Source={x:Reference Root}}"
                    ContentLayout="Top,4"
                    ImageSource="nav_buy.png"
                    SemanticProperties.Description="ซื้อ"
                    Text="ซื้อ"
                    TextColor="{StaticResource TrustNavy}" />

                <Grid
                    Grid.Column="1"
                    RowDefinitions="Auto,Auto"
                    RowSpacing="2"
                    TranslationY="-24">
                    <Button
                        x:Name="CreateButton"
                        WidthRequest="68"
                        HeightRequest="68"
                        MinimumWidthRequest="64"
                        MinimumHeightRequest="64"
                        HorizontalOptions="Center"
                        Padding="0"
                        BackgroundColor="{StaticResource TrustNavy}"
                        BorderColor="White"
                        BorderWidth="5"
                        Command="{Binding CreateOfferCommand, Source={x:Reference Root}}"
                        CornerRadius="34"
                        FontAttributes="Bold"
                        FontSize="30"
                        Pressed="OnCreatePressed"
                        Released="OnCreateReleased"
                        SemanticProperties.Description="สร้างข้อเสนอซื้อ"
                        SemanticProperties.Hint="เริ่มสร้างข้อเสนอซื้อส่วนตัว"
                        Text="+"
                        TextColor="{StaticResource VerifiedMint}" />
                    <Label
                        Grid.Row="1"
                        AutomationProperties.IsInAccessibleTree="False"
                        HorizontalTextAlignment="Center"
                        InputTransparent="True"
                        FontAttributes="Bold"
                        FontSize="12"
                        Text="สร้างดีล"
                        TextColor="{StaticResource TrustNavy}" />
                </Grid>

                <Button
                    x:Name="SellButton"
                    Grid.Column="2"
                    MinimumHeightRequest="52"
                    BackgroundColor="Transparent"
                    Command="{Binding OpenSellingCommand, Source={x:Reference Root}}"
                    ContentLayout="Top,4"
                    ImageSource="nav_sell.png"
                    SemanticProperties.Description="ขาย"
                    Text="ขาย"
                    TextColor="{StaticResource Muted}" />
            </Grid>
        </Border>
    </Grid>
</ContentView>
