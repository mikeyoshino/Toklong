@inject NavigationManager Navigation

<div class="loading-state">กำลังไปหน้าลงชื่อเข้าใช้…</div>

@code {
    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender)
            return;
        var relative = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
        var signInPath = relative.StartsWith(
            "/offers/create", StringComparison.OrdinalIgnoreCase)
            ? "/buyer/sign-in"
            : "/seller/sign-in";
        Navigation.NavigateTo(
            $"{signInPath}?returnUrl={Uri.EscapeDataString(relative)}",
            forceLoad: true);
    }
}
