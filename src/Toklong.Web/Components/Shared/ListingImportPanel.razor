<section class="listing-import-card" aria-labelledby="listing-import-title">
    <div class="listing-import-head">
        <span class="listing-import-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                <path d="M10 13a4 4 0 0 0 5.7.1l2.2-2.2a4 4 0 0 0-5.7-5.7L11 6.4M14 11a4 4 0 0 0-5.7-.1l-2.2 2.2a4 4 0 0 0 5.7 5.7l1.2-1.2"
                      stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
            </svg>
        </span>
        <span>
            <span class="listing-import-kicker">ช่วยกรอกอัตโนมัติ</span>
            <strong id="listing-import-title">มีข้อมูลจากแชตหรือประกาศอยู่แล้ว?</strong>
            <small>วางลิงก์สาธารณะเพื่อช่วยเตรียมรายละเอียดข้อตกลง ไม่ใช่การนำมาลงขายใหม่</small>
        </span>
    </div>

    <div class="listing-import-control">
        <label class="sr-only" for="listing-source-url">ลิงก์ข้อมูลอ้างอิง</label>
        <span class="listing-import-leading" aria-hidden="true">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none">
                <path d="M10 13a4 4 0 0 0 5.7.1l2.2-2.2a4 4 0 0 0-5.7-5.7L11 6.4M14 11a4 4 0 0 0-5.7-.1l-2.2 2.2a4 4 0 0 0 5.7 5.7l1.2-1.2"
                      stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
            </svg>
        </span>
        <input id="listing-source-url"
               class="form-control"
               type="url"
               inputmode="url"
               autocomplete="url"
               placeholder="https://www.facebook.com/marketplace/item/..."
               value="@SourceUrl"
               @oninput="SourceChanged"
               @onkeydown="HandleKeyDown"
               disabled="@Busy" />
        <button class="button button-primary" type="button" disabled="@(!CanImport)" @onclick="RequestImportAsync">
            @if (Busy)
            {
                <span class="spinner" aria-hidden="true"></span>
                <span>กำลังอ่านประกาศ…</span>
            }
            else
            {
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="m12 3 1.2 4.1L17 9l-3.8 1.9L12 15l-1.2-4.1L7 9l3.8-1.9L12 3ZM18.5 15l.7 2.3 2.3.7-2.3.7-.7 2.3-.7-2.3-2.3-.7 2.3-.7.7-2.3Z"
                          stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
                </svg>
                <span>ดึงข้อมูล</span>
            }
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(SuccessMessage))
    {
        <div class="listing-import-result success" role="status">
            <span aria-hidden="true">✓</span>
            <p><strong>เติมข้อมูลให้แล้ว</strong>@SuccessMessage</p>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="listing-import-result error" role="alert">
            <span aria-hidden="true">!</span>
            <p><strong>ยังดึงข้อมูลไม่ได้</strong>@ErrorMessage</p>
        </div>
    }

    <p class="listing-import-privacy">
        ระบบอ่านเฉพาะข้อมูลที่ลิงก์เปิดเผยต่อสาธารณะ และจะไม่สร้างรายการจนกว่าคุณตรวจสอบแล้วกด “สร้างลิงก์ข้อตกลง”
    </p>
</section>

@code {
    [Parameter] public string SourceUrl { get; set; } = "";
    [Parameter] public EventCallback<string> SourceUrlChanged { get; set; }
    [Parameter] public EventCallback OnImport { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public string? SuccessMessage { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }

    private bool CanImport => !Busy && Uri.TryCreate(SourceUrl, UriKind.Absolute, out _);

    private Task SourceChanged(ChangeEventArgs args) =>
        SourceUrlChanged.InvokeAsync(args.Value?.ToString() ?? "");

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && CanImport)
            await RequestImportAsync();
    }

    private Task RequestImportAsync() => OnImport.InvokeAsync();
}
