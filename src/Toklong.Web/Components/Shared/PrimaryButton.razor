<button class="@CssClass" type="@Type" disabled="@Disabled" @onclick="OnClick">
    @if (Busy)
    {
        <span class="spinner" aria-hidden="true"></span>
        <span>@BusyText</span>
    }
    else
    {
        @ChildContent
    }
</button>

@code {
    [Parameter] public string Type { get; set; } = "submit";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public string BusyText { get; set; } = "กำลังดำเนินการ…";
    [Parameter] public bool Secondary { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private string CssClass => Secondary ? "button button-secondary" : "button button-primary";
}
