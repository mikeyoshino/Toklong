@using Toklong.Application.Transactions

<div class="mobile-only mobile-transaction-summary">
    <div class="mobile-card">
        <div class="product-block">
            <div class="product-visual">
                @if (!string.IsNullOrWhiteSpace(Transaction.PhotoUrl))
                {
                    <img src="@Transaction.PhotoUrl" alt="รูปประกอบรายการ @Transaction.ProductName" />
                }
                else
                {
                    <span class="product-image-placeholder compact"
                          role="img" aria-label="ข้อเสนอนี้ไม่มีรูปสินค้า">
                        <span aria-hidden="true">▧</span>
                        <small>ไม่มีรูป</small>
                    </span>
                }
            </div>
            <div class="product-copy">
                <strong>@Transaction.ProductName</strong>
                <small>@Description</small>
                <span class="condition-pill">@ConditionLabel</span>
            </div>
        </div>
        @if (ShowSeller)
        {
            <div class="seller-row">
                <span class="seller-profile">
                    <span class="mini-avatar">@SellerInitials</span>
                    <span>
                        <strong>@Transaction.SellerDisplayName</strong>
                        <small>● ติดต่อผู้ขายได้</small>
                    </span>
                </span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M12 3 5 6v5c0 4.6 2.7 8.3 7 10 4.3-1.7 7-5.4 7-10V6l-7-3Z"
                          stroke="#2b7fff" stroke-width="1.7" stroke-linejoin="round" />
                </svg>
            </div>
        }
    </div>

    @if (ShowPrice)
    {
        <div class="price-summary">
            <div class="price-line"><span>ราคาสินค้า</span><span>@Money(Transaction.PriceSatang)</span></div>
            @if (Transaction.ShippingFeeSatang > 0)
            {
                <div class="price-line"><span>ค่าจัดส่ง</span><span>@Money(Transaction.ShippingFeeSatang)</span></div>
            }
            @if (Transaction.BuyerProtectionFeeSatang > 0)
            {
                <div class="price-line"><span>ค่าคุ้มครองผู้ซื้อ</span><span>@Money(Transaction.BuyerProtectionFeeSatang)</span></div>
            }
            <div class="price-line"><span>@(IsDigital ? "กำหนดส่งมอบ" : "กำหนดส่ง")</span><span>ภายใน @ShipByLabel</span></div>
            <div class="price-line total"><span>ยอดชำระ</span><span>@Money(Transaction.BuyerTotalSatang)</span></div>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public TransactionView Transaction { get; set; } = default!;
    [Parameter] public bool ShowSeller { get; set; } = true;
    [Parameter] public bool ShowPrice { get; set; } = true;
    private bool IsDigital =>
        Transaction.FulfillmentType ==
        Toklong.Domain.Transactions.FulfillmentType.DigitalHandoff;

    private string Description
    {
        get
        {
            var detail = string.IsNullOrWhiteSpace(Transaction.KnownDefects)
                ? Transaction.Description
                : Transaction.KnownDefects;
            detail = detail.ReplaceLineEndings(" ").Trim();
            return detail.Length <= 58 ? detail : $"{detail[..58]}…";
        }
    }

    private string ConditionLabel => Transaction.Condition switch
    {
        Toklong.Domain.Transactions.ConditionCode.New => "สินค้าใหม่",
        Toklong.Domain.Transactions.ConditionCode.UsedDefects => "มือสอง · มีตำหนิ",
        Toklong.Domain.Transactions.ConditionCode.UsedGood => "มือสอง · สภาพดี",
        _ => "ไม่ระบุสภาพ"
    };

    private string SellerInitials
    {
        get
        {
            var words = Transaction.SellerDisplayName
                .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            return string.Concat(words.Take(2).Select(word => word[0])).ToUpperInvariant();
        }
    }

    private static string Money(long satang) => $"฿{satang / 100m:N2}";
    private const string ShipByLabel = "3 วัน";
}
