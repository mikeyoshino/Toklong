@using Toklong.Application.Abstractions
@using Toklong.Application.Features.Sales.AnalyzeListingImages

<details class="listing-image-card" open="@IsOpen">
    <summary>
        <span class="listing-image-summary-icon" aria-hidden="true">
            <svg width="21" height="21" viewBox="0 0 24 24" fill="none">
                <path d="M4 7.5h16v11H4zM8 7.5V5.8A1.8 1.8 0 0 1 9.8 4h4.4A1.8 1.8 0 0 1 16 5.8v1.7"
                      stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
                <circle cx="12" cy="13" r="3.2" stroke="currentColor" stroke-width="1.8" />
            </svg>
        </span>
        <span>
            <span class="listing-import-kicker">รูปประกอบข้อตกลง</span>
            <strong>ถ่ายรูปหรือเลือก screenshot</strong>
            <small>ใช้รูปเป็นหลักฐานของรายการ หรือให้ AI ช่วยอ่านข้อมูลจากรูป</small>
        </span>
        <svg class="listing-image-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="m7 10 5 5 5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
    </summary>

    <div class="listing-image-body">
        <div class="listing-image-actions">
            <label class="listing-image-picker primary" for="listing-camera">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M4 8h16v10H4zM8 8l1.5-2h5L16 8M12 11a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5Z"
                          stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
                </svg>
                ถ่ายรูป
            </label>
            <InputFile id="listing-camera"
                       class="listing-image-input"
                       accept="image/jpeg,image/png,image/webp"
                       capture="environment"
                       OnChange="SelectCameraImageAsync"
                       disabled="@Busy" />

            <label class="listing-image-picker" for="listing-gallery">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M4 5h16v14H4zM7 15l3-3 2.5 2.5L15 12l3 4M8.5 9.5h.01"
                          stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                เลือกรูป / screenshot
            </label>
            <InputFile id="listing-gallery"
                       class="listing-image-input"
                       accept="image/jpeg,image/png,image/webp"
                       multiple
                       OnChange="SelectGalleryImagesAsync"
                       disabled="@Busy" />
        </div>

        @if (selectedImages.Count > 0)
        {
            <div class="listing-image-files" aria-label="รูปที่เลือก">
                @foreach (var image in selectedImages)
                {
                    <div>
                        <span aria-hidden="true">▧</span>
                        <span><strong>@image.FileName</strong><small>@FileSize(image.Content.Length)</small></span>
                    </div>
                }
            </div>
            <div class="listing-image-submit-actions">
                <button class="button button-primary listing-image-analyze"
                        type="button"
                        disabled="@Busy"
                        @onclick="SaveAsync">
                    <span>ใช้รูปนี้</span>
                </button>
                <button class="button button-secondary listing-image-analyze"
                        type="button"
                        disabled="@Busy"
                        @onclick="AnalyzeAsync">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="m12 3 1.2 4.1L17 9l-3.8 1.9L12 15l-1.2-4.1L7 9l3.8-1.9L12 3ZM18.5 15l.7 2.3 2.3.7-2.3.7-.7 2.3-.7-2.3-2.3-.7 2.3-.7.7-2.3Z"
                              stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
                    </svg>
                    <span>ให้ AI ช่วยกรอก</span>
                </button>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(PhotoMessage))
        {
            <div class="listing-import-result success" role="status">
                <span aria-hidden="true">✓</span>
                <p><strong>เพิ่มรูปประกอบแล้ว</strong>@PhotoMessage</p>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(localError))
        {
            <div class="listing-import-result error" role="alert">
                <span aria-hidden="true">!</span>
                <p><strong>เลือกรูปไม่ได้</strong>@localError</p>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(SuccessMessage))
        {
            <div class="listing-import-result success" role="status">
                <span aria-hidden="true">✓</span>
                <p><strong>AI เติมข้อมูลให้แล้ว</strong>@SuccessMessage</p>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="listing-import-result error" role="alert">
                <span aria-hidden="true">!</span>
                <p><strong>AI ยังอ่านรูปไม่ได้</strong>@ErrorMessage</p>
            </div>
        }

        <p class="listing-image-consent">
            รูปที่เลือกจะเป็นส่วนหนึ่งของรายละเอียดรายการ หากเลือกให้ AI ช่วย
            รูปจะถูกย่อ ลบ metadata และส่งเพื่อสร้างข้อมูลร่าง กรุณาตรวจข้อมูลก่อนสร้างลิงก์
        </p>
    </div>
</details>

@code {
    [Parameter] public EventCallback<IReadOnlyList<ListingImageInput>> OnAnalyze { get; set; }
    [Parameter] public EventCallback<ListingImageInput> OnSave { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public string? PhotoMessage { get; set; }
    [Parameter] public string? SuccessMessage { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }

    private readonly List<ListingImageInput> selectedImages = [];
    private string? localError;
    private bool IsOpen => selectedImages.Count > 0 ||
                           !string.IsNullOrWhiteSpace(SuccessMessage) ||
                           !string.IsNullOrWhiteSpace(ErrorMessage);

    private Task SelectCameraImageAsync(InputFileChangeEventArgs args) =>
        ReadFilesAsync([args.File]);

    private async Task SelectGalleryImagesAsync(InputFileChangeEventArgs args)
    {
        try
        {
            await ReadFilesAsync(args.GetMultipleFiles(
                AnalyzeListingImagesHandler.MaximumImages));
        }
        catch (InvalidOperationException)
        {
            localError = $"เลือกได้สูงสุด {AnalyzeListingImagesHandler.MaximumImages} รูป";
        }
    }

    private async Task ReadFilesAsync(IReadOnlyList<IBrowserFile> files)
    {
        localError = null;
        selectedImages.Clear();
        try
        {
            foreach (var file in files)
            {
                if (file.Size > AnalyzeListingImagesHandler.MaximumImageBytes)
                    throw new InvalidOperationException("แต่ละรูปต้องมีขนาดไม่เกิน 8 MB");
                await using var source = file.OpenReadStream(
                    AnalyzeListingImagesHandler.MaximumImageBytes);
                using var destination = new MemoryStream();
                await source.CopyToAsync(destination);
                selectedImages.Add(new ListingImageInput(
                    file.Name, file.ContentType, destination.ToArray()));
            }
        }
        catch (Exception exception)
        {
            selectedImages.Clear();
            localError = exception.Message;
        }
    }

    private Task SaveAsync() => OnSave.InvokeAsync(selectedImages[0]);
    private Task AnalyzeAsync() => OnAnalyze.InvokeAsync(selectedImages);
    private static string FileSize(int bytes) => $"{bytes / 1024d:N0} KB";
}
