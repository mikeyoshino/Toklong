@if (!string.IsNullOrWhiteSpace(Message))
{
    <div class="@CssClass" role="@(Danger ? "alert" : "status")">@Message</div>
}

@code {
    [Parameter] public string? Message { get; set; }
    [Parameter] public bool Danger { get; set; }
    private string CssClass => Danger ? "alert alert-danger" : "alert alert-success";
}
