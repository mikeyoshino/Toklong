@inject IJSRuntime JS

@if (IsOpen && Steps.Count > 0)
{
    <div class="md-guide-backdrop" aria-hidden="true"></div>
    <aside class="md-guide-card md-guide-blue md-guide-position-@Position md-guide-step-@CurrentStep"
           role="dialog"
           aria-modal="true"
           aria-labelledby="@TitleId"
           aria-describedby="@DescriptionId">
        <div class="md-guide-header">
            <span class="md-guide-kicker"><i aria-hidden="true"></i>GUIDE · สร้างลิงก์ข้อตกลง</span>
            <strong>ขั้นตอน @CurrentStep จาก @Steps.Count</strong>
        </div>
        <div class="md-guide-progress" style="--guide-steps:@Steps.Count" aria-label="ความคืบหน้า @CurrentStep จาก @Steps.Count">
            @for (var step = 1; step <= Steps.Count; step++)
            {
                <i class="@(step <= CurrentStep ? "active" : string.Empty)"></i>
            }
        </div>

        <div class="md-guide-visual" @key="CurrentStep" aria-label="ภาพอธิบายขั้นตอน">
            <span class="md-guide-orbit" aria-hidden="true"></span>
            @for (var itemIndex = 0; itemIndex < Current.VisualItems.Count; itemIndex++)
            {
                var item = Current.VisualItems[itemIndex];
                <div class="md-guide-visual-node" style="--guide-delay:@(itemIndex * 150)ms">
                    <span aria-hidden="true">@item.Icon</span>
                    <strong>@item.Label</strong>
                    <small>@item.Detail</small>
                </div>
                @if (itemIndex < Current.VisualItems.Count - 1)
                {
                    <i class="md-guide-visual-arrow" style="--guide-delay:@(itemIndex * 150 + 90)ms" aria-hidden="true">→</i>
                }
            }
        </div>

        <div class="md-guide-copy" aria-live="polite">
            <span class="md-guide-step-icon" aria-hidden="true">@Current.Icon</span>
            <div><h2 id="@TitleId">@Current.Title</h2><p id="@DescriptionId">@Current.Description</p></div>
        </div>
        <div class="md-guide-notice"><span aria-hidden="true">✓</span><p>@Current.Notice</p></div>

        <div class="md-guide-actions">
            <button class="md-button md-button-plain md-guide-skip" type="button" @onclick="OnSkip">ข้ามคำแนะนำ</button>
            <div>
                @if (CurrentStep > 1)
                {
                    <button class="md-button md-button-secondary md-guide-back" type="button" @onclick="OnPrevious">ย้อนกลับ</button>
                }
                <button class="md-button md-button-primary md-guide-next" type="button" @onclick="OnNext">
                    @(CurrentStep == Steps.Count ? "เข้าใจแล้ว" : "ถัดไป") <span aria-hidden="true">→</span>
                </button>
            </div>
        </div>
    </aside>
}

@code {
    public sealed record VisualItem(string Icon, string Label, string Detail);
    public sealed record Step(
        string Title,
        string Description,
        string Icon,
        string Notice,
        IReadOnlyList<VisualItem> VisualItems,
        string? TargetId = null);

    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public int CurrentStep { get; set; } = 1;
    [Parameter, EditorRequired] public IReadOnlyList<Step> Steps { get; set; } = [];
    [Parameter] public EventCallback OnNext { get; set; }
    [Parameter] public EventCallback OnPrevious { get; set; }
    [Parameter] public EventCallback OnSkip { get; set; }

    private Step Current => Steps[Math.Clamp(CurrentStep - 1, 0, Steps.Count - 1)];
    private const string Position = "bottom";
    private const string TitleId = "create-sale-guide-title";
    private const string DescriptionId = "create-sale-guide-description";
    private int lastFocusedStep;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!IsOpen || CurrentStep == lastFocusedStep || string.IsNullOrWhiteSpace(Current.TargetId))
            return;

        lastFocusedStep = CurrentStep;
        await JS.InvokeVoidAsync("toklongGuide.focusStep", Current.TargetId);
    }
}
