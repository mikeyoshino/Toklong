@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IJSRuntime JS

<section class="phone-demo flow-demo" aria-label="ตัวอย่างขั้นตอนรายการบนโทรศัพท์">
    <div class="phone-head">
        <span class="brand">TOKLONG</span>
        <span class="status status-info">ตัวอย่าง</span>
    </div>

    <div class="phone-body flow-demo-body" aria-live="polite">
        <div class="flow-demo-scene" @key="current">
            @switch (current)
            {
            case 0:
                <div class="step-label">ขั้นที่ 1 จาก 4 · สร้างข้อตกลง</div>
                <h2>ตกลงกันแล้ว สร้างลิงก์ได้เลย</h2>
                <p>เลือกวิธีส่งมอบให้ตรงกับรายการ</p>
                <div class="demo-choice active">
                    <span>▣</span>
                    <div><strong>สินค้าจัดส่ง</strong><small>ใช้ Tracking ที่ตรวจสอบได้</small></div>
                </div>
                <div class="demo-choice">
                    <span>◎</span>
                    <div><strong>สินค้าดิจิทัล</strong><small>ผู้ซื้อยืนยันรับ · ไม่มี auto-release</small></div>
                </div>
                <div class="demo-primary">สร้างลิงก์ข้อตกลง</div>
                break;
            case 1:
                <div class="step-label">ขั้นที่ 2 จาก 4 · ผู้ซื้อตรวจสอบ</div>
                <h2>ข้อมูลเดียวกันก่อนชำระ</h2>
                <p>รายการ รูป รายละเอียด ยอด และเงื่อนไขการจ่ายถูกแสดงครบ</p>
                <div class="demo-summary">
                    <span>รายการที่ตกลงกัน</span><strong>฿4,560</strong>
                    <small>ชำระผ่านพาร์ทเนอร์ · รอยืนยันยอด</small>
                </div>
                <div class="demo-protection">✓ สลิปหรือหน้า redirect ไม่เปลี่ยนสถานะเป็นชำระแล้ว</div>
                <div class="demo-primary">ดำเนินการชำระ ฿4,560</div>
                break;
            case 2:
                <div class="step-label">ขั้นที่ 3 จาก 4 · ส่งมอบ</div>
                <h2>ยอดยืนยันแล้ว จึงเริ่มส่งมอบ</h2>
                <div class="demo-path">
                    <span class="demo-path-icon">▣</span>
                    <div><strong>สินค้าจัดส่ง</strong><small>เพิ่มขนส่งและ Tracking</small></div>
                    <b>ตรวจจากขนส่ง</b>
                </div>
                <div class="demo-path digital">
                    <span class="demo-path-icon">◎</span>
                    <div><strong>สินค้าดิจิทัล</strong><small>ส่งผ่านช่องทางที่ตกลงกัน</small></div>
                    <b>ไม่เก็บรหัสลับ</b>
                </div>
                <div class="demo-protection">ผู้ขายแจ้งว่าส่งมอบแล้ว ยังไม่ทำให้เกิดการจ่ายเงิน</div>
                break;
            default:
                <div class="step-label">ขั้นที่ 4 จาก 4 · ยืนยันหรือแจ้งปัญหา</div>
                <h2>เงื่อนไขจ่ายชัดเจนตามประเภท</h2>
                <div class="demo-rule physical">
                    <strong>สินค้าจัดส่ง</strong>
                    <span>ผู้ซื้อยืนยัน หรือครบ 168 ชม. หลังขนส่งยืนยันโดยไม่มีปัญหา</span>
                </div>
                <div class="demo-rule digital">
                    <strong>สินค้าดิจิทัล</strong>
                    <span>ผู้ซื้อยืนยัน หรือ manual review เท่านั้น ไม่มีการจ่ายตามเวลา</span>
                </div>
                <div class="demo-primary">ได้รับรายการแล้ว</div>
                <div class="demo-secondary">แจ้งปัญหา</div>
                break;
            }
        </div>
    </div>

    <div class="flow-demo-controls" aria-label="ควบคุมตัวอย่าง">
        <button type="button" @onclick="Previous" aria-label="ขั้นตอนก่อนหน้า">←</button>
        <button type="button" @onclick="TogglePlaying" aria-label="@(playing ? "หยุดภาพอัตโนมัติ" : "เล่นภาพอัตโนมัติ")">
            @(playing ? "หยุด" : "เล่น")
        </button>
        <button type="button" @onclick="Next" aria-label="ขั้นตอนถัดไป">→</button>
    </div>
    <div class="flow-demo-dots" aria-label="เลือกขั้นตอน">
        @for (var index = 0; index < 4; index++)
        {
            var target = index;
            <button class="@(current == target ? "active" : null)"
                    type="button"
                    aria-label="ขั้นตอน @(target + 1)"
                    aria-current="@(current == target ? "step" : null)"
                    @onclick="() => Select(target)"></button>
        }
    </div>
</section>

@code {
    private readonly CancellationTokenSource cancellation = new();
    private int current;
    private bool playing;
    private bool started;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        playing = !await JS.InvokeAsync<bool>(
            "toklongMotion.prefersReducedMotion");
        started = true;
        _ = RunAsync(cancellation.Token);
        StateHasChanged();
    }

    private async Task RunAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                if (!playing)
                    continue;
                await InvokeAsync(() =>
                {
                    current = (current + 1) % 4;
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void Previous()
    {
        playing = false;
        current = (current + 3) % 4;
    }

    private void Next()
    {
        playing = false;
        current = (current + 1) % 4;
    }

    private void Select(int target)
    {
        playing = false;
        current = target;
    }

    private void TogglePlaying()
    {
        if (started)
            playing = !playing;
    }

    public ValueTask DisposeAsync()
    {
        cancellation.Cancel();
        cancellation.Dispose();
        return ValueTask.CompletedTask;
    }
}
