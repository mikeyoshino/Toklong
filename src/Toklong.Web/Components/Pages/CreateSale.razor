@page "/sales/create"
@rendermode InteractiveServer
@attribute [Authorize]
@using Toklong.Application.Features.Sales.CreateSale
@using Toklong.Application.Features.Sales.ImportListing
@using Toklong.Application.Features.Sales.AnalyzeListingImages
@using Toklong.Application.Features.Sales.SaveListingPhoto
@using Toklong.Application.Abstractions
@using Toklong.Application.Features.Sellers
@using Toklong.Domain.Transactions
@using Toklong.Web.Models
@inject Toklong.Web.Services.ApplicationRequestSender Sender
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>สร้างลิงก์ข้อตกลง — TOKLONG</PageTitle>

<AppHeader BackHref="/" BackLabel="กลับหน้าแรก" />

<GuidedTour IsOpen="showTour"
            CurrentStep="tourStep"
            Steps="tourSteps"
            OnNext="NextTourStepAsync"
            OnPrevious="PreviousTourStep"
            OnSkip="CompleteTourAsync" />

<main class="page-shell create-page">
    <div class="create-glow create-glow-left" aria-hidden="true"></div>
    <div class="create-glow create-glow-right" aria-hidden="true"></div>

    <div class="page-heading create-heading">
        <span class="eyebrow"><span class="eyebrow-dot"></span>ผู้ขาย · ขั้นที่ 1 จาก 4</span>
        <h1>สร้างลิงก์ข้อตกลง</h1>
        <p>บันทึกสิ่งที่คุณและผู้ซื้อตกลงกัน เพื่อให้ตรวจสอบข้อมูลชุดเดียวกันก่อนชำระ</p>
    </div>

    <div class="mobile-only mobile-flow-head @(IsTourStep(1) ? "tour-spotlight" : null)" data-tour-target="tour-create-intro">
        <MobileSceneIntro Step="1"
                          Kicker="ประมาณ 1 นาที"
                          Title="สร้างลิงก์ข้อตกลง"
                          Subtitle="ไม่ใช่การลงประกาศขาย แต่เป็นข้อมูลที่ทั้งสองฝ่ายตกลงกัน" />
        <div class="mobile-card product-block mobile-create-preview">
            <div class="product-visual" aria-hidden="true">
                <div class="camera-body"><span class="camera-flash"></span></div>
            </div>
            <div class="product-copy">
                <strong>@(string.IsNullOrWhiteSpace(form.ProductName) ? "รายการที่ตกลงซื้อขาย" : form.ProductName)</strong>
                <small>@(string.IsNullOrWhiteSpace(form.Description) ? "ระบุสภาพ อุปกรณ์ และตำหนิในช่องเดียว" : form.Description)</small>
                <span class="condition-pill">@ConditionLabel(form.Condition)</span>
            </div>
        </div>
            <div class="form-stack mobile-create-summary">
            <div class="field-row">
                <div class="field-mini"><label>ยอดที่ตกลง</label><strong>@PreviewMoney(form.PriceBaht)</strong></div>
                <div class="field-mini">
                    <label>@(IsDigital ? "รูปแบบ" : "ค่าส่ง")</label>
                    <strong>@(IsDigital ? "ส่งมอบดิจิทัล" : PreviewMoney(form.ShippingFeeBaht))</strong>
                </div>
            </div>
            <div class="field-mini"><label>@(IsDigital ? "กำหนดส่งมอบ" : "กำหนดส่ง")</label><strong>ภายใน @ShipByLabel(form.ShipByDurationHours) หลังยืนยันยอดชำระ</strong></div>
        </div>
    </div>

    <ListingImportPanel @bind-SourceUrl="listingSourceUrl"
                        Busy="importBusy"
                        SuccessMessage="@importSuccess"
                        ErrorMessage="@importError"
                        OnImport="ImportListingAsync" />
    <ListingImageImportPanel Busy="imageAnalysisBusy"
                             PhotoMessage="@photoSavedMessage"
                             SuccessMessage="@imageAnalysisSuccess"
                             ErrorMessage="@imageAnalysisError"
                             OnSave="SaveListingPhotoAsync"
                             OnAnalyze="AnalyzeListingImagesAsync" />

    <AlertMessage Message="@error" Danger />

    <EditForm class="create-window" Model="form" OnValidSubmit="SubmitAsync" FormName="create-sale">
        <DataAnnotationsValidator />

        <div class="create-window-head @(IsTourStep(1) ? "tour-spotlight" : null)" id="tour-create-intro">
            <div class="create-window-title">
                <span class="create-window-icon" aria-hidden="true">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                        <path d="M4 7.5h16v11H4zM8 7.5V5.8A1.8 1.8 0 0 1 9.8 4h4.4A1.8 1.8 0 0 1 16 5.8v1.7M8 12h8"
                              stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </span>
                <span>
                    <strong>รายละเอียดข้อตกลง</strong>
                    <small>ใช้เวลาประมาณ 1 นาที</small>
                </span>
            </div>
            <span class="role-badge">ผู้ขาย</span>
        </div>

        <ValidationSummary class="validation-summary" />

        <section class="form-card">
            <div class="form-section-heading @(IsTourStep(2) ? "tour-spotlight" : null)" id="tour-seller">
                <span>1</span>
                <div><h2>ผู้ขายที่ยืนยันแล้ว</h2><p>ใช้โปรไฟล์นี้กับรายการขายของคุณ</p></div>
            </div>
            <div class="seller-profile-row">
                <span class="seller-profile-check" aria-hidden="true">✓</span>
                <span>
                    <strong>@(profile?.DisplayName ?? "กำลังโหลดโปรไฟล์…")</strong>
                    <small>@MaskPhone(profile?.PhoneNumber) · ยืนยันด้วย OTP แล้ว</small>
                </span>
            </div>
        </section>

        <section class="form-card">
            <div class="form-section-heading @(IsTourStep(3) ? "tour-spotlight" : null)" id="tour-product">
                <span>2</span>
                <div><h2>สิ่งที่ตกลงซื้อขาย</h2><p>รวมสภาพ อุปกรณ์ ตำหนิ และสิ่งสำคัญไว้ในรายละเอียดเดียว</p></div>
            </div>
            <SelectField TValue="FulfillmentType"
                         Id="fulfillment-type"
                         Label="รูปแบบการส่งมอบ"
                         DisplayText="@FulfillmentLabel(form.FulfillmentType)"
                         Required
                         @bind-Value="form.FulfillmentType">
                <option value="@FulfillmentType.PhysicalShipment">สินค้าจัดส่ง · ใช้ Tracking</option>
                <option value="@FulfillmentType.DigitalHandoff">สินค้าดิจิทัล · ผู้ซื้อยืนยันรับ</option>
            </SelectField>
            <TextField Id="product-name" Label="รายการที่ตกลงซื้อขาย" Required @bind-Value="form.ProductName" />
            <TextAreaField Id="description"
                           Label="รายละเอียดข้อตกลง"
                           Hint="ระบุอุปกรณ์ที่รวม สภาพการใช้งาน ตำหนิที่ทราบ และสิ่งที่ผู้ซื้อควรรู้"
                           Required
                           @bind-Value="form.Description" />
            <div class="notice">
                รูปประกอบที่เพิ่มด้านบนจะถูกบันทึกกับรายการ ผู้ซื้อจะเห็นรูปและรายละเอียดชุดนี้ก่อนชำระ
            </div>
            @if (IsDigital)
            {
                <div class="notice">
                    TOKLONG ไม่รับเก็บรหัสผ่าน รหัสกู้คืน private key หรือข้อมูลลับ
                    กรุณาส่งมอบผ่านช่องทางที่ตกลงกัน ผู้ขายกดว่าส่งมอบแล้วจะยังไม่ทำให้เกิดการจ่ายเงิน
                </div>
            }
        </section>

        <section class="form-card">
            <div class="form-section-heading @(IsTourStep(4) ? "tour-spotlight" : null)" id="tour-price">
                <span>3</span>
                <div><h2>ราคาและกำหนดส่ง</h2><p>ผู้ซื้อจะเห็นยอดรวมและกำหนดส่งก่อนชำระ</p></div>
            </div>
            <div class="form-grid two">
                <MoneyField Id="price" Label="ยอดที่ตกลง" Required @bind-Value="form.PriceBaht" />
                @if (!IsDigital)
                {
                    <MoneyField Id="shipping" Label="ค่าจัดส่ง" Required @bind-Value="form.ShippingFeeBaht" />
                }
            </div>
            <SelectField TValue="int" Id="ship-by" Label="@(IsDigital ? "ส่งมอบภายในหลังยืนยันยอด" : "ส่งภายในหลังยืนยันยอด")" DisplayText="@ShipByLabel(form.ShipByDurationHours)" Required @bind-Value="form.ShipByDurationHours">
                <option value="24">24 ชั่วโมง</option>
                <option value="48">48 ชั่วโมง</option>
                <option value="72">72 ชั่วโมง</option>
                <option value="120">5 วัน</option>
            </SelectField>
        </section>

        <section class="form-card">
            <div class="form-section-heading @(IsTourStep(5) ? "tour-spotlight" : null)" id="tour-payout">
                <span>4</span>
                <div><h2>รับเงินเข้าบัญชี</h2><p>เลือกบัญชีที่ตั้งค่าไว้ ไม่ต้องกรอกใหม่ทุกครั้ง</p></div>
            </div>
            @if (profile is not null)
            {
                <SelectField TValue="Guid?" Id="payout-account" Label="บัญชีรับเงิน"
                             DisplayText="@SelectedPayoutLabel()" Required
                             @bind-Value="form.PayoutAccountId">
                    @foreach (var account in profile.PayoutAccounts)
                    {
                        <option value="@account.Id">@BankLabel(account.BankCode) · @account.MaskedNumber</option>
                    }
                </SelectField>
            }
            <a class="payout-manage-link" href="/seller/settings/payouts?returnUrl=%2Fsales%2Fcreate">
                จัดการหรือเพิ่มบัญชีรับเงิน
            </a>
            <div class="notice payout-privacy-note">
                ข้อมูลบัญชีใช้สำหรับดำเนินการจ่ายเงินเท่านั้น การบันทึกบัญชีไม่ได้หมายความว่าโอนเงินสำเร็จ
                สถานะจะเปลี่ยนหลังได้รับการยืนยันการโอนจากแหล่งที่ได้รับสิทธิ์
            </div>
        </section>

        <section class="form-card">
            <div class="form-section-heading @(IsTourStep(6) ? "tour-spotlight" : null)" id="tour-terms">
                <span>5</span>
                <div><h2>คำยืนยันและข้อตกลง</h2><p>ตรวจสอบข้อมูลก่อนเปิดใช้งานลิงก์</p></div>
            </div>
            <CheckboxField Id="goods-attestation"
                           Label="@PossessionAttestation"
                           Hint="@PossessionHint"
                           @bind-Value="form.ProhibitedGoodsAttested" />
            <CheckboxField Id="seller-terms"
                           Label="ฉันยอมรับข้อตกลงผู้ขายเวอร์ชัน mvp-th-2026-07"
                           Hint="เมื่อผู้ซื้อเริ่มชำระ รายละเอียดสาระสำคัญจะถูกบันทึกและแก้ย้อนหลังไม่ได้"
                           @bind-Value="form.AcceptedTerms" />
        </section>

        <div class="create-window-actions">
            <PrimaryButton Busy="busy" Disabled="busy" BusyText="กำลังสร้างลิงก์…">
                สร้างลิงก์ข้อตกลง
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M5 12h14M14 7l5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </PrimaryButton>
            <p>รายละเอียดสำคัญจะถูกบันทึกเมื่อผู้ซื้อเริ่มชำระ</p>
        </div>
    </EditForm>
</main>

@code {
    [Parameter, SupplyParameterFromQuery(Name = "productName")]
    public string? ProductNameQuery { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "priceBaht")]
    public string? PriceBahtQuery { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "shippingFeeBaht")]
    public string? ShippingFeeBahtQuery { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "condition")]
    public string? ConditionQuery { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "shipByDurationHours")]
    public int? ShipByDurationHoursQuery { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "fulfillmentType")]
    public string? FulfillmentTypeQuery { get; set; }

    private readonly CreateSaleForm form = new();
    private const string TourStorageKey = "toklong:create-agreement-tour:v1";
    private readonly IReadOnlyList<GuidedTour.Step> tourSteps =
    [
        new("สร้างลิงก์ข้อตกลงใน 5 ส่วน", "บันทึกเฉพาะสิ่งที่ตกลงกัน ยอดเงิน กำหนดส่ง และบัญชีรับเงิน", "◎",
            "ใช้เวลาประมาณ 1 นาที และยังไม่มีการเรียกเก็บเงินในขั้นนี้",
            [new("✓", "ยืนยันผู้ขายแล้ว", "ไม่ต้องกรอกข้อมูลซ้ำ"), new("2–4", "รายละเอียดรายการ", "ข้อตกลง ยอด และบัญชี"), new("5", "ยืนยันข้อมูล", "สร้างลิงก์เมื่อพร้อม")], "tour-create-intro"),
        new("โปรไฟล์ผู้ขายพร้อมแล้ว", "เบอร์มือถือได้รับการยืนยันด้วย OTP และใช้กับรายการนี้โดยอัตโนมัติ", "●",
            "ผู้ซื้อจะเห็นเฉพาะข้อมูลผู้ขายที่นโยบายอนุญาต",
            [new("✓", "ยืนยันเบอร์แล้ว", "ลดบัญชีปลอม"), new("▤", "ตั้งค่ารับเงินแล้ว", "เลือกใช้ได้ทันที"), new("→", "สร้างข้อตกลง", "ไม่ต้องกรอกซ้ำ")], "tour-seller"),
        new("บันทึกสิ่งที่ตกลงกัน", "เลือกวิธีส่งมอบ แล้วระบุรายการ สภาพ สิทธิ์ อุปกรณ์ และข้อจำกัดไว้ในรายละเอียดเดียว", "▦",
            "รองรับสินค้าจัดส่งและสินค้าดิจิทัลที่ผู้ขายมีสิทธิ์โอน",
            [new("↔", "วิธีส่งมอบ", "Physical หรือ Digital"), new("≡", "รายละเอียดเดียว", "รวมข้อเท็จจริงสำคัญ"), new("▣", "รูปประกอบ", "ใช้รูปหรือ screenshot จริง")], "tour-product"),
        new("กำหนดยอดและเวลาส่ง", "ผู้ซื้อจะเห็นยอด กำหนดส่งมอบ และค่าจัดส่งเมื่อเป็นสินค้าที่ส่งพัสดุอย่างชัดเจน", "฿",
            "ยอดเงินเก็บเป็นจำนวนสตางค์และใช้สกุล THB เท่านั้น",
            [new("฿", "ราคาสินค้า", "ยอดของสินค้า"), new("+", "ค่าจัดส่ง", "ใส่ 0 หากส่งฟรี"), new("◷", "กำหนดส่ง", "เริ่มหลังยืนยันยอด")], "tour-price"),
        new("บัญชีนี้สำหรับรับเงิน", "ข้อมูลนี้ไม่แสดงแก่ผู้ซื้อ และระบบจะเริ่มจ่ายเงินเมื่อรายการผ่านเงื่อนไขเท่านั้น", "▤",
            "การเลือกบัญชีไม่ใช่การยืนยันว่าได้รับเงินแล้ว",
            [new("▤", "เลือกบัญชี", "จากบัญชีที่ตั้งค่าไว้"), new("↗", "แก้ไขได้", "ไปที่ตั้งค่าบัญชี"), new("✓", "รับเงินตามเงื่อนไข", "รอการยืนยันการโอน")], "tour-payout"),
        new("ตรวจสอบก่อนสร้างลิงก์", "ยืนยันว่าคุณครอบครองและมีสิทธิ์ส่งมอบรายการนี้ จากนั้นส่งลิงก์ข้อตกลงกลับไปในแชต", "✓",
            "เมื่อผู้ซื้อเริ่มชำระ รายละเอียดสาระสำคัญจะถูกบันทึกและแก้ย้อนหลังไม่ได้",
            [new("✓", "มีสิทธิ์ส่งมอบ", "ครอบครองและโอนได้"), new("≡", "ยอมรับข้อตกลง", "อ่านเงื่อนไขให้ครบ"), new("→", "สร้างลิงก์", "ส่งกลับไปในแชต")], "tour-terms")
    ];
    private bool showTour;
    private int tourStep = 1;
    private bool busy;
    private bool importBusy;
    private bool imageAnalysisBusy;
    private string listingSourceUrl = "";
    private string? importSuccess;
    private string? importError;
    private string? imageAnalysisSuccess;
    private string? imageAnalysisError;
    private string? photoSavedMessage;
    private string? error;
    private SellerProfile? profile;
    private Guid sellerId;
    private bool IsDigital => form.FulfillmentType == FulfillmentType.DigitalHandoff;
    private string PossessionAttestation => IsDigital
        ? "ฉันควบคุมรายการดิจิทัลนี้ มีสิทธิ์โอน และไม่ใช่รายการต้องห้าม"
        : "ฉันมีสินค้านี้อยู่จริง เป็นสินค้าที่จัดส่งได้ และไม่ใช่สินค้าต้องห้าม";
    private string PossessionHint => IsDigital
        ? "ไม่รองรับบริการ คริปโต วอลเล็ต บัตรของขวัญ ข้อมูลที่ได้มาโดยมิชอบ หรือรายการที่ห้ามโอน"
        : "ไม่รองรับบริการ พรีออเดอร์ อาวุธ ยา ของปลอม หรือสินค้าควบคุม";

    protected override async Task OnInitializedAsync()
    {
        var authentication = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var sellerIdValue = authentication.User.FindFirst(
            System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (!Guid.TryParse(sellerIdValue, out sellerId))
            return;

        profile = await Sender.Send(new GetSellerProfileQuery(sellerId));
        if (profile.PayoutAccounts.Count == 0)
        {
            Navigation.NavigateTo(
                "/seller/settings/payouts?returnUrl=%2Fsales%2Fcreate",
                forceLoad: true);
            return;
        }

        form.PayoutAccountId ??= profile.PayoutAccounts
            .FirstOrDefault(x => x.IsDefault)?.Id
            ?? profile.PayoutAccounts[0].Id;
    }

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(ProductNameQuery))
            form.ProductName = ProductNameQuery.Trim();
        if (!string.IsNullOrWhiteSpace(PriceBahtQuery))
            form.PriceBaht = PriceBahtQuery.Trim();
        if (!string.IsNullOrWhiteSpace(ShippingFeeBahtQuery))
            form.ShippingFeeBaht = ShippingFeeBahtQuery.Trim();
        if (Enum.TryParse<FulfillmentType>(FulfillmentTypeQuery, out var fulfillmentType))
            form.FulfillmentType = fulfillmentType;
        if (Enum.TryParse<ConditionCode>(ConditionQuery, out var condition))
            form.Condition = condition;
        if (ShipByDurationHoursQuery is 48 or 72 or 120)
            form.ShipByDurationHours = ShipByDurationHoursQuery.Value;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        showTour = await JS.InvokeAsync<bool>("toklongGuide.shouldShow", TourStorageKey);
        if (showTour)
            StateHasChanged();
    }

    private bool IsTourStep(int step) => showTour && tourStep == step;

    private static string ConditionLabel(ConditionCode condition) => condition switch
    {
        ConditionCode.New => "สินค้าใหม่",
        ConditionCode.UsedDefects => "มือสอง · มีตำหนิ",
        ConditionCode.UsedGood => "มือสอง · สภาพดี",
        _ => "ตามรายละเอียดข้อตกลง"
    };

    private static string FulfillmentLabel(FulfillmentType type) =>
        type == FulfillmentType.DigitalHandoff
            ? "สินค้าดิจิทัล · ผู้ซื้อยืนยันรับ"
            : "สินค้าจัดส่ง · ใช้ Tracking";

    private static string ShipByLabel(int hours) => hours switch
    {
        24 => "24 ชั่วโมง",
        72 => "72 ชั่วโมง",
        120 => "5 วัน",
        _ => "48 ชั่วโมง"
    };

    private static string BankLabel(string code) => code switch
    {
        "SCB" => "ธนาคารไทยพาณิชย์",
        "KTB" => "ธนาคารกรุงไทย",
        "BBL" => "ธนาคารกรุงเทพ",
        "BAY" => "ธนาคารกรุงศรีอยุธยา",
        "TTB" => "ธนาคารทหารไทยธนชาต",
        "GSB" => "ธนาคารออมสิน",
        "BAAC" => "ธนาคารเพื่อการเกษตรและสหกรณ์การเกษตร",
        _ => "ธนาคารกสิกรไทย"
    };

    private string SelectedPayoutLabel()
    {
        var account = profile?.PayoutAccounts.FirstOrDefault(
            x => x.Id == form.PayoutAccountId);
        return account is null
            ? "เลือกบัญชีรับเงิน"
            : $"{BankLabel(account.BankCode)} · {account.MaskedNumber}";
    }

    private static string MaskPhone(string? phone) =>
        string.IsNullOrWhiteSpace(phone) || phone.Length < 4
            ? ""
            : $"0••-•••-{phone[^4..]}";

    private static string PreviewMoney(string? value) =>
        decimal.TryParse(value, out var amount) ? $"฿{amount:N0}" : "฿0";

    private async Task NextTourStepAsync()
    {
        if (tourStep < tourSteps.Count)
        {
            tourStep++;
            StateHasChanged();
            return;
        }
        await CompleteTourAsync();
    }

    private void PreviousTourStep()
    {
        if (tourStep > 1)
            tourStep--;
    }

    private async Task CompleteTourAsync()
    {
        showTour = false;
        StateHasChanged();
        await JS.InvokeVoidAsync("toklongGuide.complete", TourStorageKey);
    }

    private async Task SubmitAsync()
    {
        busy = true;
        error = null;
        try
        {
            var result = await Sender.Send(new CreateSaleCommand(
                sellerId,
                form.PayoutAccountId
                    ?? throw new InvalidOperationException("กรุณาเลือกบัญชีรับเงิน"),
                form.FulfillmentType,
                form.ProductName,
                IsDigital ? "สินค้าดิจิทัลที่โอนได้" : form.Category,
                form.Condition,
                form.Description, form.KnownDefects, form.PhotoUrl, MoneyParser.ToSatang(form.PriceBaht),
                IsDigital ? 0 : MoneyParser.ToSatang(form.ShippingFeeBaht), form.ShipByDurationHours,
                form.AcceptedTerms, form.ProhibitedGoodsAttested));
            Navigation.NavigateTo($"/seller/{result.SellerAccessToken}");
        }
        catch (Exception exception)
        {
            error = exception.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ImportListingAsync()
    {
        importBusy = true;
        importSuccess = null;
        importError = null;
        try
        {
            var imported = await Sender.Send(new ImportListingCommand(listingSourceUrl));
            if (!string.IsNullOrWhiteSpace(imported.ProductName))
                form.ProductName = imported.ProductName;
            if (!string.IsNullOrWhiteSpace(imported.Description))
                form.Description = imported.Description;
            if (!string.IsNullOrWhiteSpace(imported.PhotoUrl))
            {
                form.PhotoUrl = imported.PhotoUrl;
                photoSavedMessage = "ใช้รูปจากข้อมูลอ้างอิงแล้ว กรุณาตรวจสอบว่าเป็นรูปที่ตกลงกัน";
            }
            if (imported.PriceBaht.HasValue)
                form.PriceBaht = imported.PriceBaht.Value.ToString(
                    "0.##", System.Globalization.CultureInfo.InvariantCulture);
            form.Category = imported.Category;
            form.Condition = imported.Condition;

            importSuccess =
                $"ดึงจาก {imported.SourceSite}: {string.Join(" · ", imported.ExtractedFields)} กรุณาตรวจราคา สภาพ ตำหนิ และรูปอีกครั้ง";
        }
        catch (Exception exception)
        {
            importError = exception.Message;
        }
        finally
        {
            importBusy = false;
        }
    }

    private async Task AnalyzeListingImagesAsync(
        IReadOnlyList<ListingImageInput> images)
    {
        imageAnalysisBusy = true;
        imageAnalysisSuccess = null;
        imageAnalysisError = null;
        try
        {
            var analyzed = await Sender.Send(new AnalyzeListingImagesCommand(images));
            if (!string.IsNullOrWhiteSpace(analyzed.ProductName))
                form.ProductName = analyzed.ProductName;
            if (!string.IsNullOrWhiteSpace(analyzed.Description))
                form.Description = analyzed.Description;
            if (!string.IsNullOrWhiteSpace(analyzed.KnownDefects))
            {
                form.Description = string.IsNullOrWhiteSpace(form.Description)
                    ? $"ตำหนิที่พบ: {analyzed.KnownDefects}"
                    : $"{form.Description}\nตำหนิที่พบ: {analyzed.KnownDefects}";
            }
            form.KnownDefects = "";
            if (analyzed.PriceBaht.HasValue)
                form.PriceBaht = analyzed.PriceBaht.Value.ToString(
                    "0.##", System.Globalization.CultureInfo.InvariantCulture);
            form.Category = analyzed.Category;
            form.Condition = analyzed.Condition;
            form.PhotoUrl = Navigation.ToAbsoluteUri(analyzed.ProductPhotoPath).ToString();
            photoSavedMessage = "ใช้รูปที่เลือกเป็นรูปประกอบข้อตกลงแล้ว";

            var confidence = analyzed.Confidence switch
            {
                "high" => "ความมั่นใจสูง",
                "medium" => "ความมั่นใจปานกลาง",
                _ => "ควรตรวจทุกช่องอย่างละเอียด"
            };
            imageAnalysisSuccess =
                $"{string.Join(" · ", analyzed.ExtractedFields)} · {confidence} กรุณาตรวจข้อมูลก่อนสร้างลิงก์";
        }
        catch (Exception exception)
        {
            imageAnalysisError = exception.Message;
        }
        finally
        {
            imageAnalysisBusy = false;
        }
    }

    private async Task SaveListingPhotoAsync(ListingImageInput image)
    {
        imageAnalysisBusy = true;
        photoSavedMessage = null;
        imageAnalysisError = null;
        try
        {
            var photoPath = await Sender.Send(new SaveListingPhotoCommand(image));
            form.PhotoUrl = Navigation.ToAbsoluteUri(photoPath).ToString();
            photoSavedMessage = "รูปนี้จะปรากฏในหน้าที่ผู้ซื้อตรวจสอบ";
        }
        catch (Exception exception)
        {
            imageAnalysisError = exception.Message;
        }
        finally
        {
            imageAnalysisBusy = false;
        }
    }

}
