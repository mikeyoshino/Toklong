@page "/buyer/sign-in"

<PageTitle>เข้าสู่ระบบผู้ซื้อ — TOKLONG</PageTitle>
<AppHeader BackHref="/" BackLabel="กลับหน้าแรก" />

<main class="auth-shell">
    <section class="auth-card">
        <div class="auth-icon" aria-hidden="true">◎</div>
        <span class="eyebrow"><span class="eyebrow-dot"></span>สำหรับผู้ซื้อ</span>
        <h1>เข้าสู่ระบบด้วยเบอร์โทรศัพท์</h1>
        <p>กรอกเบอร์โทรศัพท์ที่ใช้สมัครไว้</p>

        @if (!string.IsNullOrWhiteSpace(Error))
        {
            <AlertMessage Message="@Error" Danger />
        }

        <form method="post" action="/auth/buyer/otp/request" class="auth-form">
            <AntiforgeryToken />
            <input type="hidden" name="mode" value="sign-in" />
            <input type="hidden" name="returnUrl" value="@SafeReturnUrl" />
            <label class="form-label" for="phone">เบอร์มือถือ</label>
            <input class="form-control" id="phone" name="phone"
                   type="tel" inputmode="tel" autocomplete="tel"
                   placeholder="08X XXX XXXX" required />
            <button class="button button-primary" type="submit">
                รับรหัสยืนยัน
            </button>
        </form>

        <a class="auth-secondary"
           href="@($"/buyer/sign-up?returnUrl={Uri.EscapeDataString(SafeReturnUrl)}")">
            ยังไม่มีบัญชี? สมัครสมาชิก
        </a>

        <div class="auth-trust">
            <span aria-hidden="true">✓</span>
            <p><strong>ข้อมูลผูกกับข้อเสนอ</strong>ผู้ขายจะเห็นชื่อผู้ซื้อจากบัญชีที่ยืนยันเบอร์แล้ว</p>
        </div>
    </section>
</main>

@code {
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery] public string? Error { get; set; }

    private string SafeReturnUrl =>
        !string.IsNullOrWhiteSpace(ReturnUrl) && ReturnUrl.StartsWith('/')
            && !ReturnUrl.StartsWith("//", StringComparison.Ordinal)
                ? ReturnUrl
                : "/offers/create";
}
