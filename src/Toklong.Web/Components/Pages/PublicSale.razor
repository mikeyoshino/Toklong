@page "/p/{Token}"
@rendermode InteractiveServer
@using Toklong.Application.Features.Checkout.BeginCheckout
@using Toklong.Application.Features.Transactions.GetTransaction
@using Toklong.Application.Transactions
@using Toklong.Domain.Transactions
@using Toklong.Web.Models
@inject Toklong.Web.Services.ApplicationRequestSender Sender
@inject NavigationManager Navigation

<PageTitle>@(transaction is null ? "รายการซื้อขาย" : transaction.ProductName) — TOKLONG</PageTitle>

<AppHeader BackHref="/" BackLabel="TOKLONG คืออะไร" />

<main class="page-shell">
    @if (loading)
    {
        <div class="loading-state">กำลังเปิดรายละเอียดรายการ…</div>
    }
    else if (!string.IsNullOrWhiteSpace(error) && transaction is null)
    {
        <AlertMessage Message="@error" Danger />
    }
    else if (transaction is not null)
    {
        <div class="transaction-heading">
            <div>
                <span class="eyebrow"><span class="eyebrow-dot"></span>ลิงก์ข้อตกลง</span>
                <h1>ตรวจรายละเอียดก่อนชำระ</h1>
            </div>
            <StatusBadge State="transaction.State" Label="transaction.StateLabel" />
        </div>

        <div class="mobile-only mobile-flow-head">
            <MobileSceneIntro Step="2"
                              Kicker="ตรวจสอบก่อนจ่าย"
                              Title="ตรวจสอบและชำระ"
                              Subtitle="ผู้ซื้อเห็นรายการ ผู้ขาย ยอดรวม และเงื่อนไขการจ่ายเงินในหน้าเดียว" />
            <MobileTransactionCard Transaction="transaction" />
            <div class="protection-note">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M12 3 5 6v5c0 4.6 2.7 8.3 7 10 4.3-1.7 7-5.4 7-10V6l-7-3Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
                    <path d="m9 12 2 2 4-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span>@ReleaseSummary</span>
            </div>
        </div>

        <div class="transaction-grid">
            <div class="desktop-transaction-detail">
                <TransactionSummary Transaction="transaction" />

                <section class="form-card terms-card">
                    <h2>เงื่อนไขสำคัญก่อนชำระ</h2>
                    <ul class="rule-list">
                        <li><strong>กำหนดส่งมอบ:</strong> ภายใน @transaction.ShipByDurationHours ชั่วโมงหลังระบบยืนยันยอดชำระ</li>
                        @if (IsDigital)
                        {
                            <li><strong>วิธีส่งมอบ:</strong> ส่งผ่านช่องทางที่ทั้งสองฝ่ายตกลงกัน ห้ามส่งรหัสผ่านหรือรหัสกู้คืนผ่าน TOKLONG</li>
                            <li><strong>การจ่ายให้ผู้ขาย:</strong> เกิดได้เมื่อผู้ซื้อยืนยันรับ หรือผ่านการตรวจสอบที่ได้รับสิทธิ์เท่านั้น</li>
                            <li><strong>ไม่มีการจ่ายอัตโนมัติ:</strong> การที่ผู้ขายกดว่าส่งมอบแล้วหรือเวลาผ่านไป ไม่ทำให้เริ่มจ่ายเงิน</li>
                        }
                        else
                        {
                            <li><strong>เริ่มช่วงตรวจสินค้า:</strong> เมื่อขนส่งยืนยันการนำส่ง ไม่ใช่วันที่ชำระหรือวันที่ผู้ขายกรอก Tracking</li>
                            <li><strong>กำหนดแจ้งปัญหา:</strong> 168 ชั่วโมงนับจากเวลานำส่งที่ตรวจสอบได้</li>
                            <li><strong>การจ่ายให้ผู้ขาย:</strong> เมื่อผู้ซื้อยืนยันรับ หรือครบกำหนดโดยไม่มีข้อโต้แย้ง แล้วจึงเริ่มคำสั่งจ่าย</li>
                            <li><strong>หาก Tracking ตรวจไม่ได้:</strong> ระบบไม่จ่ายอัตโนมัติ ต้องมีผู้ซื้อยืนยันหรือได้รับการตรวจสอบที่ได้รับสิทธิ์</li>
                        }
                    </ul>
                </section>

                <TransactionDetails Transaction="transaction" />
            </div>

            <aside>
                @if (transaction.State == TransactionState.LinkActive)
                {
                    <EditForm Model="form" OnValidSubmit="CheckoutAsync" FormName="buyer-checkout" class="form-card sticky-card mobile-checkout-card">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="validation-summary" />
                        <h2>@(IsDigital ? "ข้อมูลผู้ซื้อ" : "ข้อมูลผู้รับ")</h2>
                        <p class="form-intro">@(IsDigital ? "ใช้ยืนยันตัวตนกับข้อตกลงนี้" : "ข้อมูลนี้ใช้กับรายการและการจัดส่งเท่านั้น")</p>
                        <TextField Id="buyer-name" Label="@(IsDigital ? "ชื่อผู้ซื้อ" : "ชื่อผู้รับ")" Autocomplete="name" Required @bind-Value="form.BuyerDisplayName" />
                        <TextField Id="buyer-contact" Label="เบอร์โทรหรืออีเมล" Autocomplete="tel" Required @bind-Value="form.BuyerContact" />
                        @if (!IsDigital)
                        {
                            <TextAreaField Id="address" Label="ที่อยู่จัดส่ง" Required @bind-Value="form.DeliveryAddress" />
                        }
                        <CheckboxField Id="buyer-terms"
                                       Label="ฉันตรวจรายละเอียดและยอมรับข้อตกลงของรายการ"
                                       Hint="รวมสินค้า ตำหนิ ยอดรวม กำหนดส่ง ช่วงแจ้งปัญหา และเงื่อนไขการจ่ายให้ผู้ขาย"
                                       @bind-Value="form.AcceptedTerms" />
                        <AlertMessage Message="@error" Danger />
                        <PrimaryButton Busy="busy" Disabled="busy" BusyText="กำลังสร้างเลขชำระ…">
                            ดำเนินการชำระ @Money(transaction.BuyerTotalSatang)
                        </PrimaryButton>
                    </EditForm>
                }
                else
                {
                    <section class="form-card sticky-card">
                        <h2>ลิงก์นี้มีผู้ซื้อเริ่มชำระแล้ว</h2>
                        <p>เพื่อป้องกันการชำระซ้ำ รายการสินค้าหนึ่งชิ้นรองรับผู้ซื้อหนึ่งคน หากคุณเป็นผู้ซื้อให้เปิดลิงก์รายการส่วนตัวที่ได้รับหลังยืนยันข้อมูล</p>
                    </section>
                }
            </aside>
        </div>
    }
</main>

@code {
    [Parameter] public string Token { get; set; } = "";
    private readonly CheckoutForm form = new();
    private TransactionView? transaction;
    private bool loading = true;
    private bool busy;
    private string? error;
    private bool IsDigital =>
        transaction?.FulfillmentType == FulfillmentType.DigitalHandoff;
    private string ReleaseSummary => IsDigital
        ? "ผู้ขายได้รับเงินเมื่อคุณยืนยันว่าได้รับรายการดิจิทัลแล้ว หรือผ่านการตรวจสอบที่ได้รับสิทธิ์ ไม่มีการจ่ายอัตโนมัติจากเวลา"
        : "ผู้ขายได้รับเงินเมื่อคุณยืนยันรับสินค้า หรือครบ 7 วันหลังขนส่งยืนยันการนำส่งโดยไม่มีข้อโต้แย้ง";

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        try
        {
            transaction = await Sender.Send(new GetPublicTransactionQuery(Token));
        }
        catch (Exception exception)
        {
            error = exception.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task CheckoutAsync()
    {
        busy = true;
        error = null;
        try
        {
            transaction = await Sender.Send(new BeginCheckoutCommand(
                Token,
                form.BuyerDisplayName,
                form.BuyerContact,
                IsDigital ? "" : form.DeliveryAddress,
                form.AcceptedTerms));
            Navigation.NavigateTo($"/buyer/{transaction.BuyerAccessToken}");
        }
        catch (Exception exception)
        {
            error = exception.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private static string Money(long satang) => $"฿{satang / 100m:N2}";
}
