@page "/buyer/{Token}"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Buyer")]
@implements IAsyncDisposable
@using Toklong.Application.Features.Checkout.BeginCheckout
@using Toklong.Application.Features.Disputes.OpenDispute
@using Toklong.Application.Features.Payouts.ConfirmReceipt
@using Toklong.Application.Features.Transactions.GetTransaction
@using Toklong.Application.Transactions
@using Toklong.Domain.Transactions
@using Toklong.Web.Models
@inject Toklong.Web.Services.ApplicationRequestSender Sender
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IConfiguration Configuration
@inject NavigationManager Navigation

<PageTitle>รายการผู้ซื้อ — TOKLONG</PageTitle>

<AppHeader BackHref="/" BackLabel="หน้าแรก" />

<main class="page-shell">
    @if (loading)
    {
        <div class="loading-state">กำลังเปิดรายการผู้ซื้อ…</div>
    }
    else if (transaction is null)
    {
        <AlertMessage Message="@error" Danger />
    }
    else
    {
        <div class="transaction-heading">
            <div><span class="eyebrow"><span class="eyebrow-dot"></span>มุมมองผู้ซื้อ</span><h1>@transaction.ProductName</h1></div>
            <span aria-live="polite" aria-atomic="true">
                <StatusBadge State="transaction.State" Label="@transaction.StateLabel" />
            </span>
        </div>

        <AlertMessage Message="@success" />
        <AlertMessage Message="@error" Danger />

        <div class="mobile-only mobile-flow-head">
            <MobileSceneIntro Step="@BuyerStep"
                              Kicker="@BuyerKicker"
                              Title="@BuyerTitle"
                              Subtitle="@BuyerSubtitle" />
            @if (transaction.State == TransactionState.DeliveredDisputeWindow)
            {
                <div class="mobile-card delivery-card">
                    <span class="delivery-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <path d="M3.5 7.5h11v8h-11zM14.5 10h3l3 3v2.5h-6V10Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
                            <path d="m7 12 2 2 3-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </span>
                    <h4>ขนส่งยืนยันการนำส่งแล้ว</h4>
                    <p>@transaction.CarrierCode · @transaction.TrackingNumber</p>
                </div>
                <div class="countdown-shell">
                    <div class="countdown-ring"><span><strong>7</strong>วัน</span></div>
                    <div class="countdown-copy"><strong>แจ้งปัญหาได้ถึง @ThaiDate(transaction.DisputeWindowEndsAt)</strong><small>หากไม่มีข้อโต้แย้ง ระบบจึงเริ่มคำสั่งจ่ายให้ผู้ขาย</small></div>
                </div>
            }
            else if (transaction.State == TransactionState.DigitalDeliverySubmitted)
            {
                <div class="mobile-card delivery-card">
                    <span class="delivery-icon">✓</span>
                    <h4>ผู้ขายแจ้งว่าส่งมอบแล้ว</h4>
                    <p>ตรวจผ่านช่องทางที่ตกลงกันก่อนกดยืนยัน</p>
                </div>
            }
            else
            {
                <MobileTransactionCard Transaction="transaction" />
            }
        </div>

        <div class="transaction-grid">
            <div class="desktop-transaction-detail">
                <TransactionSummary Transaction="transaction" />
                <TransactionDetails Transaction="transaction" />
            </div>
            <aside>
                @if (transaction.State == TransactionState.AwaitingSellerAcceptance)
                {
                    <section class="action-card sticky-card">
                        @if (string.IsNullOrWhiteSpace(transaction.PhotoUrl))
                        {
                            <div class="step-label">ข้อเสนอเดิมไม่มีรูป</div>
                            <h2>สร้างข้อเสนอใหม่พร้อมรูป</h2>
                            <p>ข้อเสนอนี้สร้างก่อนเปลี่ยน flow จึงไม่มีรูปสินค้า ผู้ขายแก้หรือเพิ่มรูปแทนไม่ได้</p>
                            <a class="button button-primary" href="/offers/create">สร้างข้อเสนอใหม่</a>
                            <div class="notice">ข้อเสนอใหม่ต้องมีรูปและรายละเอียดจากผู้ซื้อก่อนส่งให้ผู้ขายยืนยัน</div>
                        }
                        else
                        {
                            <div class="step-label">ขั้นที่ 2 · รอผู้ขายยืนยัน</div>
                            <h2>ส่งลิงก์นี้ให้ผู้ขาย</h2>
                            <div class="copy-value">@SellerOfferUrl</div>
                            <p>ผู้ขายตอบได้ถึง <strong>@ThaiDate(transaction.SellerAcceptanceDeadlineAt)</strong> และต้องเข้าสู่ระบบด้วยเบอร์โทรศัพท์ก่อนยืนยันหรือปฏิเสธ คุณยังไม่ต้องชำระเงิน</p>
                            <a class="button button-primary" href="@SellerOfferUrl">เปิดลิงก์ที่ผู้ขายเห็น</a>
                            <div class="notice">หน้านี้ตรวจสถานะใหม่อัตโนมัติ คุณปิดหน้าและกลับมาด้วยลิงก์ส่วนตัวนี้ได้</div>
                        }
                    </section>
                }
                else if (transaction.State == TransactionState.SellerAcceptedAwaitingPayment)
                {
                    @if (transaction.FulfillmentType ==
                             FulfillmentType.DigitalHandoff)
                    {
                        <EditForm Model="checkoutForm" OnValidSubmit="BeginCheckoutAsync"
                                  FormName="buyer-offer-checkout"
                                  class="form-card sticky-card">
                            <DataAnnotationsValidator />
                            <ValidationSummary class="validation-summary" />
                            <div class="step-label success-text">ผู้ขายยืนยันแล้ว</div>
                            <h2>ตรวจฉบับสุดท้ายก่อนชำระ</h2>
                            <div class="notice">ชำระภายใน <strong>@ThaiDate(transaction.BuyerPaymentDeadlineAt)</strong> ไม่เช่นนั้นรายการจะปิดและผู้ขายไม่ต้องจองสินค้าไว้</div>
                            <p>รายละเอียด รูป ราคาสินค้า ยอดชำระ และกำหนดส่งด้านซ้ายถูกล็อกแล้ว กรุณาตรวจอีกครั้งก่อนชำระ</p>
                            <CheckboxField Id="buyer-offer-final-terms"
                                           Label="ฉันตรวจและยอมรับรายละเอียดฉบับสุดท้าย"
                                           Hint="รวมรูป สภาพ ตำหนิ ราคาสินค้า ยอดชำระ กำหนดส่ง และเงื่อนไขการจ่ายให้ผู้ขาย"
                                           @bind-Value="checkoutForm.AcceptedTerms" />
                            <PrimaryButton Busy="busy" Disabled="busy"
                                           BusyText="กำลังเริ่มชำระ…">
                                ยอมรับข้อตกลงและชำระ @Money(transaction.BuyerTotalSatang)
                            </PrimaryButton>
                        </EditForm>
                    }
                    else
                    {
                        <section class="action-card sticky-card">
                            <div class="step-label success-text">ผู้ขายยืนยันแล้ว</div>
                            <h2>ทำรายการต่อในแอป TOKLONG</h2>
                            <div class="notice">
                                รายการจัดส่งต้องเลือกความคุ้มครองและจองขนส่งในแอป TOKLONG ก่อนชำระ
                            </div>
                            <p>เปิดรายการนี้ในแอปเพื่อตรวจตัวเลือกและยอดสุดท้าย ระบบจะเปิดการชำระเมื่อจองขนส่งสำเร็จแล้ว</p>
                        </section>
                    }
                }
                else if (transaction.State == TransactionState.PaymentPending)
                {
                    <section class="action-card sticky-card">
                        <div class="step-label">ขั้นที่ 2 จาก 4 · ชำระเงิน</div>
                        <h2>โอนด้วยเลขอ้างอิงนี้</h2>
                        <div class="bank-card">
                            <div><span>ธนาคาร</span><strong>@BankName</strong></div>
                            <div><span>ชื่อบัญชี</span><strong>@AccountName</strong></div>
                            <div><span>เลขบัญชี</span><strong>@AccountNumber</strong></div>
                            <div><span>ยอดที่ต้องโอน</span><strong>@Money(transaction.BuyerTotalSatang)</strong></div>
                            <div><span>เลขอ้างอิง</span><strong>@transaction.PaymentReference</strong></div>
                        </div>
                        <div class="deadline-box">
                            <span>ระบบต้องได้รับการยืนยันการจ่ายภายใน</span>
                            <strong>@ThaiDate(transaction.BuyerPaymentDeadlineAt)</strong>
                        </div>
                        <div class="notice">
                            หลังโอน ระบบจะแสดง “กำลังตรวจสอบการชำระ” จนกว่ารายการเดินบัญชีจะได้รับการตรวจสอบ
                            สลิปอย่างเดียวไม่ทำให้ผู้ขายเห็นว่าส่งสินค้าได้
                        </div>
                    </section>
                }
                else if (transaction.State == TransactionState.Expired)
                {
                    <section class="action-card sticky-card">
                        <div class="step-label">รายการปิดแล้ว</div>
                        @if (transaction.ExpirationReason ==
                             TransactionExpirationReason.SellerDidNotRespond)
                        {
                            <h2>ผู้ขายไม่ได้ตอบภายในเวลา</h2>
                            <p>ไม่มีการเก็บเงินจากรายการนี้ หากยังต้องการซื้อ สามารถใช้รายละเอียดเดิมเป็นแนวทางแล้วส่งข้อเสนอใหม่ให้ผู้ขาย</p>
                        }
                        else
                        {
                            <h2>หมดเวลาชำระ</h2>
                            <p>ผู้ขายไม่ต้องจองสินค้าไว้แล้ว หากยังต้องการซื้อ ต้องส่งข้อเสนอใหม่และให้ผู้ขายยืนยันอีกครั้ง</p>
                        }
                        <a class="button button-primary" href="/offers/create">สร้างข้อเสนอใหม่</a>
                    </section>
                }
                else if (transaction.State == TransactionState.PaidAwaitingShipment)
                {
                    <section class="action-card sticky-card">
                        <div class="step-label success-text">ยืนยันยอดชำระแล้ว</div>
                        <h2>รอผู้ขายจัดส่ง</h2>
                        <div class="deadline-box"><span>ผู้ขายต้องส่งภายใน</span><strong>@ThaiDate(transaction.ShipByAt)</strong></div>
                        <p>หากไม่มี Tracking ที่ตรวจสอบได้ภายในกำหนด รายการต้องเข้าสู่ขั้นตอนตรวจสอบการยกเลิก/คืนเงิน</p>
                    </section>
                }
                else if (transaction.State == TransactionState.PaidAwaitingDigitalDelivery)
                {
                    <section class="action-card sticky-card">
                        <div class="step-label success-text">ยืนยันยอดชำระแล้ว</div>
                        <h2>รอผู้ขายส่งมอบ</h2>
                        <div class="deadline-box"><span>ผู้ขายต้องส่งมอบภายใน</span><strong>@ThaiDate(transaction.ShipByAt)</strong></div>
                        <p>ผู้ขายจะส่งผ่านช่องทางที่ตกลงกัน TOKLONG จะไม่ขอให้คุณรับรหัสผ่านหรือข้อมูลลับผ่านหน้านี้</p>
                    </section>
                }
                else if (transaction.State is TransactionState.TrackingSubmitted or TransactionState.InTransit)
                {
                    <section class="action-card sticky-card">
                        <div class="step-label">ขั้นที่ 3 จาก 4 · การจัดส่ง</div>
                        <h2>@(transaction.State == TransactionState.InTransit ? "พัสดุกำลังเดินทาง" : "รอขนส่งตรวจสอบ Tracking")</h2>
                        <div class="bank-card">
                            <div><span>ขนส่ง</span><strong>@transaction.CarrierCode</strong></div>
                            <div><span>Tracking</span><strong>@transaction.TrackingNumber</strong></div>
                        </div>
                        <p>ยังไม่เริ่มนับ 72 ชั่วโมงจนกว่าขนส่งยืนยันการนำส่งสำเร็จ</p>
                    </section>
                }
                else if (transaction.State == TransactionState.DeliveredDisputeWindow)
                {
                    <section class="action-card mobile-delivery-action">
                        <div class="step-label">ขั้นที่ 4 จาก 4 · ตรวจสินค้า</div>
                        <h2>ขนส่งยืนยันการนำส่งแล้ว</h2>
                        <div class="deadline-box"><span>แจ้งปัญหาได้ถึง</span><strong>@ThaiDate(transaction.DisputeWindowEndsAt)</strong></div>
                        <p>กรุณาตรวจสินค้า รูป อุปกรณ์ สภาพ และตำหนิ ก่อนยืนยัน การยืนยันจะเริ่มขั้นตอนจ่ายเงินให้ผู้ขาย</p>
                        <PrimaryButton Type="button" Busy="busy" Disabled="busy" @onclick="ConfirmReceiptAsync">
                            ตรวจแล้ว ทุกอย่างเรียบร้อย
                        </PrimaryButton>
                    </section>

                    <EditForm Model="disputeForm" OnValidSubmit="OpenDisputeAsync" FormName="buyer-dispute" class="form-card danger-card mobile-dispute-card">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="validation-summary" />
                        <h2>แจ้งปัญหา</h2>
                        <SelectField TValue="DisputeReason" Id="reason" Label="ประเภทปัญหา" DisplayText="@DisputeReasonLabel(disputeForm.Reason)" Required @bind-Value="disputeForm.Reason">
                            <option value="@DisputeReason.NotReceived">ไม่ได้รับสินค้าแม้ขนส่งแจ้งว่าส่งแล้ว</option>
                            <option value="@DisputeReason.WrongItem">ได้รับสินค้าผิด</option>
                            <option value="@DisputeReason.NotAsDescribed">สินค้าไม่ตรงรายละเอียดอย่างมีนัยสำคัญ</option>
                            <option value="@DisputeReason.UndisclosedDamage">มีความเสียหายหรือตำหนิที่ไม่ได้แจ้ง</option>
                            <option value="@DisputeReason.SuspectedCounterfeit">สงสัยว่าเป็นสินค้าปลอม</option>
                            <option value="@DisputeReason.EmptyOrTamperedParcel">พัสดุว่างหรือมีร่องรอยเปิด</option>
                            <option value="@DisputeReason.Other">อื่น ๆ</option>
                        </SelectField>
                        <TextAreaField Id="statement" Label="รายละเอียดปัญหา" Hint="อธิบายสิ่งที่พบและหลักฐานที่มี โดยหลีกเลี่ยงข้อมูลส่วนตัวเกินจำเป็น" Required @bind-Value="disputeForm.Statement" />
                        <PrimaryButton Busy="busy" Disabled="busy" Secondary>เปิดข้อโต้แย้งและพักการจ่าย</PrimaryButton>
                    </EditForm>
                }
                else if (transaction.State == TransactionState.DigitalDeliverySubmitted)
                {
                    <section class="action-card mobile-delivery-action">
                        <div class="step-label">ขั้นที่ 4 จาก 4 · ตรวจการส่งมอบ</div>
                        <h2>ผู้ขายแจ้งว่าส่งมอบแล้ว</h2>
                        <div class="notice">
                            @(transaction.DigitalDeliveryStatement ?? "ผู้ขายส่งมอบผ่านช่องทางที่ตกลงกัน")
                        </div>
                        <p>ตรวจว่าคุณได้รับและควบคุมรายการดิจิทัลได้ตามข้อตกลงก่อนยืนยัน การยืนยันจะเริ่มขั้นตอนจ่ายเงินให้ผู้ขาย</p>
                        <PrimaryButton Type="button" Busy="busy" Disabled="busy" @onclick="ConfirmReceiptAsync">
                            ได้รับรายการดิจิทัลแล้ว
                        </PrimaryButton>
                    </section>

                    <EditForm Model="disputeForm" OnValidSubmit="OpenDisputeAsync" FormName="buyer-digital-dispute" class="form-card danger-card mobile-dispute-card">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="validation-summary" />
                        <h2>ยังไม่ได้รับหรือมีปัญหา</h2>
                        <SelectField TValue="DisputeReason" Id="digital-reason" Label="ประเภทปัญหา" DisplayText="@DisputeReasonLabel(disputeForm.Reason)" Required @bind-Value="disputeForm.Reason">
                            <option value="@DisputeReason.NotReceived">ยังไม่ได้รับข้อมูลหรือสิทธิ์</option>
                            <option value="@DisputeReason.WrongItem">ได้รับรายการผิด</option>
                            <option value="@DisputeReason.NotAsDescribed">รายการหรือสิทธิ์ไม่ตรงข้อตกลง</option>
                            <option value="@DisputeReason.Other">อื่น ๆ</option>
                        </SelectField>
                        <TextAreaField Id="digital-statement" Label="รายละเอียดปัญหา" Hint="อธิบายสิ่งที่เกิดขึ้นโดยไม่ใส่รหัสผ่าน รหัสกู้คืน หรือข้อมูลลับ" Required @bind-Value="disputeForm.Statement" />
                        <PrimaryButton Busy="busy" Disabled="busy" Secondary>เปิดข้อโต้แย้งและพักการจ่าย</PrimaryButton>
                    </EditForm>
                }
                else
                {
                    <BuyerStateCard Transaction="transaction" />
                }
            </aside>
        </div>
    }
</main>

@code {
    [Parameter] public string Token { get; set; } = "";
    private readonly DisputeForm disputeForm = new();
    private readonly BuyerOfferCheckoutForm checkoutForm = new();
    private Guid buyerId;
    private TransactionView? transaction;
    private bool loading = true;
    private bool busy;
    private string? error;
    private string? success;
    private string BankName => Configuration["ManualBank:BankName"] ?? "กรุณาตั้งค่า";
    private string AccountName => Configuration["ManualBank:AccountName"] ?? "กรุณาตั้งค่า";
    private string AccountNumber => Configuration["ManualBank:AccountNumber"] ?? "กรุณาตั้งค่า";
    private readonly CancellationTokenSource refreshCancellation = new();
    private Task? refreshTask;
    private string SellerOfferUrl =>
        $"{Navigation.BaseUri.TrimEnd('/')}/offer/{transaction?.PublicToken}";

    protected override async Task OnParametersSetAsync()
    {
        var authentication =
            await AuthenticationStateProvider.GetAuthenticationStateAsync();
        Guid.TryParse(
            authentication.User.FindFirst(
                System.Security.Claims.ClaimTypes.NameIdentifier)?.Value,
            out buyerId);
        await RefreshAsync();
        refreshTask ??= RefreshLoopAsync(refreshCancellation.Token);
    }

    private async Task RefreshAsync()
    {
        try
        {
            transaction = await Sender.Send(new GetBuyerTransactionQuery(Token));
            if (buyerId == Guid.Empty || transaction.BuyerId != buyerId)
            {
                transaction = null;
                throw new UnauthorizedAccessException(
                    "บัญชีผู้ซื้อนี้ไม่มีสิทธิ์เปิดรายการ");
            }
            error = null;
        }
        catch (Exception exception)
        {
            error = exception.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task RefreshLoopAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(async () =>
                {
                    await RefreshAsync();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task BeginCheckoutAsync()
    {
        busy = true;
        error = null;
        try
        {
            transaction = await Sender.Send(
                new BeginBuyerOfferCheckoutCommand(
                    Token,
                    buyerId,
                    checkoutForm.AcceptedTerms));
            success = "เริ่มขั้นตอนชำระแล้ว กรุณาชำระตามข้อมูลด้านล่าง";
        }
        catch (Exception exception)
        {
            error = exception.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ConfirmReceiptAsync()
    {
        busy = true;
        error = null;
        try
        {
            transaction = await Sender.Send(new ConfirmReceiptCommand(Token));
            success = transaction.FulfillmentType == FulfillmentType.DigitalHandoff
                ? "บันทึกการยืนยันรับรายการดิจิทัลแล้ว และเริ่มคำสั่งจ่ายให้ผู้ขาย"
                : "บันทึกการยืนยันรับสินค้าแล้ว และเริ่มคำสั่งจ่ายให้ผู้ขาย";
        }
        catch (Exception exception)
        {
            error = exception.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task OpenDisputeAsync()
    {
        busy = true;
        error = null;
        try
        {
            transaction = await Sender.Send(new OpenDisputeCommand(Token, disputeForm.Reason, disputeForm.Statement));
            success = "เปิดข้อโต้แย้งแล้ว การจ่ายเงินถูกพักไว้ระหว่างตรวจสอบ";
        }
        catch (Exception exception)
        {
            error = exception.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private static string ThaiDate(DateTimeOffset? value) =>
        value?.ToOffset(TimeSpan.FromHours(7)).ToString("dd/MM/yyyy HH:mm 'น. (เวลาไทย)'") ?? "—";
    private static string Money(long satang) => $"฿{satang / 100m:N2}";
    private static string DisputeReasonLabel(DisputeReason reason) => reason switch
    {
        DisputeReason.NotReceived => "ไม่ได้รับสินค้าแม้ขนส่งแจ้งว่าส่งแล้ว",
        DisputeReason.WrongItem => "ได้รับสินค้าผิด",
        DisputeReason.UndisclosedDamage => "มีความเสียหายหรือตำหนิที่ไม่ได้แจ้ง",
        DisputeReason.SuspectedCounterfeit => "สงสัยว่าเป็นสินค้าปลอม",
        DisputeReason.EmptyOrTamperedParcel => "พัสดุว่างหรือมีร่องรอยเปิด",
        DisputeReason.Other => "อื่น ๆ",
        _ => "สินค้าไม่ตรงรายละเอียดอย่างมีนัยสำคัญ"
    };

    private int BuyerStep => transaction?.State switch
    {
        TransactionState.TrackingSubmitted or TransactionState.InTransit => 3,
        TransactionState.DeliveredDisputeWindow or TransactionState.DigitalDeliverySubmitted => 4,
        _ => 2
    };
    private string BuyerKicker => transaction?.State switch
    {
        TransactionState.TrackingSubmitted or TransactionState.InTransit => "กำลังจัดส่ง",
        TransactionState.DeliveredDisputeWindow => "ช่วงตรวจสินค้า",
        TransactionState.DigitalDeliverySubmitted => "ตรวจการส่งมอบ",
        _ => "ตรวจสอบก่อนจ่าย"
    };
    private string BuyerTitle => transaction?.State switch
    {
        TransactionState.TrackingSubmitted or TransactionState.InTransit => "พัสดุกำลังเดินทาง",
        TransactionState.DeliveredDisputeWindow => "พัสดุถึงแล้ว",
        TransactionState.DigitalDeliverySubmitted => "ผู้ขายแจ้งว่าส่งมอบแล้ว",
        _ => "ตรวจสอบและชำระ"
    };
    private string BuyerSubtitle => transaction?.State switch
    {
        TransactionState.DeliveredDisputeWindow => "ตรวจสินค้าให้ตรงกับรูปและรายละเอียดก่อนยืนยันรับ",
        TransactionState.DigitalDeliverySubmitted => "ตรวจผ่านช่องทางที่ตกลงกันก่อนยืนยัน เพราะไม่มีการจ่ายอัตโนมัติ",
        _ => "ดูยอด สถานะ และขั้นตอนถัดไปของรายการนี้"
    };

    public async ValueTask DisposeAsync()
    {
        await refreshCancellation.CancelAsync();
        if (refreshTask is not null)
        {
            try
            {
                await refreshTask;
            }
            catch (OperationCanceledException)
            {
            }
        }
        refreshCancellation.Dispose();
    }
}
