# Copy this file to .env.production at the repository root, set every blank
# value, and keep that file readable only by the deployment account.

TOKLONG_WEB_DOMAIN=
TOKLONG_API_DOMAIN=
TOKLONG_CRM_DOMAIN=
ACME_EMAIL=

POSTGRES_PASSWORD=

DATA_PROTECTION_CERTIFICATE_FILE=./deploy/secrets/data-protection.pfx
DATA_PROTECTION_CERTIFICATE_PASSWORD_FILE=./deploy/secrets/data-protection-password
DISPUTE_EVIDENCE_KEY_FILE=./deploy/secrets/dispute-evidence-key

# Dedicated single-tenant Microsoft Entra app registration for CRM.
# Redirect URI: https://<TOKLONG_CRM_DOMAIN>/signin-oidc
CRM_ENTRA_TENANT_ID=
CRM_ENTRA_CLIENT_ID=
CRM_ENTRA_CLIENT_SECRET=
# Keep both false until Entra P1 Conditional Access is approved and tested.
CRM_FINANCIAL_ACTIONS_ENABLED=false
CRM_CONDITIONAL_ACCESS_APPROVED=false

OTP_PROVIDER=ThaiBulkSms
OTP_BASE_URL=https://otp.thaibulksms.com/
OTP_API_KEY=
OTP_API_SECRET=

NOTIFICATION_BASE_URL=
NOTIFICATION_API_KEY=

# Use a random value of at least 32 characters.
RECONCILIATION_SIGNING_SECRET=

# Manual is allowed only when the operator explicitly owns the bank-transfer
# and signed reconciliation procedure. Replace this with the approved provider.
BANK_PAYOUT_PROVIDER=
BANK_PAYOUT_BASE_URL=
BANK_PAYOUT_API_KEY=
BANK_PAYOUT_ALLOW_MANUAL=false

# Keep payment disabled until provider/legal approval and real credentials exist.
STRIPE_ENABLED=false
STRIPE_LIVE_MODE=false
STRIPE_ENABLE_DIGITAL_GOODS=false
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLATFORM_FEE_SATANG=
STRIPE_FEE_POLICY_VERSION=
BUYER_PROTECTION_FEE_ENABLED=false
BUYER_PROTECTION_BASE_FEE_SATANG=4900
BUYER_PROTECTION_RATE_BASIS_POINTS=350
BUYER_PROTECTION_MINIMUM_FEE_SATANG=7900
BUYER_PROTECTION_MAXIMUM_FEE_SATANG=119900
BUYER_PROTECTION_MINIMUM_ITEM_PRICE_SATANG=100000
BUYER_PROTECTION_MAXIMUM_ITEM_PRICE_SATANG=3000000
BUYER_PROTECTION_POLICY_VERSION=buyer-protection-v1

# SHIPPOP is required for production physical shipping. Keep these values only
# in the protected deployment environment. Generate a random signing secret of
# at least 32 characters; it signs request-bound quote references.
SHIPPOP_BASE_URL=https://mkpservice.shippop.com/
SHIPPOP_API_KEY=
SHIPPOP_ACCOUNT_EMAIL=
SHIPPOP_QUOTE_SIGNING_SECRET=
SHIPPOP_QUOTE_LIFETIME_MINUTES=120
SHIPPOP_SERVICE_CODE_0=EMST
SHIPPOP_SERVICE_CODE_1=FLE
SHIPPOP_SERVICE_CODE_2=KRYX
SHIPPOP_SERVICE_CODE_3=KRYS

APPLE_TEAM_ID=
ANDROID_PACKAGE_NAME=th.co.toklong.mobile
ANDROID_SHA256_FINGERPRINT=

MANUAL_BANK_NAME=
MANUAL_BANK_ACCOUNT_NAME=
MANUAL_BANK_ACCOUNT_NUMBER=

OPENAI_API_KEY=
